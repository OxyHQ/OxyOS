# Stash (OxyHQ/Stash, packages/frontend), OxyOS's file manager (docs/adr/0030-installing-
# applications.mdx, decision 13): a system application, a package of its own built from its checkout
# (STASH_DIR, sample/packages.mjs) and always first in the dock, as a Mac's Finder is. Without its
# package (no checkout given) it is not installed: its entry names where its package will be.
[Desktop Entry]
Type=Application
Name=Stash
Icon=../../../../shell-preview/assets/apps/stash.png
X-OxyOS-Bloom-Module=Stash
X-OxyOS-Bloom-Bundle=/usr/lib/oxyos/apps/so.oxy.stash/index.hbc
X-OxyOS-Runtime=1
X-OxyOS-Pinned=1
