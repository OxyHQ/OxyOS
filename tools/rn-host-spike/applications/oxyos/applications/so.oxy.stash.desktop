# Stash (OxyHQ/Stash, packages/frontend): the person's files and photos, OxyOS's file manager,
# run from the session's Bloom bundle, which takes it from Stash's checkout (STASH_DIR). Always
# first in the dock, as a Mac's Finder is.
[Desktop Entry]
Type=Application
Name=Stash
Icon=../../../../shell-preview/assets/apps/stash.png
X-OxyOS-Bloom-Module=Stash
X-OxyOS-Pinned=1
