      "target": "Abrir Escritorio 1",
      "ring": true
     }
    },
    "at": {
     "shell": [
      {
       "role": "Button",
       "name": "Allo"
      },
      {
       "role": "Button",
       "name": "Abrir Escritorio 1",
       "state": [
        "focused"
       ]
      },
      {
       "role": "Button",
       "name": "Cerrar Allo"
      }
     ]
    },
    "at_absent": {
     "shell": [
      {
       "name": "Ir a Allo"
      },
      {
       "name": "Activar ventana Allo"
      },
      {
       "name": "Ventana Allo"
      },
      {
       "name": "Cerrar vista de escritorios"
      }
     ]
    },
    "spoken": [
     {
      "text": "seleccionado",
      "interrupting": true
     },
     {
      "text": "Abrir Escritorio 1, botón",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "Tab: Allo's window, one button by its title, said once",
