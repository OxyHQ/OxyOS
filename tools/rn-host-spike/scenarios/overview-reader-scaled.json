   "allow_unchanged": true,
   "expect": {
    "react": {},
    "in_shell": {
     "keyboard_focus": {
      "target": "Opciones de Escritorio 1",
      "ring": true
     }
    },
    "spoken": [
     {
      "text": "Opciones de Escritorio 1, contraído, botón",
      "interrupting": true
