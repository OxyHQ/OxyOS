{
  "about": "The login screen (docs/adr/0020-oxy-account-login.mdx, step 2): the Bloom host's OxyOSLogin as the login screen's one client, the development compositor locked from the start with no application, as `oxyos-session --greeter` runs it. The accounts are the accounts' service's `list` (a stand-in here), each shown by its name, never by its Unix user (`oxy-…`); a password goes from the lock surface through the compositor, for the account chosen, to the login program on its development path (`oxyos-login --dev`), whose worker checks it with PAM from the run's own configuration (pam_exec accepts oxyos.correcta alone) and throttles as the lock does. Wrong passwords are rejected by PAM and shake the field; the fifth in a row makes the next wait 30 s. Adding an account offline says setup needs the network and does nothing else. Another account has a field and a throttle of its own; its right password is accepted, the compositor shows the splash and the login program records the session it would start for that account (never starting one). The password is in no report, nothing the compositor holds and not the record.",
  "locale": "es_ES.UTF-8",
  "shell": "OxyOSLogin",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [
      {
        "accountId": "0123456789abcdef01234567",
        "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
        "uid": 1001,
        "name": "Ada Lovelace",
        "picture_colour": "#1f9e5a"
      },
      {
        "accountId": "0123456789abcdef01234568",
        "user": "oxy-bbbbbbbbbbbbbbbbbbbb",
        "uid": 1002,
        "name": "Bea Ramos"
      }
    ],
    "record": [
      "session would start for oxy-bbbbbbbbbbbbbbbbbbbb (user session): "
    ]
  },
  "steps": [
    {
      "name": "the login screen lists the enrolled accounts by their names (never by their Unix users) and pictures (Ada's the one the accounts' service keeps of her avatar, Bea, with none, the default), the first chosen, and takes its password: the lock screen's look, all the compositor shows",
      "do": [
        "type",
        "qzx"
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false,
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ]
          ]
        },
        "in_shell": {
          "texts": [
            "Ada Lovelace",
            "Bea Ramos",
            "•••",
            "Añadir cuenta"
          ],
          "never": [
            "qzx"
          ],
          "absent": [
            "oxy-"
          ]
        },
        "at_apart": {
          "shell": [
            "Añadir cuenta",
            "Reposo",
            "Reiniciar",
            "Apagar"
          ]
        },
        "output_pixels": {
          "581,469": "#1f9e5a",
          "570,460": "#1f9e5a",
          "709,469": "!#1f9e5a"
        }
      }
    },
    {
      "name": "Enter: the login program's PAM rejects it; the field shakes and says so, and nobody is signed in",
      "do": [
        "key",
        [
          28
        ]
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Contraseña incorrecta"
          ],
          "shaken": "login-field",
          "never": [
            "qzx"
          ]
        }
      }
    },
    {
      "name": "a wrong password again (2 in a row), typed with Enter in one turn: rejected",
      "do": [
        "keyboard",
        "mal\n"
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Contraseña incorrecta"
          ],
          "shaken": "login-field"
        }
      },
      "allow_unchanged": true
    },
    {
      "name": "a wrong password again (3 in a row), typed with Enter in one turn: rejected",
      "do": [
        "keyboard",
        "mal\n"
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Contraseña incorrecta"
          ],
          "shaken": "login-field"
        }
      },
      "allow_unchanged": true
    },
    {
      "name": "a wrong password again (4 in a row), typed with Enter in one turn: rejected",
      "do": [
        "keyboard",
        "mal\n"
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Contraseña incorrecta"
          ],
          "shaken": "login-field"
        }
      },
      "allow_unchanged": true
    },
    {
      "name": "the fifth in a row: the login program's throttle makes the next wait 30 s, and the field says so",
      "do": [
        "keyboard",
        "mal\n"
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Vuelve a intentarlo en"
          ],
          "shaken": "login-field"
        },
        "at_apart": {
          "shell": [
            "Añadir cuenta",
            "Reposo",
            "Reiniciar",
            "Apagar"
          ]
        }
      },
      "allow_unchanged": true
    },
    {
      "name": "Añadir cuenta, offline: the setup assistant's Connect page says why and does nothing else",
      "do": [
        "a11y-action",
        [
          "activate",
          "Añadir cuenta"
        ]
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Conéctate a internet",
            "Para configurar una cuenta hace falta internet una vez",
            "Reintentar",
            "Atrás"
          ],
          "absent": [
            "Ada Lovelace",
            "Introduce la contraseña"
          ]
        }
      }
    },
    {
      "name": "Reintentar: still offline, still nothing",
      "do": [
        "a11y-action",
        [
          "activate",
          "Reintentar"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Para configurar una cuenta hace falta internet una vez"
          ]
        }
      }
    },
    {
      "name": "Atrás: the accounts again",
      "do": [
        "a11y-action",
        [
          "activate",
          "Atrás"
        ]
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Ada Lovelace",
            "Bea Ramos"
          ],
          "absent": [
            "Conéctate a internet"
          ]
        }
      }
    },
    {
      "name": "Bea chosen: a field of her own, not held back by Ada's wait",
      "do": [
        "a11y-action",
        [
          "activate",
          "Bea Ramos"
        ]
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Introduce la contraseña"
          ],
          "absent": [
            "Vuelve a intentarlo en",
            "Contraseña incorrecta"
          ]
        }
      }
    },
    {
      "name": "her password, right: accepted, the login screen shows the splash and the login program would start her session",
      "do": [
        "keyboard",
        "oxyos.correcta\n"
      ],
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "in_shell": {
          "never": [
            "oxyos.correcta"
          ]
        },
        "never": [
          "oxyos.correcta"
        ]
      }
    }
  ]
}
