{
  "about": "Dropsea's items from the keyboard (docs/adr/0039-keyboard-access.mdx), as Finder's list with Full Keyboard Access and VoiceOver: the items are one Tab stop; the arrows move the selection within it and the screen reader says each item the selection reaches, by its name and, in the list, its columns, while the keyboard stays on the list; Space still Quick Looks; Shift+F10 and the Menu key open the selection's context menu at the selected item, said as a menu by its title; Escape gives the list back. At 1 (1280 × 720).",
  "module": "Dropsea",
  "window": [
    1024,
    680
  ],
  "app": {
    "id": "so.oxy.dropsea",
    "title": "Dropsea"
  },
  "home": {
    "items": {
      "Documents/": "",
      "Pictures/": "",
      "notes.txt": "hello",
      "Documents/report.txt": "r",
      "Pictures/photo.jpg": "x"
    }
  },
  "reader": {
    "locale": "en_US.UTF-8"
  },
