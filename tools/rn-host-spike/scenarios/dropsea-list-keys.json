      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": null,
        "spoken": [],
        "announcements": []
      }
    },
    {
      "name": "Tab: home, said once",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "home",
          "ring": true
        },
        "spoken": [
          {
            "text": "home, selected, button",
            "interrupting": true
          }
        ],
        "announcements": [],
        "react": {
          "focus@home": 1
        }
      }
    },
    {
