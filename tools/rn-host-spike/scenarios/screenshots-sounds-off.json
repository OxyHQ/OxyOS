{
  "about": "Play user interface sound effects off (Settings' Sound page, the `ui_sounds` preference, docs/adr/0044-system-sounds.mdx): the screenshot's shutter is an interface sound effect, as on a Mac, so Super+Shift+3 saves the display to the Desktop as ever, its thumbnail shown and said, and no sound plays. With the preference ignored, the shutter plays and the step fails (screenshots.json plays it once a capture).",
  "locale": "es_ES.UTF-8",
  "module": "EditingProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.allo",
    "title": "Allo"
  },
  "screenshots": true,
  "preferences": {
    "ui_sounds": "false"
  },
  "steps": [
    {
      "name": "Allo's field takes the keyboard",
      "do": [
        "press",
        [
          300,
          42
        ]
      ],
      "expect": {
        "focus_input": "line",
        "react": {
          "touchStart@line": 1,
          "touchEnd@line": 1,
          "focus@line": 1,
          "selectionChange@line": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    },
    {
      "name": "Super+Shift+3: the display saved to the Desktop, its thumbnail said; silent",
      "do": [
        "key",
        [
          125,
          42,
          4
        ]
      ],
      "expect": {
        "react": {},
        "delivered": {},
        "focus_input": "line",
        "focus_surface": 1,
        "announcements": [
          {
            "politeness": "polite",
            "text": "Captura de pantalla guardada"
          }
        ],
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "Captura de pantalla"
            }
          ]
        },
        "screenshots": {
          "saved": [
            {
              "name": "Captura de pantalla \\d{4}-\\d{2}-\\d{2} a las \\d{2}\\.\\d{2}\\.\\d{2}\\.png",
              "folder": "Desktop",
              "output": 1,
              "width": 1280,
              "height": 720,
              "alpha": false,
              "pixels": {
                "640,480": "#ffffff",
                "100,100": "#2e74b1"
              }
            }
          ],
          "opened": []
        },
        "sounds": []
      }
    }
  ]
}
