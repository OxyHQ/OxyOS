      ".local/state/oxyos/windows": "{\"desktops\":2,\"windows\":[{\"application\":\"so.oxy.backgroundprobe\",\"x\":60,\"y\":80,\"width\":500,\"height\":400,\"desktop\":0},{\"application\":\"so.oxy.permissionprobe\",\"x\":300,\"y\":120,\"width\":520,\"height\":380,\"desktop\":1},{\"application\":\"so.oxy.crashprobe\",\"x\":200,\"y\":100,\"width\":480,\"height\":360,\"desktop\":0,\"minimized\":true},{\"application\":\"so.oxy.inbox\",\"x\":400,\"y\":180,\"width\":700,\"height\":460,\"desktop\":0}]}"
