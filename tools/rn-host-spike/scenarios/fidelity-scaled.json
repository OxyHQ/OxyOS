{
  "about": "fidelity.json at a fractional scale (the ThinkPad's 1.25): the gallery drawn light, motion reduced, for fidelity.py.",
  "module": "FidelityGallery",
  "window": [
    1200,
    880
  ],
  "outputs": "1920x1200@1.25",
  "settings": {
    "app": "so.oxy.settings",
    "preferences": {
      "appearance": "light",
      "reduce_motion": "true"
    }
  },
  "steps": [
    {
      "name": "the page is drawn, its fonts loaded and nothing moving",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Bloom fidelity · page 1"
        ]
      }
    }
  ]
}
