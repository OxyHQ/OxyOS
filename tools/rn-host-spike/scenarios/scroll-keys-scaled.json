          42,
          57
        ]
      ],
      "expect": {
        "react": {
          "scroll@main": [
            6,
            17
          ]
        },
        "scroll_offset": {
          "main": [
            0,
            244.8
          ]
        },
        "host_input": {
          "keyboard.scroll": 1
        },
        "scrollbars": {
          "shown@main": 1,
          "hidden@main": 1
        }
      }
    },
    {
      "name": "↓: a line (40) down",
      "do": [
        "key",
        108
      ],
      "expect": {
        "react": {
          "scroll@main": [
            6,
            17
          ]
        },
        "scroll_offset": {
          "main": [
            0,
            284.8
          ]
        },
        "host_input": {
          "keyboard.scroll": 1
        },
        "scrollbars": {
          "shown@main": 1,
          "hidden@main": 1
        }
      }
    },
