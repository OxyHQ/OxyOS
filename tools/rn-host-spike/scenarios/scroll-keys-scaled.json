        "keyboard_focus": {
          "target": "row-0",
          "ring": true
        }
      }
    },
    {
      "name": "Space on the focused row presses it, and scrolls nothing",
      "do": [
        "key",
        57
      ],
      "expect": {
        "react": {
          "click@row-0": 1
