            0,
            244.8
          ]
        },
        "host_input": {
          "keyboard.scroll": 1
        },
        "scrollbars": {
          "shown@main": 1,
          "hidden@main": 1
        }
      }
    },
    {
      "name": "End: to its end, nothing past it",
      "do": [
        "key",
        107
      ],
      "expect": {
        "react": {
          "scroll@main": [
            6,
            17
          ]
        },
        "scroll_offset": {
          "main": [
            0,
