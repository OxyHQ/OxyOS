{
  "about": "The lock screen (ADR 0010) with the session's shell and an application: the shell's menu locks the session, which at once shows only the lock screen (the shell's lock surface, drawn with Bloom: the wallpaper dimmed, the date and time, the user, the password field, focused) and nothing of the application or the panels. Caps Lock on is said under the field, and no longer once it is off. A wrong password is rejected by the development compositor's fixture (never PAM) and the lock screen says so, its field keeping focus; the right one unlocks, with the panels and the window as they were, and the window takes its presses again. Nothing typed into the lock screen reaches the application, and neither password appears in any report or in the compositor's hands.",
  "module": "EditingProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "lock_password": "oxyos-correcta",
  "steps": [
    {
      "name": "the Oxy menu opens, with its lock item",
      "do": [
        "press_output",
        [
          16,
          14
        ]
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ],
            [
              0,
              0,
              1280,
              28
            ],
            [
              0,
              664,
              1280,
              56
            ],
            [
              12,
              32,
              220,
              200
            ]
          ],
          "top": [
            12,
            32,
            220,
            200
          ],
          "locked": false
        },
        "in_shell": {
          "texts": [
            "Bloquear pantalla"
          ]
        },
        "react": {}
      }
    },
    {
      "name": "Bloquear pantalla locks at once: only the lock screen shows, its password field focused, the window gone from the screen",
      "do": [
        "press_output",
        [
          82,
          201
        ]
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ]
          ],
          "work_area": [
            0,
            28,
            1280,
            636
          ],
          "locked": true
        },
        "window_shown": false,
        "react": {},
        "in_shell": {
          "texts": [
            "Introduce la contraseña"
          ]
        }
      }
    },
    {
      "name": "Caps Lock on: the lock screen says so under the field; the key reaches no application",
      "do": [
        "caps_lock",
        true
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ]
          ],
          "work_area": [
            0,
            28,
            1280,
            636
          ],
          "locked": true
        },
        "react": {},
        "delivered": {},
        "in_shell": {
          "texts": [
            "Bloq Mayús activado"
          ]
        }
      }
    },
    {
      "name": "Caps Lock off: it no longer says so",
      "do": [
        "caps_lock",
        true
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ]
          ],
          "work_area": [
            0,
            28,
            1280,
            636
          ],
          "locked": true
        },
        "react": {},
        "delivered": {},
        "in_shell": {
          "absent": [
            "Bloq Mayús activado"
          ]
        }
      }
    },
    {
      "name": "a password typed goes to the lock screen alone, shown as bullets, reported nowhere",
      "do": [
        "type",
        "mal"
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ]
          ],
          "work_area": [
            0,
            28,
            1280,
            636
          ],
          "locked": true
        },
        "window_shown": false,
        "react": {},
        "delivered": {},
        "in_shell": {
          "texts": [
            "•••"
          ],
          "never": [
            "mal"
          ]
        },
        "never": [
          "mal"
        ]
      }
    },
    {
      "name": "Enter submits it: rejected, the lock screen says so and stays locked",
      "do": [
        "key",
        [
          28
        ]
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ]
          ],
          "work_area": [
            0,
            28,
            1280,
            636
          ],
          "locked": true
        },
        "window_shown": false,
        "react": {},
        "delivered": {},
        "in_shell": {
          "texts": [
            "Contraseña incorrecta"
          ],
          "never": [
            "mal"
          ]
        }
      }
    },
    {
      "name": "the field kept focus: the next password is typed into it, clearing the message",
      "do": [
        "type",
        "oxyos-correcta"
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ]
          ],
          "work_area": [
            0,
            28,
            1280,
            636
          ],
          "locked": true
        },
        "react": {},
        "delivered": {},
        "in_shell": {
          "absent": [
            "Contraseña incorrecta"
          ],
          "never": [
            "oxyos-correcta"
          ]
        },
        "never": [
          "oxyos-correcta"
        ]
      }
    },
    {
      "name": "the right password unlocks: the panels and the window as they were",
      "do": [
        "key",
        [
          28
        ]
      ],
      "expect": {
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ],
            [
              0,
              0,
              1280,
              28
            ],
            [
              0,
              664,
              1280,
              56
            ]
          ],
          "work_area": [
            0,
            28,
            1280,
            636
          ],
          "locked": false
        },
        "window_shown": true,
        "window_rect": [
          340,
          166,
          600,
          360
        ],
        "react": {},
        "in_shell": {
          "never": [
            "oxyos-correcta"
          ]
        }
      }
    },
    {
      "name": "the window takes its presses again",
      "do": [
        "press",
        [
          300,
          42
        ]
      ],
      "expect": {
        "focus_input": "line",
        "react": {
          "touchStart@line": 1,
          "touchEnd@line": 1,
          "focus@line": 1,
          "selectionChange@line": 1
        }
      }
    }
  ]
}
