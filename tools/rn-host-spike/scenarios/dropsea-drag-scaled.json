{
  "about": "Dropsea (OxyHQ/Dropsea) drags its items to other applications and takes files dropped from them (docs/adr/0035-drag-and-drop.mdx, decision 13), through Bloom's API alone: its own drag of items becomes the platform's drag, and its items' area is a DropZone. Two Dropsea windows on a home of the run's own, side by side (the second started as the `companion`): notes.txt dragged from the first onto Documents in the second moves into it; plan.txt dragged onto the dock's Trash goes to the home's Trash; Pictures dragged onto Documents within the second window with Option held is copied there, the original kept. At scale 1.25 (a 1600x1000 display, 1280x800 logical). Each drag at a hand's pace lets the application take each motion (`until_taken`), so what the drag passes over and what each target is told is where the hand was, however loaded the machine. Last, readme.txt dragged from the first window onto Pictures in the second, its press, motions and release read by Dropsea in one turn as a loaded machine reads them: the drag it asks for after the release is dropped where it was released, moving readme.txt into Pictures (docs/adr/0035-drag-and-drop.mdx, decision 2).",
  "locale": "es_ES.UTF-8",
  "module": "Dropsea",
  "window": [
    580,
    460
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.dropsea",
    "title": "Dropsea"
  },
  "companion": {
    "module": "Dropsea",
    "window": [
      640,
      460
    ],
    "at": [
      610,
      80
    ]
  },
  "home": {
    "items": {
      "Documents/": "",
      "Documents/report.txt": "r",
      "Pictures/": "",
      "notes.txt": "hello",
      "plan.txt": "p",
      "readme.txt": "r"
    }
  },
  "steps": [
    {
      "name": "the first window beside the second",
      "do": [
        "move-window",
        [
          -340,
          0
        ]
      ],
      "allow_unchanged": false,
      "expect": {
        "texts": [
          "notes.txt",
          "plan.txt"
        ],
        "in_companion": {
          "texts": [
            "notes.txt",
            "plan.txt"
          ]
        }
      }
    },
    {
      "name": "notes.txt dragged from the first window onto Documents in the second: it moves into it",
      "do": [
        "drag_paced",
        [
          436,
          265,
          907,
          190,
          30,
          30
        ]
      ],
      "until_taken": true,
      "expect": {
        "home": {
          "Documents/notes.txt": "hello",
          "notes.txt": false,
          "Documents/report.txt": "r"
        },
        "delivered": {
          "0": {
            "drag.dropped": 1,
            "drag.finished": 1,
            "drag.send": 1
          },
          "1": {
            "cancel": 1,
            "drag.enter": 1,
            "drag.leave": 1,
            "enter": 1,
            "focus.in": 1,
            "leave": 1,
            "press": 1
          }
        }
      }
    },
    {
      "name": "plan.txt dragged from the first window onto the dock's Trash: it is in the home's Trash",
      "do": [
        "drag_paced_named",
        [
          "plan.txt",
          "Papelera",
          30,
          30
        ]
      ],
      "until_taken": true,
      "expect": {
        "home": {
          "plan.txt": false,
          "trash": [
            "plan.txt"
          ]
        },
        "delivered": {
          "0": {
            "drag.dropped": 1,
            "drag.finished": 1,
            "drag.send": 1
          },
          "1": {
            "cancel": 1,
            "drag.enter": 1,
            "drag.leave": 1,
            "enter": 1,
            "leave": 1,
            "press": 1
          }
        },
        "sounds": [
          "file-trash"
        ]
      }
    },
    {
      "name": "Option held",
      "do": [
        "key_down",
        [
          56
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Pictures (in notes.txt's place now) dragged onto Documents in the second window with Option held: copied, the original kept",
      "do": [
        "drag_paced",
        [
          1036,
          190,
          907,
          190,
          30,
          30
        ]
      ],
      "until_taken": true,
      "expect": {
        "home": {
          "Pictures": true,
          "Documents/Pictures": true
        },
        "delivered": {
          "1": {
            "focus.out": 1
          },
          "companion": {
            "cancel": 1,
            "drag.drop": 1,
            "drag.dropped": 1,
            "drag.enter": 1,
            "drag.finished": 1,
            "drag.send": 1,
            "enter": 2,
            "focus.in": 1,
            "leave": 1,
            "press": 1
          }
        }
      }
    },
    {
      "name": "Option released",
      "do": [
        "key_up",
        [
          56
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "readme.txt dragged from the first window onto Pictures in the second, its press, motions and release read in one turn as a loaded machine reads them: the drag Dropsea starts after the release is dropped where it was released, readme.txt moved into Pictures",
      "do": [
        "drag_output",
        [
          565,
          265,
          1036,
          190
        ]
      ],
      "expect": {
        "home": {
          "Pictures/readme.txt": "r",
          "readme.txt": false
        },
        "react": {
          "touchStart@item-readme.txt": 1,
          "touchMove@item-readme.txt": 8,
          "touchEnd@item-readme.txt": 1
        },
        "delivered": {
          "0": {
            "drag.dropped": 1,
            "drag.finished": 1,
            "drag.send": 1
          },
          "1": {
            "enter": 1,
            "focus.in": 1,
            "leave": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    }
  ],
  "outputs": "1600x1000@1.25"
}
