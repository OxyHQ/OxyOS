{
  "about": "Submenus from the keyboard in a Bloom menu in a compositor popup (sample/App.tsx's DropdownMenu and its 'More actions' submenu), in a window a pointer drives, so the submenu is a desktop's: a flyout beside its row in a popup of its own (Bloom 15.77.0), with the keys the WAI-ARIA menu pattern, macOS and Android menus give it (Bloom 15.72.0's popup navigation). ArrowRight on a row with a submenu opens it beside the row, its top at the row's and its left edge one 2px seam off the menu's right edge, a child of the menu's popup that takes the keyboard; its first row is active. ArrowLeft inside it, or Escape, closes it and gives the menu back the keyboard with its row active; Escape outside a submenu closes the menu. Each key reaches the popup with the keyboard once (`key@message-actions`, or `key@Submenu` for the flyout's) and nothing else; which row is active is shown by what the next keys choose. Points are window-local logical pixels.",
  "window": [
    1024,
    560
  ],
  "layout": "us",
  "steps": [
    {
      "name": "open the menu",
      "do": [
        "press",
        [
          939,
          411
        ]
      ],
      "expect": {
        "popups": 1,
        "focus_surface": 2,
        "popup_size": [
          266,
          222
        ],
        "absent": [
          "Copy link"
        ],
        "react": {
          "touchStart@open-menu": 1,
          "touchEnd@open-menu": 1
        }
      }
    },
    {
      "name": "End makes the last row active: More actions, which has a submenu",
      "do": [
        "key",
        107
      ],
      "expect": {
        "popups": 1,
        "absent": [
          "Copy link"
        ],
        "react": {
          "key@message-actions": 1
        },
        "popup_events": {}
      }
    },
    {
      "name": "ArrowRight on it opens its submenu beside it: a popup of its own, a child of the menu's, its top at the row's and one 2px seam right of the menu, with the keyboard; the row expanded",
      "do": [
        "key",
        106
      ],
      "expect": {
        "popups": 2,
        "focus_surface": 3,
        "texts": [
          "Copy link",
          "Print"
        ],
        "react": {
          "key@message-actions": 1
        },
        "popup_events": {
          "open@Submenu": 1
        },
        "at": {
          "popup": [
            {
              "role": "MenuItem",
              "name": "More actions",
              "state": [
                "expanded"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Copy link"
            },
            {
              "role": "MenuItem",
              "name": "Print"
            }
          ]
        },
        "popup_rects": [
          [
            745,
            473,
            266,
            222
          ],
          [
            1013,
            648,
            266,
            72
          ]
        ]
      }
    },
    {
      "name": "ArrowLeft inside it closes the submenu: its popup goes, the menu has the keyboard again, the row collapsed",
      "do": [
        "key",
        105
      ],
      "expect": {
        "popups": 1,
        "focus_surface": 2,
        "absent": [
          "Copy link",
          "Print"
        ],
        "react": {
          "key@Submenu": 1
        },
        "popup_events": {
          "close@3": 1
        },
        "at": {
          "popup": [
            {
              "role": "MenuItem",
              "name": "More actions",
              "state": [
                "collapsed",
                "focused"
              ]
            }
          ]
        },
        "popup_rects": [
          [
            745,
            473,
            266,
            222
          ]
        ]
      }
    },
    {
      "name": "the active row is More actions again: ArrowUp goes to the row above it, Delete",
      "do": [
        "key",
        103
      ],
      "expect": {
        "popups": 1,
        "react": {
          "key@message-actions": 1
        },
        "popup_events": {}
      }
    },
    {
      "name": "Enter chooses Delete and closes the menu, focus back in the window",
      "do": [
        "key",
        28
      ],
      "expect": {
        "popups": 0,
        "focus_surface": 1,
        "texts": [
          "Chosen: Delete"
        ],
        "absent": [
          "Nothing chosen"
        ],
        "react": {
          "key@message-actions": 1
        }
      }
    },
    {
      "name": "reopen the menu",
      "do": [
        "press",
        [
          939,
          411
        ]
      ],
      "expect": {
        "popups": 1,
        "focus_surface": 4,
        "popup_size": [
          266,
          222
        ],
        "react": {
          "touchStart@open-menu": 1,
          "touchEnd@open-menu": 1
        }
      }
    },
    {
      "name": "End, to More actions",
      "do": [
        "key",
        107
      ],
      "expect": {
        "popups": 1,
        "react": {
          "key@message-actions": 1
        }
      }
    },
    {
      "name": "ArrowRight opens its submenu beside it, with the keyboard",
      "do": [
        "key",
        106
      ],
      "expect": {
        "popups": 2,
        "texts": [
          "Copy link",
          "Print"
        ],
        "react": {
          "key@message-actions": 1
        },
        "popup_events": {
          "open@Submenu": 1
        },
        "focus_surface": 5,
        "popup_rects": [
          [
            745,
            473,
            266,
            222
          ],
          [
            1013,
            648,
            266,
            72
          ]
        ]
      }
    },
    {
      "name": "Escape inside the submenu closes the submenu alone: its popup goes, the menu stays open with the keyboard",
      "do": [
        "key",
        1
      ],
      "expect": {
        "popups": 1,
        "focus_surface": 4,
        "absent": [
          "Copy link"
        ],
        "react": {
          "key@Submenu": 1
        },
        "popup_events": {
          "close@5": 1
        },
        "popup_rects": [
          [
            745,
            473,
            266,
            222
          ]
        ]
      }
    },
    {
      "name": "ArrowRight opens the submenu again and makes its first row active",
      "do": [
        "key",
        106
      ],
      "expect": {
        "popups": 2,
        "texts": [
          "Copy link"
        ],
        "react": {
          "key@message-actions": 1
        },
        "popup_events": {
          "open@Submenu": 1
        },
        "focus_surface": 6,
        "popup_rects": [
          [
            745,
            473,
            266,
            222
          ],
          [
            1013,
            648,
            266,
            72
          ]
        ]
      }
    },
    {
      "name": "Enter chooses Copy link, the submenu's first row, and closes the menu",
      "do": [
        "key",
        28
      ],
      "expect": {
        "popups": 0,
        "focus_surface": 1,
        "texts": [
          "Chosen: Copy link"
        ],
        "absent": [
          "Chosen: Delete"
        ],
        "react": {
          "key@Submenu": 1
        },
        "popup_events": {
          "close@4": 1,
          "close@6": 1
        }
      }
    }
  ]
}
