        "id": "alsa_input.dmic",
        "name": "Digital Microphone",
        "kind": "microphone",
        "transport": "builtIn",
        "volume": 1,
        "balance": null
      }
    ]
  },
  "network": {
    "access_points": [
      {
        "ssid": "LukeSkyRouter",
        "strength": 73,
        "security": "wpa",
        "password": "correct horse"
      }
    ],
    "connections": [
      {
        "ssid": "LukeSkyRouter",
        "password": "correct horse"
      }
    ],
    "active": "LukeSkyRouter",
    "ethernet": "unplugged"
  },
