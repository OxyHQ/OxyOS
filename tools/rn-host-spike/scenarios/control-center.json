          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        },
        "at": {
          "shell": [
            {
              "role": "Meter",
              "name": "Batería",
              "value": "64 %, 3 h 20 min restantes"
            },
            {
              "role": "Button",
              "name": "Wi-Fi",
