    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Información",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Información, seleccionado, 20 de 20",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "↓ at the end goes nowhere, as a list stops at its ends: nothing is said again",
   "do": [
    "key",
    [
     108
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-about",
     "ring": true
    },
    "spoken": [],
    "announcements": []
   }
  },
  {
   "name": "↑: Privacy",
   "do": [
    "key",
    [
     103
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@settings-nav-about": 1,
     "focus@settings-nav-privacy": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-privacy",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Privacidad",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Privacidad, seleccionado, 19 de 20",
      "interrupting": true
