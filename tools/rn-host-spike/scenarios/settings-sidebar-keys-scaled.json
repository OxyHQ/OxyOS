      }
     ]
    },
    "spoken": [
     {
      "text": "Fondo de pantalla, seleccionado, 2 de 20",
      "interrupting": true
     }
    ],
    "announcements": [],
    "texts": [
     "Automático sigue al sol a lo largo del día, según la zona horaria del reloj."
    ]
   }
  },
  {
   "name": "Tab leaves the sidebar (no other row is a stop) for the pane's first control: the wallpaper's Dynamic wallpaper menu",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
