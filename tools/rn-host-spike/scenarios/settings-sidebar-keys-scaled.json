     "blur@Fondo dinámico": 1,
     "focus@settings-nav-wallpaper": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-wallpaper",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Fondo de pantalla",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Fondo de pantalla, seleccionado, 2 de 20",
      "interrupting": true
