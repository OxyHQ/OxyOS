      "do": [
        "key",
        108
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {
          "key@text-field-menu": 1
        },
        "at": {
          "popup": [
            {
              "role": "MenuItem",
              "name": "Cortar",
              "state": [
                "focused"
              ]
            }
          ]
        },
        "delivered": {
          "2": {
            "key.press": 1,
            "key.release": 1
          },
          "companion": {}
        }
      }
    },
    {
