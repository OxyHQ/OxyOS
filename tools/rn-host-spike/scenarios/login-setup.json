{
  "about": "Adding an Oxy account at the first boot (docs/adr/0020-oxy-account-login.mdx, decisions 2 and 4, step 2), against a played Oxy API and a played accounts' service (no credential of anyone's): online, the login screen runs the Oxy SDK's own sign-in (OxyProvider with OxyOS's client id from the service's `platform`, and a store that hands the credential to the host and keeps nothing); the account signs in with the code sent to its email; the person chooses a PIN for this computer, typed twice, then gives the account's password once more (a wrong one shakes the field and is said), and the accounts' service sets the account up with the credential, the password and the PIN, asking the authenticator's code on the same conversation (a wrong code said, then the right one). Enrolled, the new account is listed and chosen, its PIN's field focused, and its PIN signs in.",
  "shell": "OxyOSLogin",
  "outputs": "1280x1000",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "code": "135790",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "online: the SDK's own chooser, OxyOS's client id from the accounts' service; its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in"
          ],
          "absent": [
            "Adding an account needs an internet connection. Connect and try again."
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "the account's username",
      "do": [
        "press",
        [
          411,
          383
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "typed",
      "do": [
        "type",
        "ada"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Continue: a code is sent to the account's email",
      "do": [
        "key",
        [
          28
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "the SDK asks for the code",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Check your email"
          ]
        },
        "oxy_requests": []
      }
    },
    {
      "name": "the code: signed in, and the credential handed over to the host",
      "do": [
        "type",
        "246810"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "signed in: a PIN for this computer asked, its field focused",
      "do": [
        "wait",
        2000
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Choose a PIN for this computer",
            "Not Now"
          ],
          "absent": [
            "Set a password"
          ],
          "focus_input": "login-setup-pin-password"
        }
      }
    },
    {
      "name": "the PIN, typed twice",
      "do": [
        "keyboard",
        "482916\n482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter Ada Lovelace's password",
            "OxyOS signs in with your Oxy account's password, even offline. Enter it once more."
          ],
          "absent": [
            "Choose a PIN for this computer"
          ],
          "focus_input": "login-setup-password"
        }
      }
    },
    {
      "name": "a wrong one: refused, the field says so",
      "do": [
        "keyboard",
        "not the password\n"
      ],
      "expect": {
        "accounts_asked": [
          "enroll: refused"
        ],
        "in_shell": {
          "texts": [
            "Incorrect password"
          ]
        }
      }
    },
    {
      "name": "the right one: the accounts' service asks the authenticator's code",
      "do": [
        "keyboard",
        "played password 1\n"
      ],
      "expect": {
        "accounts_asked": [
          "enroll: secondFactorRequired"
        ],
        "in_shell": {
          "texts": [
            "Enter the code from your authenticator app"
          ]
        }
      }
    },
    {
      "name": "a wrong code: said, another may be given",
      "do": [
        "keyboard",
        "000000\n"
      ],
      "expect": {
        "accounts_asked": [
          "secondFactor: refused"
        ],
        "in_shell": {
          "texts": [
            "That code isn't right. Wait for a new one and try again."
          ]
        }
      }
    },
    {
      "name": "the right code: enrolled, listed and chosen",
      "do": [
        "keyboard",
        "135790\n"
      ],
      "expect": {
        "accounts_asked": [
          "secondFactor: enrolled"
        ],
        "in_shell": {
          "texts": [
            "Ada Lovelace",
            "Add Account",
            "Use Password"
          ],
          "absent": [
            "Add an Oxy Account",
            "Enter the code from your authenticator app"
          ],
          "focus_input": "login-pin-password"
        }
      }
    },
    {
      "name": "its PIN signs it in",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "verifyPin: accepted"
        ],
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "482916",
          "oxyos.correcta",
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "482916",
            "oxyos.correcta",
            "played password 1"
          ]
        }
      }
    }
  ]
}
