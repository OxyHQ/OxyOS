{
  "about": "Adding the computer's first Oxy account by the code its email is sent, through the setup assistant (docs/adr/0020-oxy-account-login.mdx, decisions 2 and 4 and the setup assistant's amendment), against a played Oxy API and a played accounts' service (no credential of anyone's): the welcome, Get Started, the SDK's own sign-in (OxyOS's client id from the accounts' service) in the SDK's frame; the username and the code; the account's sign-in methods read (it has a password), so its Oxy password is asked once, step 3 of 6; a PIN, optional, typed twice; the look. Continue: the accounts' service refuses the password, and the screen goes back to it, saying so, the PIN and look kept; the right one, and the service asks the authenticator's code, said wrong once; the right code, and the account is set up and signed in with the PIN just chosen.",
  "shell": "OxyOSLogin",
  "outputs": "1280x1000",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "code": "135790",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "first boot: the welcome",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Welcome to OxyOS",
            "Get Started"
          ],
          "absent": [
            "Back"
          ]
        }
      }
    },
    {
      "name": "Get Started: online, the SDK's own chooser in the SDK's frame, step 2 of 5",
      "do": [
        "press_named",
        "Get Started"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Step 2 of 5",
            "Back"
          ],
          "absent": [
            "Connect to the Internet"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "the account's username",
      "do": [
        "press",
        [
          411,
          383
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "typed",
      "do": [
        "type",
        "ada"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Continue: a code is sent to the account's email",
      "do": [
        "key",
        [
          28
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "the SDK asks for the code",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Check your email"
          ]
        },
        "oxy_requests": []
      }
    },
    {
      "name": "the code: signed in, and the credential handed over to the host",
      "do": [
        "type",
        "246810"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "signed in by the code: its sign-in methods read, its Oxy password asked once, its field focused, step 3 of 6",
      "do": [
        "wait",
        2000
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Enter Ada Lovelace's Oxy Password",
            "This computer signs you in with your Oxy password, even offline. Enter it once more.",
            "Step 3 of 6"
          ],
          "absent": [
            "Set a password",
            "Create a PIN"
          ],
          "focus_input": "login-setup-password"
        }
      }
    },
    {
      "name": "a password typed (not the account's, as it turns out): a PIN, optional",
      "do": [
        "keyboard",
        "not the password\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Create a PIN",
            "Unlock faster with a PIN, even offline. It stays on this computer: Oxy never sees it.",
            "Not Now",
            "Step 4 of 6"
          ],
          "focus_input": "login-setup-pin-password"
        }
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter Your PIN Again"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916"
          ]
        }
      }
    },
    {
      "name": "typed again: the look",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Choose Your Look",
            "Light",
            "Dark",
            "Auto",
            "Step 5 of 6"
          ]
        }
      }
    },
    {
      "name": "Continue pressed",
      "do": [
        "press_named",
        "Continue"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: refused"
        ]
      }
    },
    {
      "name": "Continue: the accounts' service refuses the password; back to it, said, the PIN and the look kept",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Enter Ada Lovelace's Oxy Password",
            "That isn't the password of this Oxy account. Try again."
          ],
          "focus_input": "login-setup-password"
        }
      }
    },
    {
      "name": "the right one: set up at once with the PIN and look kept; the accounts' service asks the authenticator's code",
      "do": [
        "keyboard",
        "played password 1\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: secondFactorRequired"
        ],
        "never": [
          "482916",
          "oxyos.correcta",
          "played password 1"
        ],
        "in_shell": {
          "texts": [
            "Two-Factor Authentication",
            "Enter the code from your authenticator app."
          ],
          "focus_input": "login-setup-code",
          "never": [
            "482916",
            "oxyos.correcta",
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "a wrong code: said, another may be given",
      "do": [
        "keyboard",
        "000000\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "secondFactor: refused"
        ],
        "in_shell": {
          "texts": [
            "That code isn't right. Wait for a new one, then try again."
          ],
          "focus_input": "login-setup-code"
        }
      }
    },
    {
      "name": "the right code: the account set up and signed in with the PIN just chosen, never asked again",
      "do": [
        "keyboard",
        "135790\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "appearance: auto",
          "secondFactor: enrolled",
          "verifyPin: accepted"
        ],
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "482916",
          "oxyos.correcta",
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "482916",
            "oxyos.correcta",
            "played password 1"
          ]
        }
      }
    }
  ]
}
