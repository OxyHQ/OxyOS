{
  "about": "A change of what the wallpaper shows mid-session fades in (ADR 0048, decision 6): the catalog's default, OxyOS, follows the appearance; Dark Mode chosen in the Control Center makes the session's appearance dark, and the shell's host shows OxyOS's dark variant, faded in over the light one. The window and the dock are untouched; the desktop's pixels are the dark variant's once it settled.",
  "locale": "es_ES.UTF-8",
  "module": "EditingProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "preferences": {
    "appearance": "light",
    "wallpaper": "oxyos"
  },
  "steps": [
    {
      "name": "the desktop shows OxyOS, light",
      "do": [
        "press_output",
        [
          1100,
          400
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "output_pixels": {
          "1100,400": "#5e6dc8",
          "200,600": "#2966b0",
          "640,100": "#4672cb",
          "1240,250": "#8282d1"
        },
        "react": {}
      }
    },
    {
      "name": "the top bar's button opens the Control Center",
      "do": [
        "press_output",
        [
          1146,
          14
        ]
      ],
      "expect": {
        "react": {}
      }
    },
    {
      "name": "Dark Mode: the session's appearance is dark, and the wallpaper's dark variant fades in",
      "do": [
        "press_output",
        [
          990,
          76
        ]
      ],
      "expect": {
        "output_pixels": {
          "1100,400": "#12225b",
          "200,600": "#09192c",
          "640,100": "#131f4e"
        },
        "preferences_file": {
          "appearance": "dark"
        },
        "react": {}
      }
    },
    {
      "name": "a press outside closes the Control Center: the desktop stays dark",
      "do": [
        "press_output",
        [
          200,
          600
        ]
      ],
      "expect": {
        "output_pixels": {
          "1100,400": "#12225b",
          "200,600": "#09192c",
          "640,100": "#131f4e",
          "1240,250": "#2a1f7c"
        },
        "react": {}
      }
    }
  ]
}
