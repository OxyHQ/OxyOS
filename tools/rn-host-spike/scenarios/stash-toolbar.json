     "window": [
      {
       "role": "Heading",
       "name": "home"
      },
      {
       "role": "Button",
       "name": "home",
       "state": [
        "selected"
       ]
      }
     ]
    },
    "at_hit": {
     "298,26": {
      "role": "Button",
      "name": "Back"
     },
     "333,26": {
      "role": "Button",
      "name": "Forward"
     }
    }
   }
