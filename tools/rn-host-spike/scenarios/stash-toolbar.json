    "wait",
    1500
   ],
   "allow_unchanged": true,
   "expect": {
    "at_group": [
     {
      "group": {
       "role": "Group",
       "name": "Stash"
      },
      "items": [
       {
        "role": "Button",
        "name": "Hide Sidebar"
       },
       {
        "role": "Button",
        "name": "Back",
        "state": [
         "disabled"
        ]
       },
       {
        "role": "Button",
        "name": "Forward",
        "state": [
         "disabled"
        ]
       }
      ],
      "only": true
     }
    ],
