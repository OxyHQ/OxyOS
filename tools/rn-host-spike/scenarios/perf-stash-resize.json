{
  "about": "Stash's window resized live and zoomed (docs/performance.mdx): its right edge dragged 300 px in and back at a mouse's 125 Hz (one configure in flight), then the green bubble zooming it to the work area and back. Bloom lays its shell, panels and Stash's items out as flex (Yoga, in the pass that lays the resized window out) and reads the window's size only at the thresholds it decides at, so a frame of the resize is native work: every frame's work fits a refresh at 60 Hz and runs little JavaScript (what remains is react-native-css re-evaluating media queries on every frame, nativewind/react-native-css#550, and the safe area's frame). Before, the shell and its panels re-rendered for every frame from their measured widths: 34 to 66 ms of JavaScript a frame. A zoom presents within 150 ms of the press.",
  "module": "Stash",
  "window": [
    1024,
    680
  ],
  "app": {
    "id": "so.oxy.stash",
    "title": "Stash"
  },
  "home": {
    "items": {
      "Documents/": "",
      "Downloads/": "",
      "Pictures/": "",
      "notes.txt": "hello",
      "report.pdf": "%PDF",
      "photo.jpg": "x"
    }
  },
  "steps": [
    {
      "name": "Its first window: the sidebar in it (no drawer, no menu button), the window's controls at its top",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "window_rect": [
          128,
          20,
          1024,
          680
        ],
        "window_shown": true,
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Documents"
            },
            {
              "role": "Button",
              "name": "Hide Sidebar"
            },
            {
              "role": "Button",
              "name": "Close"
            }
          ]
        },
        "at_absent": {
          "window": [
            {
              "role": "Button",
              "name": "Open navigation"
            }
          ]
        }
      }
    },
    {
      "name": "A press held on the toolbar's empty middle moves the window with the pointer",
      "do": [
        "grab",
        [
          522,
          27,
          -60,
          -10
        ]
      ],
      "expect": {
        "window_rect": [
          68,
          10,
          1024,
          680
        ]
      }
    },
    {
      "name": "The right edge dragged 300 px in, in 150 motions at 125 Hz",
      "do": [
        "drag_paced",
        [
          1094,
          400,
          794,
          400,
          150,
          125
        ]
      ],
      "expect": {
        "window_rect": [
          68,
          10,
          724,
          680
        ],
        "drag": {
          "unanswered_max": 0,
          "bounded": true,
          "presented_min": 3,
          "steady": [
            "left",
            "top",
            "bottom"
          ]
        },
        "resize_work": {
          "js_ms_p95_max": 8,
          "busy_refreshes_p95_max": 1.0
        }
      }
    },
    {
      "name": "The right edge dragged back 300 px out, in 150 motions at 125 Hz",
      "do": [
        "drag_paced",
        [
          794,
          400,
          1094,
          400,
          150,
          125
        ]
      ],
      "expect": {
        "window_rect": [
          68,
          10,
          1024,
          680
        ],
        "drag": {
          "unanswered_max": 0,
          "bounded": true,
          "presented_min": 3,
          "steady": [
            "left",
            "top",
            "bottom"
          ]
        },
        "resize_work": {
          "js_ms_p95_max": 8,
          "busy_refreshes_p95_max": 1.0
        }
      }
    },
    {
      "name": "The green bubble zooms the window to the work area",
      "do": [
        "press",
        [
          72,
          26
        ]
      ],
      "expect": {
        "window_rect": [
          0,
          0,
          1280,
          720
        ],
        "resize_work": {
          "zoom_presented_ms_max": 150
        }
      }
    },
    {
      "name": "Pressed again, it restores the frame it had",
      "do": [
        "press",
        [
          72,
          26
        ]
      ],
      "expect": {
        "window_rect": [
          68,
          10,
          1024,
          680
        ],
        "resize_work": {
          "zoom_presented_ms_max": 150
        }
      }
    }
  ]
}
