{
  "about": "Stash (OxyHQ/Stash), OxyOS's file manager: its own Expo Router root from its checkout (the bundle built with STASH_DIR), run as module Stash with its registry id, inside the runtime's Bloom platform adapter, which its own BloomProvider keeps: Bloom draws the window's controls (the `window` capability), and the person's places (the adapter's `files`) open its window on the home of the run's own. Its toolbar is one row, its view switch and sidebar act through the assistive technology's actions and a press, and Oxy Files shows the Oxy SDK resolved signed out, asking to sign in.",
  "module": "Stash",
  "window": [
    1024,
    680
  ],
  "app": {
    "id": "so.oxy.stash",
    "title": "Stash"
  },
  "home": {
    "items": {
      "Documents/": "",
      "Pictures/": "",
      "notes.txt": "hello"
    }
  },
  "steps": [
    {
      "name": "Its first window: the home, from the person's places, in a window whose controls Bloom draws from the runtime's adapter; the toolbar one row (back and forward, the place's name, the view, the search)",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Documents",
          "notes.txt",
          "Pictures",
          "3 items"
        ],
        "focus_surface": 1,
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Close"
            },
            {
              "role": "Button",
              "name": "Minimize"
            },
            {
              "role": "Button",
              "name": "Zoom"
            },
            {
              "role": "Button",
              "name": "home",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "Documents",
              "state": []
            },
            {
              "role": "Button",
              "name": "Pictures",
              "state": []
            },
            {
              "role": "Button",
              "name": "Oxy Files",
              "state": []
            },
            {
              "role": "Button",
              "name": "Photos",
              "state": []
            },
            {
              "role": "Button",
              "name": "Trash",
              "state": []
            },
            {
              "role": "Group",
              "name": "Stash"
            },
            {
              "role": "Button",
              "name": "Hide Sidebar"
            },
            {
              "role": "Button",
              "name": "Back",
              "state": [
                "disabled"
              ]
            },
            {
              "role": "Heading",
              "name": "home"
            },
            {
              "role": "Button",
              "name": "as Icons",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "as List",
              "state": []
            },
            {
              "role": "Search",
              "name": "Search"
            },
            {
              "role": "List",
              "name": "home"
            },
            {
              "role": "ListItem",
              "name": "Documents"
            },
            {
              "role": "ListItem",
              "name": "notes.txt"
            },
            {
              "role": "ListItem",
              "name": "Pictures"
            }
          ]
        },
        "a11y_order": {
          "window": [
            "Favourites",
            "home",
            "Documents",
            "Pictures",
            "Oxy",
            "Oxy Files",
            "Photos",
            "Locations",
            "Trash",
            "Documents",
            "notes.txt",
            "Pictures",
            "Hide Sidebar",
            "Back",
            "Forward",
            "home",
            "as Icons",
            "as List",
            "Search",
            "3 items"
          ]
        }
      }
    },
    {
      "name": "As List: the view switch says so",
      "do": [
        "a11y-action",
        [
          "activate",
          "as List"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "as List",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "as Icons",
              "state": []
            }
          ]
        }
      }
    },
    {
      "name": "Oxy Files, from the sidebar: the Oxy SDK resolved signed out, so it asks to sign in",
      "do": [
        "a11y-action",
        [
          "activate",
          "Oxy Files"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Your files, on every device",
          "Sign in with Oxy"
        ],
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Oxy Files",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "home",
              "state": []
            },
            {
              "role": "Heading",
              "name": "Oxy Files"
            },
            {
              "role": "Heading",
              "name": "Your files, on every device"
            },
            {
              "role": "Button",
              "name": "Sign in with Oxy",
              "state": []
            }
          ]
        }
      }
    },
    {
      "name": "Trash, pressed in the sidebar: the person's Trash, empty",
      "do": [
        "press",
        [
          67,
          372
        ]
      ],
      "expect": {
        "focus_surface": 1,
        "texts": [
          "The Trash is empty"
        ],
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Trash",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "Oxy Files",
              "state": []
            },
            {
              "role": "Heading",
              "name": "Trash"
            }
          ]
        }
      }
    }
  ]
}
