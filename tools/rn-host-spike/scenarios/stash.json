{
  "about": "Stash (OxyHQ/Stash), OxyOS's file manager: its own Expo Router root from its checkout (the bundle built with STASH_DIR), run as module Stash with its registry id, inside the runtime's Bloom platform adapter, which its own BloomProvider keeps: Bloom draws the window's controls (the `window` capability) and its sidebar. The Oxy SDK mounts and resolves signed out, so Oxy Files asks to sign in. Its view switch and its sidebar act on the accessibility tree as a screen reader would act on them.",
  "module": "Stash",
  "window": [
    1024,
    680
  ],
  "app": {
    "id": "so.oxy.stash",
    "title": "Stash"
  },
  "steps": [
    {
      "name": "Its first screen: Oxy Files, signed out, in a window whose controls Bloom draws",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Oxy Files",
          "Your files, on every device",
          "Sign in with Oxy"
        ],
        "focus_surface": 1,
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Close"
            },
            {
              "role": "Button",
              "name": "Minimize"
            },
            {
              "role": "Button",
              "name": "Zoom"
            },
            {
              "role": "Button",
              "name": "Oxy Files",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "Photos",
              "state": []
            },
            {
              "role": "Button",
              "name": "Trash",
              "state": []
            },
            {
              "role": "Heading",
              "name": "Oxy Files"
            },
            {
              "role": "Radio",
              "name": "as Icons",
              "state": [
                "checked"
              ]
            },
            {
              "role": "Radio",
              "name": "as List",
              "state": []
            },
            {
              "role": "Heading",
              "name": "Your files, on every device"
            },
            {
              "role": "Button",
              "name": "Sign in with Oxy",
              "state": []
            }
          ]
        },
        "a11y_order": {
          "window": [
            "Oxy Files",
            "Photos",
            "Trash",
            "Oxy Files",
            "Your files, on every device",
            "Sign in with Oxy"
          ]
        }
      }
    },
    {
      "name": "As List: the view switch says so",
      "do": [
        "a11y-action",
        [
          "activate",
          "as List"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "at": {
          "window": [
            {
              "role": "Radio",
              "name": "as List",
              "state": [
                "checked"
              ]
            },
            {
              "role": "Radio",
              "name": "as Icons",
              "state": []
            }
          ]
        }
      }
    },
    {
      "name": "Photos, from the sidebar",
      "do": [
        "a11y-action",
        [
          "activate",
          "Photos"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Photos",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "Oxy Files",
              "state": []
            },
            {
              "role": "Heading",
              "name": "Photos"
            }
          ]
        }
      }
    },
    {
      "name": "Trash, pressed in the sidebar",
      "do": [
        "press",
        [
          67,
          245
        ]
      ],
      "expect": {
        "focus_surface": 1,
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Trash",
              "state": [
                "selected"
              ]
            },
            {
              "role": "Button",
              "name": "Photos",
              "state": []
            },
            {
              "role": "Heading",
              "name": "Trash"
            }
          ]
        }
      }
    }
  ]
}
