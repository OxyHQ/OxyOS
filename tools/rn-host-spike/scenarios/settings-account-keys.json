{
  "about": "Settings' Oxy account from the keyboard with the screen reader on, in Spanish (docs/adr/0020-oxy-account-login.mdx, decision 5; docs/adr/0039-keyboard-access.mdx; docs/adr/0014-screen-reader.mdx): the account is the sidebar's first row, under its group's heading, said with its place; Home selects it and shows its page; Tab goes on to Cerrar sesión… and Eliminar de este ordenador…, each said as a button; Return opens each one's confirmation, which Escape cancels without asking anything, the keyboard back on its button. Every step checks the keyboard's focus and what the reader says. At 1 (1280 × 720).",
  "locale": "es_ES.UTF-8",
  "module": "OxyOSSettings",
  "window": [
    900,
    640
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.settings",
    "title": "Settings"
  },
  "settings": {
    "app": "so.oxy.settings",
    "preferences": {
      "appearance": "light",
      "accent": "oxy"
    }
  },
  "reader": {},
  "account": {
    "registered": [
      "so.oxy.settings"
    ]
  },
  "steps": [
    {
      "name": "Settings' window, the reader on, nothing of it focused",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": null,
        "spoken": [],
        "announcements": []
      }
    },
    {
      "name": "Tab: the sidebar's selected row, Appearance, second after the account",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "settings-nav-appearance",
          "ring": true
        },
        "at": {
          "window": [
            {
              "role": "Heading",
              "name": "Cuenta de Oxy"
            },
            {
              "role": "ListItem",
              "name": "Ada Lovelace",
              "state": []
            },
            {
              "role": "ListItem",
              "name": "Apariencia",
              "state": [
                "selected",
                "focused"
              ]
            }
          ]
        },
        "spoken": [
          {
            "text": "Apariencia, seleccionado, 2 de 21",
            "interrupting": true
          }
        ],
        "announcements": []
      }
    },
    {
      "name": "Home: the account selected and its page shown, said with its place",
      "do": [
        "key",
        [
          102
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "settings-nav-oxy-account",
          "ring": true
        },
        "texts": [
          "@ada",
          "Cerrar sesión…",
          "Eliminar de este ordenador…"
        ],
        "spoken": [
          {
            "text": "Ada Lovelace, seleccionado, 1 de 21",
            "interrupting": true
          }
        ],
        "announcements": []
      }
    },
    {
      "name": "Tab: Cerrar sesión…, a button",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "oxy-account-sign-out",
          "ring": true
        },
        "spoken": [
          {
            "text": "Cerrar sesión…, botón",
            "interrupting": true
          }
        ],
        "announcements": []
      }
    },
    {
      "name": "Tab: Eliminar de este ordenador…, a button",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "oxy-account-remove",
          "ring": true
        },
        "spoken": [
          {
            "text": "Eliminar de este ordenador…, botón",
            "interrupting": true
          }
        ],
        "announcements": []
      }
    },
    {
      "name": "Return: its confirmation, said as a dialog, Cancelar its default",
      "do": [
        "key",
        [
          28
        ]
      ],
      "expect": {
        "texts": [
          "¿Eliminar a Ada Lovelace de este ordenador?",
          "Eliminar",
          "Cancelar"
        ],
        "account_session": [],
        "spoken": [
          {
            "text": "¿Eliminar a Ada Lovelace de este ordenador?, diálogo",
            "interrupting": true
          },
          {
            "text": "Se cierra la sesión de la cuenta y se borran sus archivos, ajustes y apps de este ordenador. Tu cuenta de Oxy no se elimina: puedes volver a añadirla a este ordenador con conexión.",
            "interrupting": false
          },
          {
            "text": "Cancelar, botón",
            "interrupting": false
          }
        ]
      }
    },
    {
      "name": "Escape: cancelled, nothing asked, the keyboard back on its button",
      "do": [
        "key",
        [
          1
        ]
      ],
      "expect": {
        "absent": [
          "¿Eliminar a Ada Lovelace de este ordenador?"
        ],
        "keyboard_focus": {
          "target": "oxy-account-remove",
          "ring": true
        },
        "account_session": [],
        "spoken": [
          {
            "text": "Eliminar de este ordenador…, botón",
            "interrupting": true
          }
        ]
      }
    },
    {
      "name": "Shift+Tab: back to Cerrar sesión…",
      "do": [
        "key",
        [
          42,
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "oxy-account-sign-out",
          "ring": true
        },
        "spoken": [
          {
            "text": "Cerrar sesión…, botón",
            "interrupting": true
          }
        ]
      }
    },
    {
      "name": "Return: its confirmation, said as a dialog, Cerrar sesión its default",
      "do": [
        "key",
        [
          28
        ]
      ],
      "expect": {
        "texts": [
          "¿Cerrar sesión en OxyOS?",
          "Las apps se cierran y la sesión termina. Puedes volver a iniciar sesión en la pantalla de inicio, incluso sin conexión."
        ],
        "spoken": [
          {
            "text": "¿Cerrar sesión en OxyOS?, diálogo",
            "interrupting": true
          },
          {
            "text": "Las apps se cierran y la sesión termina. Puedes volver a iniciar sesión en la pantalla de inicio, incluso sin conexión.",
            "interrupting": false
          },
          {
            "text": "Cerrar sesión, botón",
            "interrupting": false
          }
        ]
      }
    },
    {
      "name": "Escape: cancelled, the keyboard back on its button",
      "do": [
        "key",
        [
          1
        ]
      ],
      "expect": {
        "absent": [
          "¿Cerrar sesión en OxyOS?"
        ],
        "keyboard_focus": {
          "target": "oxy-account-sign-out",
          "ring": true
        },
        "spoken": [
          {
            "text": "Cerrar sesión…, botón",
            "interrupting": true
          }
        ]
      }
    }
  ]
}
