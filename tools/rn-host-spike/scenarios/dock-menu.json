        "Inbox"
      ],
      "expect": {
        "react": {},
        "delivered": {},
        "in_shell": {
          "texts": [
            "Inbox"
          ]
        },
        "shell": {
          "surfaces": [
            [
              0,
              0,
              1280,
              720
            ],
            [
              0,
              0,
              1280,
              28
            ],
            [
              0,
              664,
              1280,
              56
            ],
            [
              618,
              624,
              240,
              45
            ]
          ]
        }
      }
    },
