{
  "about": "Who the lock screen is for (docs/adr/0010-lock-screen.mdx; docs/adr/0020-oxy-account-login.mdx, decision 1 as amended on 2026-11-09), with the screen reader on in Spanish: the session's shell follows the accounts' service's snapshot (played here: Grace Hopper, @grace) as OxyOS itself, and the lock screen names the person by the account's display name, as a Mac's shows the full name: drawn under the picture and held as a text for the screen reader, never the account's Unix user (`oxy-…`) nor its short name. Locking says what it said before (the screen locked, the password field), and the right password unlocks. At 1 (1280 × 720).",
  "locale": "es_ES.UTF-8",
  "module": "EditingProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.allo",
    "title": "Allo"
  },
  "reader": {},
  "lock_password": "oxyos.correcta",
  "account": {
    "registered": [],
    "snapshot": {
      "account": {
        "id": "0190a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5c",
        "handle": "grace",
        "displayName": "Grace Hopper"
      }
    }
  },
  "steps": [
    {
      "name": "Allo's window; the reader on",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": null,
        "spoken": [],
        "announcements": []
      }
    },
    {
      "name": "Ctrl+Super+Q locks: the lock screen names the person as their Oxy account does (its display name, from the accounts' service's snapshot), shown and held for the screen reader, never the Unix user; its password field focused and said",
      "do": [
        "strokes",
        [
          [
            29,
            125,
            16
          ]
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true
        },
        "spoken": [
          {
            "text": "Pantalla bloqueada",
            "interrupting": true
          },
          {
            "text": "Contraseña, campo de texto",
            "interrupting": false
          }
        ],
        "announcements": [],
        "in_shell": {
          "texts": [
            "Grace Hopper"
          ],
          "absent": [
            "oxy-",
            "grace"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Text",
              "name": "Grace Hopper"
            },
            {
              "role": "TextInput",
              "name": "Contraseña",
              "state": [
                "focused"
              ]
            }
          ]
        },
        "at_absent": {
          "shell": [
            {
              "name": "grace"
            }
          ]
        }
      }
    },
    {
      "name": "the right password unlocks",
      "do": [
        "keyboard",
        "oxyos.correcta\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": false
        },
        "announcements": []
      }
    }
  ]
}
