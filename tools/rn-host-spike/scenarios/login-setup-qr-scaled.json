{
  "about": "Adding an Oxy account with the QR (docs/adr/0020-oxy-account-login.mdx, decision 4), at 1.25, against a played Oxy API and a played accounts' service (no credential of anyone's): \"Add Account\" pressed beside an enrolled account, online, the login screen shows the Oxy SDK's own account chooser, the one an app's account dialog shows, on its card: on a computer, as in a browser, its split card with the Commons QR a phone scans beside the form, the card grown to the width the chooser asks, the email or username field focused. The screen joins Oxy's Socket.IO `/auth-session` namespace over React Native's WebSocket (the host's WebSocketModule) and a phone approves the request then (the played API's stand-in): told on the socket, the screen claims the session at once, once (one approval: the account on the device, its token taken by every request after; no device picker ever shown), not at its status check twelve seconds on, the credential goes to the host, and the person gives the account's password once more, in the login screen's own field, focused. The accounts' service sets the account up with the credential and the password; enrolled, the new account is chosen and its password signs it in.",
  "shell": "OxyOSLogin",
  "outputs": "1600x1000@1.25",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [
      {
        "accountId": "0123456789abcdef01234567",
        "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
        "uid": 1001,
        "name": "Bea Ramos"
      }
    ],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 7500
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "the login screen with one account",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Add Account: setup, online, the SDK's chooser asking for its QR",
      "do": [
        "press_named",
        "Add Account"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "platform: platform"
        ],
        "delivered": {},
        "oxy_requests": [
          "POST /auth/session/create 200",
          "WS /auth-session join {token} 101"
        ]
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves the QR: the session claimed, the account's password asked once more, its field focused",
      "do": [
        "wait",
        4000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "WS /auth-session auth_update 101",
          "GET /auth/session/status/{token} 200",
          "POST /auth/session/claim 200",
          "POST /session/device/add 200",
          "GET /users/me 200",
          "GET /users/me/sign-in-methods 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Enter Ada Lovelace's password",
            "OxyOS signs in with your Oxy account's password, even offline. Enter it once more."
          ],
          "absent": [
            "Scan with Commons to sign in",
            "Email or username",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "login-setup-password"
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 1,
          "POST /auth/session/create 200": 0
        }
      }
    },
    {
      "name": "the password: the account set up with the credential the QR's sign-in handed over",
      "do": [
        "keyboard",
        "played password 1\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: enrolled"
        ],
        "delivered": {},
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "texts": [
            "Bea Ramos",
            "Ada Lovelace",
            "Add Account"
          ],
          "absent": [
            "Add an Oxy Account",
            "Enter Ada Lovelace's password"
          ],
          "never": [
            "played password 1"
          ]
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 0,
          "POST /auth/session/create 200": 0
        }
      }
    },
    {
      "name": "its password signs it in",
      "do": [
        "keyboard",
        "oxyos.correcta\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "oxyos.correcta",
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "oxyos.correcta",
            "played password 1"
          ]
        }
      }
    }
  ]
}
