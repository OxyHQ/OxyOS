{
  "about": "Adding an Oxy account with the QR (docs/adr/0020-oxy-account-login.mdx, decision 4), at 1.25, against a played Oxy API and a played accounts' service (no credential of anyone's): \"Add Account\" pressed beside an enrolled account, online, the login screen shows the Oxy SDK's own account chooser, the one an app's account dialog shows, on its card: on a computer, as in a browser, its split card with the Commons QR a phone scans beside the form, the card grown to the width the chooser asks, the email or username field focused. The screen joins Oxy's Socket.IO `/auth-session` namespace over React Native's WebSocket (the host's WebSocketModule) and a phone approves the request then (the played API's stand-in): told on the socket, the screen claims the session at once, once (one approval: the account on the device, its token taken by every request after; no device picker ever shown), not at its status check twelve seconds on, the credential goes to the host, and the person sets a PIN, typed twice, and is never asked for or offered a password (a sign-in by the QR, docs/adr/0020-oxy-account-login.mdx decision 2 as amended), in the login screen's own field, focused. The accounts' service sets the account up with the credential and the password; enrolled, the new account is chosen and its password signs it in.",
  "shell": "OxyOSLogin",
  "outputs": "1600x1000@1.25",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [
      {
        "accountId": "0123456789abcdef01234567",
        "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
        "uid": 1001,
        "name": "Bea Ramos"
      }
    ],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 7500
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "the login screen with one account",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Add Account: setup, online, the SDK's chooser asking for its QR",
      "do": [
        "press_named",
        "Add Account"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "platform: platform"
        ],
        "delivered": {},
        "oxy_requests": [
          "POST /auth/session/create 200",
          "WS /auth-session join {token} 101"
        ]
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves the QR: the session claimed, a PIN for this computer asked, its field focused, no password asked or offered",
      "do": [
        "wait",
        4000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "WS /auth-session auth_update 101",
          "GET /auth/session/status/{token} 200",
          "POST /auth/session/claim 200",
          "POST /session/device/add 200",
          "GET /users/me 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Create a PIN",
            "You’ll use it to sign in and unlock this computer, even offline. It stays here: Oxy never sees it."
          ],
          "absent": [
            "Choose an account",
            "Email or username",
            "Enter Ada Lovelace's password",
            "Not Now",
            "Scan with Commons to sign in",
            "Send code",
            "Set a password",
            "Use another account"
          ],
          "focus_input": "login-setup-pin-password"
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 1,
          "POST /auth/session/create 200": 0
        }
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter Your PIN Again"
          ],
          "absent": [
            "Enter Ada Lovelace's password",
            "Not Now",
            "Set a password",
            "Send code"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916"
          ]
        }
      }
    },
    {
      "name": "typed again: the look's page",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Choose Your Look",
            "Continue"
          ]
        },
        "never": [
          "482916"
        ]
      }
    },
    {
      "name": "Dark chosen",
      "do": [
        "press_named",
        "Dark"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Choose Your Look"
          ]
        }
      }
    },
    {
      "name": "Continue pressed",
      "do": [
        "press_named",
        "Continue"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "appearance: dark",
          "enroll: enrolled",
          "verifyPin: accepted"
        ]
      }
    },
    {
      "name": "Continue: the account set up with what was chosen, its stages shown, and signed in with it at once, never asked again",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "in_shell": {},
        "oxy_requests_times": {
          "POST /auth/session/create 200": 0
        }
      }
    }
  ]
}
