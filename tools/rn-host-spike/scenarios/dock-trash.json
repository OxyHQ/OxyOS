{
  "about": "The Trash at the dock's end (docs/adr/0034-the-dock.mdx), past a divider: the Trash of a home of the run's own, holding a file. Its menu (a long press) offers Open and Empty Trash; Empty Trash asks the person in a system sheet, and only their acceptance empties it, for good, the file staying in the home; emptied, its menu offers emptying no more. A click opens it in the file manager: the session opens stash://trash in Stash, whose entry declares its scheme, at its Trash.",
  "module": "EditingProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.allo",
    "title": "Allo"
  },
  "home": {
    "items": {
      "notes.txt": "keep me",
      ".local/share/Trash/files/old.txt": "old",
      ".local/share/Trash/info/old.txt.trashinfo": "[Trash Info]\nPath=/home/ada/old.txt\nDeletionDate=2026-01-01T10:00:00\n"
    }
  },
  "steps": [
    {
      "name": "a long press on the Trash: Open, and Empty Trash, which it can, holding a file",
      "do": [
        "hold_output",
        [
          834,
          693,
          650
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {},
        "delivered": {
          "1": {
            "focus.out": 1
          }
        },
        "in_shell": {
          "texts": [
            "Abrir",
            "Vaciar Papelera"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Menu",
              "name": "Papelera"
            },
            {
              "role": "MenuItem",
              "name": "Vaciar Papelera",
              "state": []
            }
          ]
        }
      }
    },
    {
      "name": "Down: Open",
      "do": [
        "key",
        108
      ],
      "expect": {
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Down: Empty Trash",
      "do": [
        "key",
        108
      ],
      "expect": {
        "react": {},
        "delivered": {},
        "at": {
          "shell": [
            {
              "role": "MenuItem",
              "name": "Vaciar Papelera",
              "state": [
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Return: the session asks the person, in a system sheet; nothing is gone yet",
      "do": [
        "key",
        28
      ],
      "expect": {
        "react": {},
        "delivered": {},
        "in_shell": {
          "texts": [
            "¿Seguro que quieres eliminar permanentemente los ítems de la Papelera?",
            "Se eliminará 1 ítem. No puedes deshacer esta acción.",
            "Cancelar",
            "Vaciar"
          ]
        },
        "home": {
          "notes.txt": "keep me",
          "trash": [
            "old.txt"
          ]
        }
      }
    },
    {
      "name": "the person accepts: the Trash is emptied for good, the home's file stays",
      "do": [
        "press_output",
        [
          750,
          432
        ]
      ],
      "expect": {
        "react": {},
        "delivered": {
          "1": {
            "enter": 1,
            "focus.in": 1
          }
        },
        "in_shell": {
          "absent": [
            "¿Seguro que quieres eliminar permanentemente los ítems de la Papelera?"
          ]
        },
        "home": {
          "notes.txt": "keep me",
          "trash": []
        }
      }
    },
    {
      "name": "its menu again: Empty Trash disabled, the Trash empty",
      "do": [
        "hold_output",
        [
          834,
          693,
          650
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {},
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1
          }
        },
        "in_shell": {
          "texts": [
            "Abrir",
            "Vaciar Papelera"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "MenuItem",
              "name": "Vaciar Papelera",
              "state": [
                "disabled"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Escape closes it",
      "do": [
        "key",
        1
      ],
      "expect": {
        "react": {},
        "delivered": {},
        "in_shell": {
          "absent": [
            "Vaciar Papelera"
          ]
        }
      }
    },
    {
      "name": "a click on the Trash: the session opens stash://trash in Stash, whose entry declares its scheme",
      "do": [
        "press_output",
        [
          834,
          693
        ]
      ],
      "expect": {
        "react": {},
        "delivered": {},
        "urls_opened": [
          {
            "url": "stash://trash",
            "application": "so.oxy.stash"
          }
        ]
      }
    }
  ]
}