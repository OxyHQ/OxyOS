{
  "about": "Settings' Sound and Notifications (docs/adr/0044-system-sounds.mdx), as a Mac's: Sound's \"Play user interface sound effects\" is on, as the session keeps it by default; turned off, the file keeps `ui_sounds = false`. Notifications lists the session's applications, each with \"Play sound for notifications\" on; Allo's turned off, the file keeps `notification_sounds_off = so.oxy.allo`. With the session's shell, whose development registry lists the applications.",
  "locale": "en_US.UTF-8",
  "module": "OxyOSSettings",
  "window": [
    960,
    600
  ],
  "shell": "OxyOSShell",
  "outputs": "1920x1080",
  "app": {
    "id": "so.oxy.settings",
    "title": "Settings"
  },
  "settings": {
    "app": "so.oxy.settings",
    "preferences": {
      "appearance": "light",
      "accent": "oxy"
    }
  },
  "steps": [
    {
      "name": "Sound: Play user interface sound effects, on",
      "do": [
        "a11y-action",
        [
          "activate",
          "Sound"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Play user interface sound effects"
        ],
        "at": {
          "window": [
            {
              "role": "Switch",
              "name": "Play user interface sound effects",
              "state": [
                "checked"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "turned off: the session keeps ui_sounds = false",
      "do": [
        "press",
        [
          890,
          100
        ]
      ],
      "expect": {
        "at": {
          "window": [
            {
              "role": "Switch",
              "name": "Play user interface sound effects",
              "state": []
            }
          ]
        },
        "preferences_file": {
          "ui_sounds": "false"
        }
      }
    },
    {
      "name": "Notifications: each application's notification sound, on",
      "do": [
        "a11y-action",
        [
          "activate",
          "Notifications"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Application notifications",
          "Allo",
          "Play sound for notifications"
        ],
        "at": {
          "window": [
            {
              "role": "Switch",
              "name": "Play sound for Allo's notifications",
              "state": [
                "checked"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Allo's turned off: the session keeps notification_sounds_off = so.oxy.allo",
      "do": [
        "a11y-action",
        [
          "activate",
          "Play sound for Allo's notifications"
        ]
      ],
      "expect": {
        "at": {
          "window": [
            {
              "role": "Switch",
              "name": "Play sound for Allo's notifications",
              "state": []
            }
          ]
        },
        "preferences_file": {
          "notification_sounds_off": "so.oxy.allo"
        }
      }
    }
  ],
  "final": {
    "preferences_file": {
      "ui_sounds": "false",
      "notification_sounds_off": "so.oxy.allo"
    }
  }
}
