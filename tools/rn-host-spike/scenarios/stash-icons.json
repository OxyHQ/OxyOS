{
 "about": "Stash's icons, Finder's, for every kind of item on a home of the run's own: a folder, a page with its kind's glyph (a zip, an mp3, a text, a PDF), and a picture drawn from its own pixels by the platform; a picture the platform cannot draw falls back to an image's page instead of an empty cell (photo.jpg holds no JPEG). React hears the picture load and the failure; the pixels say what is drawn where.",
 "module": "Stash",
 "window": [
  1024,
  680
 ],
 "app": {
  "id": "so.oxy.stash",
  "title": "Stash"
 },
 "home": {
  "items": {
   "archive.zip": {
    "bytes": 2000
   },
   "Documents/": "",
   "music.mp3": {
    "bytes": 3000
   },
   "notes.txt": "hello",
   "photo.jpg": "x",
   "picture.png": {
    "png": [
     640,
     480,
     "#3a7bd5"
    ]
   },
   "report.pdf": "%PDF"
  }
 },
 "steps": [
  {
   "name": "Every item has its kind's icon: the folder, a page with its kind's glyph, the picture itself; a picture the platform cannot draw (photo.jpg is not a JPEG) tells Stash so and is an image's page, never an empty cell",
   "do": [
    "wait",
    1500
   ],
   "allow_unchanged": true,
   "expect": {
    "texts": [
     "archive.zip",
     "Documents",
     "music.mp3",
     "notes.txt",
     "photo.jpg",
     "picture.png",
     "report.pdf",
     "7 items"
    ],
    "pixels": {
     "712,123": "#ffffff",
     "832,107": "#3a7bd5"
    }
   }
  },
  {
   "name": "As List: every row has its kind's small icon; the two pictures are asked of the platform again, the one it cannot draw told so, the other drawn",
   "do": [
    "a11y-action",
    [
     "activate",
     "as List"
    ]
   ],
   "expect": {
    "react": {
     "loadStart@thumbnail-photo.jpg": 1,
     "error@thumbnail-photo.jpg": 1,
     "loadEnd@thumbnail-photo.jpg": 1,
     "loadStart@thumbnail-picture.png": 1,
     "load@thumbnail-picture.png": 1,
     "loadEnd@thumbnail-picture.png": 1,
     "click@view-list": 1
    },
    "at": {
     "window": [
      {
       "role": "Button",
       "name": "as List",
       "state": [
        "selected"
       ]
      },
      {
       "role": "ListItem",
       "name": "photo.jpg"
      }
     ]
    },
    "texts": [
     "Kind",
     "7 items"
    ]
   }
  },
  {
   "name": "As Icons again: the same icons, photo.jpg's page and picture.png's own pixels",
   "do": [
    "a11y-action",
    [
     "activate",
     "as Icons"
    ]
   ],
   "expect": {
    "react": {
     "loadStart@thumbnail-photo.jpg": 1,
     "error@thumbnail-photo.jpg": 1,
     "loadEnd@thumbnail-photo.jpg": 1,
     "loadStart@thumbnail-picture.png": 1,
     "load@thumbnail-picture.png": 1,
     "loadEnd@thumbnail-picture.png": 1,
     "click@view-icons": 1
    },
    "pixels": {
     "712,123": "#ffffff",
     "832,107": "#3a7bd5"
    },
    "at": {
     "window": [
      {
       "role": "Button",
       "name": "as Icons",
       "state": [
        "selected"
       ]
      }
     ]
    }
   }
  }
 ]
}
