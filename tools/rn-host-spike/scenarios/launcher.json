            0,
            1280,
            800
          ]
        },
        "transitions": {
          "frames_min": 6,
          "seen": [
            {
              "kind": "backdrop",
              "arriving": true,
              "first": 0,
              "ended": true,
              "eased": true,
              "still": true,
              "lasts_ms": [
                360,
                460
              ]
            },
            {
              "kind": "overlay",
              "arriving": true,
