              ]
            }
          ],
          "count": 2
        },
        "react": {},
        "delivered": {
          "1": {
            "focus.out": 1
          }
        },
        "in_shell": {
          "react": {
            "touchStart@dock-launcher": 1,
            "touchEnd@dock-launcher": 1,
            "focus@launcher-search": 1,
            "selectionChange@launcher-search": 1
          },
          "texts": [
            "Buscar",
            "Inbox",
            "Allo",
            "Settings"
          ]
        },
        "output_pixels": {
          "265,175": "#1a73e8",
          "622,150": "#7d828c",
          "422,187": "#4e054c",
          "1300,500": "#486fd4",
