{
  "about": "Adding an Oxy account that has no password and no email, by its QR (the owner's: a Commons account, docs/adr/0020-oxy-account-login.mdx decision 2 as amended): after the phone's approval the screen never asks for a password, never offers to make one, and shows no email or code; it asks for a PIN, typed twice, with no way to skip it, and sends the setup with the PIN alone, which the accounts' service redeems through Oxy's device-proof route. Enrolled, the account is listed and chosen, its PIN's field focused and no password offered, and its PIN signs it in.",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [
      {
        "accountId": "0123456789abcdef01234567",
        "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
        "uid": 1001,
        "name": "Bea Ramos"
      }
    ],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": false,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 7500
      },
      "has_email": false
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": null,
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "the login screen with one account",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Add Account: setup, online, the SDK's chooser asking for its QR",
      "do": [
        "press_named",
        "Add Account"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "platform: platform"
        ],
        "delivered": {},
        "oxy_requests": [
          "POST /auth/session/create 200",
          "WS /auth-session join {token} 101"
        ]
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves the QR: the session claimed, and a PIN for this computer asked, its field focused",
      "do": [
        "wait",
        4000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "POST /auth/session/claim 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Create a PIN",
            "You'll use it to sign in and unlock this computer, even offline. It stays here: Oxy never sees it."
          ],
          "absent": [
            "Email or username",
            "Enter Ada Lovelace's password",
            "New password",
            "Not Now",
            "Repeat the password",
            "Save password",
            "Scan with Commons to sign in",
            "Send code",
            "Set a password"
          ],
          "focus_input": "login-setup-pin-password"
        }
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter Your PIN Again"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916"
          ],
          "absent": [
            "Enter Ada Lovelace's password",
            "New password",
            "Not Now",
            "Repeat the password",
            "Save password",
            "Send code",
            "Set a password"
          ]
        }
      }
    },
    {
      "name": "typed again: the look's page",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Choose Your Look",
            "Continue"
          ]
        },
        "never": [
          "482916"
        ]
      }
    },
    {
      "name": "Auto chosen",
      "do": [
        "press_named",
        "Auto"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Choose Your Look"
          ]
        }
      }
    },
    {
      "name": "Continue pressed",
      "do": [
        "press_named",
        "Continue"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "appearance: auto",
          "enroll: enrolled",
          "verifyPin: accepted"
        ]
      }
    },
    {
      "name": "Continue: the account set up with what was chosen, its stages shown, and signed in with it at once, never asked again",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "in_shell": {},
        "oxy_requests_times": {
          "POST /auth/session/create 200": 0
        }
      }
    }
  ]
}
