{
  "about": "Adding an Oxy account that has no password and no email (the owner's, docs/adr/0020-oxy-account-login.mdx decision 2's amendment) (docs/adr/0020-oxy-account-login.mdx, decision 2): after the QR's approval the screen never asks the person to make an Oxy password; it asks for a PIN, typed twice, and sends the setup with the PIN alone. The accounts' service refuses it (`passwordRequired`: Oxy issues the platform's credential only to its password sign-in, and has no way yet to issue it to a PIN's setup) before asking Oxy anything or changing the machine, and the screen says so plainly: nothing was set up, nobody signs in, and the account is not listed. No set-password panel, no email or code is ever shown: the account goes from the QR straight to the PIN.",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [
      {
        "accountId": "0123456789abcdef01234567",
        "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
        "uid": 1001,
        "name": "Bea Ramos"
      }
    ],
    "record": [],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": false,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 7500
      },
      "has_email": false
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": null,
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "the login screen with one account",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Add Account: setup, online, the SDK's chooser asking for its QR",
      "do": [
        "press_named",
        "Add Account"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "platform: platform"
        ],
        "delivered": {},
        "oxy_requests": [
          "POST /auth/session/create 200",
          "WS /auth-session join {token} 101"
        ]
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves the QR: the session claimed, and a PIN for this computer asked, its field focused",
      "do": [
        "wait",
        4000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "POST /auth/session/claim 200",
          "GET /users/me/sign-in-methods 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Choose a PIN for this computer",
            "Use it to sign in and unlock, even offline. It stays on this computer: Oxy never sees it."
          ],
          "absent": [
            "Email or username",
            "Enter Ada Lovelace's password",
            "New password",
            "Not Now",
            "Repeat the password",
            "Save password",
            "Scan with Commons to sign in",
            "Send code",
            "Set a password"
          ],
          "focus_input": "login-setup-pin-password"
        }
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter the PIN again"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916"
          ],
          "absent": [
            "New password",
            "Repeat the password",
            "Save password",
            "Send code",
            "Set a password"
          ]
        }
      }
    },
    {
      "name": "a PIN, typed twice: the setup sent with the PIN alone, refused, and said; nothing set up",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: refused"
        ],
        "delivered": {},
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "OxyOS can't set up an Oxy account without a password yet: a PIN alone isn't supported until Oxy allows it. Nothing was changed on this computer.",
            "Back"
          ],
          "absent": [
            "Ada Lovelace",
            "Enter Ada Lovelace's password",
            "New password",
            "Repeat the password",
            "Save password",
            "Send code",
            "Set a password"
          ],
          "never": [
            "482916"
          ]
        }
      }
    },
    {
      "name": "back: the enrolled account alone, as before",
      "do": [
        "press_named",
        "Back"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Bea Ramos",
            "Add Account"
          ],
          "absent": [
            "Ada Lovelace",
            "New password",
            "Repeat the password",
            "Save password",
            "Send code",
            "Set a password"
          ],
          "focus_input": "login-password"
        }
      }
    }
  ]
}
