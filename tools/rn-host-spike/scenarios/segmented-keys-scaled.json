{
 "about": "A segmented control from the keyboard, as a Mac's with Full Keyboard Access and WAI-ARIA's radio group (docs/adr/0039-keyboard-access.mdx; Bloom's SegmentedControl): Settings with the shell, the screen reader on in Spanish. Tab reaches Appearance's Light / Dark / Auto once, on its chosen segment; → ← (↓ ↑) choose the next segment round the ends, the session's appearance changing and every application told, the keyboard following each choice once the session applied it and each segment said once, chosen; Tab goes on past the control and Shift+Tab back to its chosen segment. Every step checks the keyboard's focus, what the assistive technology holds, what the reader says, what is announced and the preference. At 1.25 (1600 × 1000).",
 "locale": "es_ES.UTF-8",
 "module": "OxyOSSettings",
 "window": [
  900,
  640
 ],
 "shell": "OxyOSShell",
 "app": {
  "id": "so.oxy.settings",
  "title": "Settings"
 },
 "settings": {
  "app": "so.oxy.settings",
  "preferences": {
   "appearance": "light",
   "accent": "oxy"
  }
 },
 "reader": {},
 "outputs": "1600x1000@1.25",
 "steps": [
  {
   "name": "Settings' window with the shell, the reader on, nothing of it focused",
   "do": [
    "wait",
    1500
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": null,
    "spoken": [],
    "announcements": []
   }
  },
  {
   "name": "Tab: the sidebar's selected row, Appearance",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "focus@settings-nav-appearance": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-appearance",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Apariencia",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Apariencia, seleccionado, 1 de 20",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "Tab: the appearance's segmented control, one stop: its chosen segment, Light, said once as chosen",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "blur@settings-nav-appearance": 1,
     "focus@appearance-light": 1
    },
    "keyboard_focus": {
     "target": "appearance-light",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Claro",
       "state": [
        "checked",
        "focused"
       ]
      },
      {
       "role": "Radio",
       "name": "Oscuro",
       "state": []
      },
      {
       "role": "Radio",
       "name": "Automático",
       "state": []
      }
     ]
    },
    "spoken": [
     {
      "text": "Claro, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "→ chooses Dark: the session's appearance changes and every application is told; the keyboard follows the choice once the session applied it, Dark said once as chosen",
   "do": [
    "key",
    [
     106
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@appearance-light": 1,
     "focus@appearance-dark": 1
    },
    "keyboard_focus": {
     "target": "appearance-dark",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Oscuro",
       "state": [
        "checked",
        "focused"
       ]
      },
      {
       "role": "Radio",
       "name": "Claro",
       "state": []
      }
     ]
    },
    "spoken": [
     {
      "text": "Oscuro, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": [],
    "preferences": {
     "dark": true
    }
   }
  },
  {
   "name": "→: Auto",
   "do": [
    "key",
    [
     106
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@appearance-dark": 1,
     "focus@appearance-auto": 1
    },
    "keyboard_focus": {
     "target": "appearance-auto",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Automático",
       "state": [
        "checked",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Automático, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "→ round the end: Light",
   "do": [
    "key",
    [
     106
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@appearance-auto": 1,
     "focus@appearance-light": 1
    },
    "keyboard_focus": {
     "target": "appearance-light",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Claro",
       "state": [
        "checked",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Claro, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": [],
    "preferences": {
     "dark": false
    }
   }
  },
  {
   "name": "←: round the start to Auto",
   "do": [
    "key",
    [
     105
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@appearance-light": 1,
     "focus@appearance-auto": 1
    },
    "keyboard_focus": {
     "target": "appearance-auto",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Automático",
       "state": [
        "checked",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Automático, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "↓ is →, as in a radio group: Light",
   "do": [
    "key",
    [
     108
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@appearance-auto": 1,
     "focus@appearance-light": 1
    },
    "keyboard_focus": {
     "target": "appearance-light",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Claro",
       "state": [
        "checked",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Claro, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": [],
    "preferences": {
     "dark": false
    }
   }
  },
  {
   "name": "Tab leaves the control (Dark and Auto are no stops) for the accent's first swatch",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "blur@appearance-light": 1,
     "focus@accent-oxy": 1
    },
    "keyboard_focus": {
     "target": "accent-oxy",
     "ring": true
    },
    "spoken": [
     {
      "text": "Oxy, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "Shift+Tab: back on the control's chosen segment; the session keeps Light",
   "do": [
    "key",
    [
     42,
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "blur@accent-oxy": 1,
     "focus@appearance-light": 1
    },
    "keyboard_focus": {
     "target": "appearance-light",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Claro",
       "state": [
        "checked",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Claro, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": [],
    "preferences_file": {
     "appearance": "light"
    }
   }
  }
 ]
}
