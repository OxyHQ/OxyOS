{
  "about": "Settings' Privacy from the keyboard with the screen reader on in Spanish (docs/adr/0039-keyboard-access.mdx; docs/adr/0030-installing-applications.mdx, decision 8) on a real oxyos-installd with the permission probe installed: each switch is reached alone, so it is named by its capability and its application ('Notifications for Permission', as macOS's Privacy & Security lists name each app's switch), never by its capability alone, which every application's section repeats. Space turns it on, said once ('activado'), and the install service keeps the decision. At 1 (1280 × 720).",
  "locale": "es_ES.UTF-8",
  "module": "OxyOSSettings",
  "window": [
    900,
    640
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.settings",
    "title": "Settings"
  },
  "grants": {
    "so.oxy.settings": [
      "settings",
      "updates",
      "privacy"
    ]
  },
  "installd": {
    "publish": [
      "so.oxy.permissionprobe"
    ],
    "installed": [
      "so.oxy.permissionprobe"
    ]
  },
  "reader": {},
  "steps": [
    {
      "name": "Settings with the reader on, nothing of it focused",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": null,
        "spoken": [],
        "announcements": [],
        "at_absent": {
          "window": [
            {
              "name": "Saved"
            }
          ]
        }
      }
    },
    {
      "name": "Privacy: the probe's notifications, not asked yet",
      "do": [
        "a11y-action",
        [
          "activate",
          "Privacidad"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": null,
        "spoken": [],
        "announcements": [],
        "at": {
          "window": [
            {
              "role": "Switch",
              "name": "Notificaciones para Permission",
              "state": []
            }
          ]
        },
        "at_absent": {
          "window": [
            {
              "role": "Switch",
              "name": "Notificaciones"
            }
          ]
        },
        "texts": [
          "Notificaciones",
          "Aún no se ha preguntado"
        ]
      }
    },
    {
      "name": "Tab: the sidebar's selected row",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "settings-nav-privacy",
          "ring": true
        },
        "spoken": [
          {
            "text": "Privacidad, seleccionado, 15 de 16",
            "interrupting": true
          }
        ],
        "announcements": []
      }
    },
    {
      "name": "Tab: the switch, named by its capability and its application",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "privacy-so.oxy.permissionprobe-notifications-switch",
          "ring": true
        },
        "spoken": [
          {
            "text": "Notificaciones para Permission, desactivado, interruptor",
            "interrupting": true
          }
        ],
        "announcements": [],
        "at": {
          "window": [
            {
              "role": "Switch",
              "name": "Notificaciones para Permission",
              "state": [
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Space: on, said once; the install service keeps it",
      "do": [
        "key",
        [
          57
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "privacy-so.oxy.permissionprobe-notifications-switch",
          "ring": true
        },
        "spoken": [
          {
            "text": "activado",
            "interrupting": true
          }
        ],
        "announcements": [],
        "at": {
          "window": [
            {
              "role": "Switch",
              "name": "Notificaciones para Permission",
              "state": [
                "checked",
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Decided: no longer not asked",
      "do": [
        "wait",
        1000
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "privacy-so.oxy.permissionprobe-notifications-switch",
          "ring": true
        },
        "spoken": [],
        "announcements": [],
        "absent": [
          "Aún no se ha preguntado"
        ]
      }
    },
    {
      "name": "Shift+Tab: the sidebar",
      "do": [
        "key",
        [
          42,
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "settings-nav-privacy",
          "ring": true
        },
        "spoken": [
          {
            "text": "Privacidad, seleccionado, 15 de 16",
            "interrupting": true
          }
        ],
        "announcements": []
      }
    },
    {
      "name": "Tab: the switch again, on",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "keyboard_focus": {
          "target": "privacy-so.oxy.permissionprobe-notifications-switch",
          "ring": true
        },
        "spoken": [
          {
            "text": "Notificaciones para Permission, activado, interruptor",
            "interrupting": true
          }
        ],
        "announcements": [],
        "at_absent": {
          "window": [
            {
              "name": "Saved"
            }
          ]
        }
      }
    }
  ]
}
