{
  "about": "The session's menu bar follows the pointer with a menu open, as a Mac's (Bloom 15.83.0; ADR 0001, Input, focus and grabs): Allo (sample/MenuBarProbe.tsx, its menus in the shell's bar, ADR 0021). File opened by a press; the pointer moving along the bar onto Edit opens Edit's menu in File's place with no press, and back onto File, File's: the compositor gives the shell the pointer's movement over the bar its menu hangs from (the grab chain's base), the host gives it only to the bar (Bloom's trackingRef), and the menu that replaces another takes the grab straight from it, so the application hears nothing between the two. Over the clock beside the bar nothing is hovered and the menu stays open. A press on the open title closes it; a row in a menu the pointer opened runs once. Right and Left from a menu a press opened, the keyboard elsewhere, open the next and previous menus in its place on their first rows. Every step checks which title is expanded and which collapsed as the assistive technology holds them, the menu's rows shown and absent, and what the application was delivered.",
  "module": "MenuBarProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.allo",
    "title": "Allo"
  },
  "steps": [
    {
      "name": "the window is active: the shell's bar shows its application's menu, then File and Edit",
      "do": [
        "press",
        [
          300,
          300
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Allo",
            "File",
            "Edit"
          ]
        },
        "react": {
          "touchStart@menu-probe": 1,
          "touchEnd@menu-probe": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    },
    {
      "name": "a press on File opens it under its title",
      "do": [
        "press_output",
        [
          100,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New",
            "Open Recent"
          ],
          "absent": [
            "Wrap Lines"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "File",
              "state": [
                "expanded"
              ]
            },
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "collapsed"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1
          }
        }
      }
    },
    {
      "name": "the pointer along the bar onto Edit, no press: Edit's menu opens in File's place, as a Mac's bar follows the pointer; the window hears nothing, its keyboard and pointer never handed back between the two menus",
      "do": [
        "move_output",
        [
          137,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Undo",
            "Wrap Lines"
          ],
          "absent": [
            "Open Recent",
            "New"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "expanded"
              ]
            },
            {
              "role": "Button",
              "name": "File",
              "state": [
                "collapsed"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {},
        "at_absent": {
          "shell": [
            {
              "role": "Button",
              "state": [
                "collapsed",
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "back onto File: File's menu again, Edit's gone",
      "do": [
        "move_output",
        [
          100,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New",
            "Open Recent"
          ],
          "absent": [
            "Wrap Lines"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "File",
              "state": [
                "expanded"
              ]
            },
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "collapsed"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {},
        "at_absent": {
          "shell": [
            {
              "role": "Button",
              "state": [
                "collapsed",
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "beside the bar, over the clock, with File open: the pointer has left File's title and nothing there is hovered (the host gives the movement over the bar's surface only to the bar); File stays open",
      "do": [
        "move_output",
        [
          1200,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New",
            "Open Recent"
          ],
          "react_hover": {
            "pointerLeave@shell-menu-File": 1
          }
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "File",
              "state": [
                "expanded"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "onto Edit again, from beside the bar",
      "do": [
        "move_output",
        [
          137,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Undo",
            "Wrap Lines"
          ],
          "absent": [
            "Open Recent"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "expanded"
              ]
            },
            {
              "role": "Button",
              "name": "File",
              "state": [
                "collapsed"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {},
        "at_absent": {
          "shell": [
            {
              "role": "Button",
              "state": [
                "collapsed",
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "a press on Edit's title, the open one, closes its menu and opens nothing; the screen reader's focus is back on the title",
      "do": [
        "press_output",
        [
          137,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "absent": [
            "Undo",
            "Wrap Lines",
            "Open Recent"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "collapsed",
                "focused"
              ]
            },
            {
              "role": "Button",
              "name": "File",
              "state": [
                "collapsed"
              ]
            }
          ]
        },
        "react": {}
      }
    },
    {
      "name": "File by a press, then onto Edit and down to Wrap Lines: chosen in the menu the pointer opened, it runs in the application once",
      "do": [
        "press_output",
        [
          100,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "File",
              "state": [
                "expanded"
              ]
            }
          ]
        },
        "react": {}
      }
    },
    {
      "name": "onto Edit",
      "do": [
        "move_output",
        [
          137,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Wrap Lines"
          ],
          "absent": [
            "Open Recent"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "expanded"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {},
        "at_absent": {
          "shell": [
            {
              "role": "Button",
              "state": [
                "collapsed",
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "choosing Wrap Lines turns it on in the application",
      "do": [
        "press_output",
        [
          194,
          90
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "wrap lines: on",
          "new documents: 0"
        ],
        "react": {
          "menuActivated@menu-bar": 1
        },
        "delivered": {
          "1": {
            "menu.activated": 1
          }
        },
        "in_shell": {
          "absent": [
            "Wrap Lines",
            "Undo"
          ]
        }
      }
    },
    {
      "name": "File by a press, the keyboard elsewhere",
      "do": [
        "press_output",
        [
          100,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "File",
              "state": [
                "expanded"
              ]
            }
          ]
        },
        "react": {}
      }
    },
    {
      "name": "Right from the menu a press opened: Edit opens in its place on its first enabled row, as a Mac's menu opened by a click; the window hears nothing",
      "do": [
        "key",
        106
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Undo",
            "Wrap Lines"
          ],
          "absent": [
            "Open Recent"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "expanded"
              ]
            },
            {
              "role": "Button",
              "name": "File",
              "state": [
                "collapsed"
              ]
            },
            {
              "role": "CheckBox",
              "name": "Wrap Lines",
              "state": [
                "checked",
                "focused"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Left: File again in its place, on New",
      "do": [
        "key",
        105
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New",
            "Open Recent"
          ],
          "absent": [
            "Wrap Lines"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "File",
              "state": [
                "expanded"
              ]
            },
            {
              "role": "Button",
              "name": "Edit",
              "state": [
                "collapsed"
              ]
            },
            {
              "role": "MenuItem",
              "name": "New",
              "state": [
                "focused"
              ]
            }
          ]
        },
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Escape closes it, choosing nothing: the screen reader's focus is back on its title",
      "do": [
        "key",
        1
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "absent": [
            "Open Recent"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "File",
              "state": [
                "collapsed",
                "focused"
              ]
            }
          ]
        },
        "texts": [
          "new documents: 0",
          "wrap lines: on"
        ],
        "react": {}
      }
    }
  ]
}
