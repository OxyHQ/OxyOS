{
  "about": "Settings › Contraseñas in Spanish (docs/adr/0050-keychain-autofill-and-passkeys.mdx, decision 3), over a played accounts' service whose account has no keychain: the account's password first; then turning the keychain on says plainly that Oxy cannot open it and nothing recovers it without a device or the recovery key, shows the recovery key once in eight groups of four, and asks for it back: one that is not it refused and said, the right one (as the service reads it: case and spaces ignored) turns it on and opens it, empty.",
  "module": "OxyOSSettings",
  "locale": "es_ES.UTF-8",
  "window": [
    1100,
    800
  ],
  "app": {
    "id": "so.oxy.settings",
    "title": "Settings"
  },
  "settings": {
    "app": "so.oxy.settings",
    "preferences": {
      "appearance": "dark",
      "accent": "oxy"
    }
  },
  "account": {
    "registered": [
      "so.oxy.settings"
    ],
    "keychain": {
      "state": "off",
      "vault": false,
      "password": "contraseña de prueba 1",
      "recovery_key": "7Q4M-2K9D-XH3B-PV8T-1NCW-6RJF-ZS5G-YA0E",
      "members": [
        {
          "memberId": "m-self",
          "name": "Portátil",
          "platform": "oxyos",
          "self": true,
          "orphaned": false
        }
      ]
    }
  },
  "steps": [
    {
      "name": "Contraseñas en la barra lateral",
      "do": [
        "wait",
        1500
      ],
      "expect": {
        "texts": [
          "Contraseñas"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "se abre tras la contraseña de la cuenta, aun sin llavero",
      "do": [
        "press_named",
        "Contraseñas"
      ],
      "expect": {
        "texts": [
          "Las contraseñas están bloqueadas",
          "Desbloquear"
        ],
        "absent": [
          "Llavero de Oxy"
        ],
        "account_session": [
          "so.oxy.settings keychainStatus: off"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "la contraseña",
      "do": [
        "type",
        "contraseña de prueba 1"
      ],
      "expect": {
        "account_session": [],
        "never": [
          "contraseña de prueba 1"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Desbloquear: ofrece activar el llavero, y dice que nada lo recupera sin un dispositivo o la clave",
      "do": [
        "press_named",
        "Desbloquear"
      ],
      "expect": {
        "texts": [
          "Llavero de Oxy",
          "Activar el llavero…",
          "Oxy no puede abrir tu llavero. Si pierdes el acceso a todos tus dispositivos y a esta clave de recuperación, tu llavero no se podrá recuperar."
        ],
        "account_session": [
          "so.oxy.settings keychainVerify: verified",
          "so.oxy.settings keychainStatus: off"
        ],
        "never": [
          "contraseña de prueba 1"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Activar: la clave de recuperación, una vez, en ocho grupos de cuatro",
      "do": [
        "press_named",
        "Activar el llavero…"
      ],
      "expect": {
        "texts": [
          "Tu clave de recuperación",
          "Anótala y guárdala en un lugar seguro. Solo se muestra una vez.",
          "Continuar",
          "Cancelar",
          "7Q4M",
          "2K9D",
          "XH3B",
          "PV8T",
          "1NCW",
          "6RJF",
          "ZS5G",
          "YA0E"
        ],
        "at": {
          "window": [
            {
              "role": "Dialog",
              "name": "Tu clave de recuperación"
            }
          ]
        },
        "account_session": [
          "so.oxy.settings keychainCreate: recoveryKey"
        ]
      }
    },
    {
      "name": "Continuar: hay que escribirla",
      "do": [
        "press_named",
        "Continuar"
      ],
      "expect": {
        "texts": [
          "Introduce tu clave de recuperación",
          "Activar"
        ],
        "absent": [
          "7Q4M"
        ],
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "una clave que no es la mostrada",
      "do": [
        "type",
        "AAAA-BBBB-CCCC-DDDD-EEEE-FFFF-GGGG-HHHH"
      ],
      "expect": {
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "Intro: rechazada y dicha",
      "do": [
        "key",
        28
      ],
      "expect": {
        "texts": [
          "No es la clave de recuperación que se mostró. Revísala y vuelve a intentarlo, o empieza de nuevo para obtener otra.",
          "Empezar de nuevo"
        ],
        "account_session": [
          "so.oxy.settings keychainConfirmRecoveryKey: recoveryKeyMismatch"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "todo seleccionado",
      "do": [
        "key",
        [
          29,
          30
        ]
      ],
      "expect": {
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "la clave anotada, en minúsculas y con espacios",
      "do": [
        "type",
        "7q4m 2k9d xh3b pv8t 1ncw 6rjf zs5g ya0e"
      ],
      "expect": {
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "Intro: el llavero activado, abierto y vacío",
      "do": [
        "key",
        28
      ],
      "expect": {
        "texts": [
          "Todas",
          "Contraseñas",
          "Llaves de acceso",
          "Códigos",
          "Wi-Fi",
          "Notas",
          "Seguridad",
          "Dispositivos",
          "Sin elementos",
          "Nueva contraseña"
        ],
        "absent": [
          "Introduce tu clave de recuperación",
          "7Q4M",
          "2K9D",
          "XH3B",
          "PV8T",
          "1NCW",
          "6RJF",
          "ZS5G",
          "YA0E"
        ],
        "account_session": [
          "so.oxy.settings keychainConfirmRecoveryKey: member",
          "so.oxy.settings keychainStatus: member",
          "so.oxy.settings keychainList: items",
          "so.oxy.settings keychainAudit: audit"
        ]
      }
    }
  ]
}
