        "react": {
          "blur@line": 1,
          "endEditing@line": 1,
          "focus@plain": 1,
          "selectionChange@plain": 1,
          "oxyosTextMenu@plain": 1
        },
        "at": {
          "popup": [
            {
              "role": "Menu",
              "name": "Menú contextual"
            },
            {
              "role": "MenuItem",
              "name": "Deshacer",
              "state": [
                "disabled",
                "focused"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Rehacer",
              "state": [
                "disabled"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Cortar"
            },
            {
              "role": "MenuItem",
              "name": "Copiar"
            },
            {
              "role": "MenuItem",
              "name": "Pegar"
            },
            {
              "role": "MenuItem",
              "name": "Seleccionar todo"
            }
          ]
        },
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1,
            "press": 1,
            "release": 1
          },
          "3": {
            "focus.in": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Escape closes it: nothing else happens, the selection kept",
      "do": [
        "key",
        1
      ],
      "expect": {
        "popups": 0,
        "focus_input": "plain",
        "texts": [
          "Plain: \"texto plano\" [6,11]"
        ],
        "react": {
          "key@text-field-menu": 1
        },
        "delivered": {
          "1": {
