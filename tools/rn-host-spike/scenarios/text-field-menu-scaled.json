{
  "about": "A text field's context menu (scenarios/text-field-menu.json) on a 1600x1000 display at 1.25 (ADR 0018): the same steps, its points in the window's logical pixels, drawn and hit at the output's scale.",
  "module": "TextMenuProbe",
  "window": [
    640,
    360
  ],
  "locale": "es_ES.UTF-8",
  "companion": {
    "module": "DropProbe",
    "window": [
      260,
      180
    ],
    "at": [
      1300,
      260
    ]
  },
  "final": {
    "focus_input": "line"
  },
  "steps": [
    {
      "name": "the window made active by a press on nothing in it: no field has focus",
      "do": [
        "press",
        [
          500,
          300
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "popups": 0,
        "react": {
          "touchStart@RootView#1": 1,
          "touchEnd@RootView#1": 1
        },
        "delivered": {
          "1": {
            "focus.in": 1,
            "enter": 1,
            "press": 1,
            "release": 1
          },
          "companion": {
            "focus.out": 1
          }
        }
      }
    },
    {
      "name": "a secondary click on \"mundo\" in the Bloom field, which has no focus: the field takes focus with the word selected, as on a Mac, and its context menu opens at the pointer in a popup, announced as a menu, Undo and Redo disabled (nothing to undo) and Paste too (the clipboard is empty)",
      "do": [
        "press_secondary",
        [
          95,
          42
        ]
      ],
      "expect": {
        "texts": [
          "Line: \"Hola mundo café\" [5,10]"
        ],
        "popups": 1,
        "focus_input": "line",
        "react": {
          "focus@line": 1,
          "selectionChange@line": 1,
          "oxyosTextMenu@line": 1
        },
        "at": {
          "popup": [
            {
              "role": "Menu",
              "name": "Menú contextual"
            },
            {
              "role": "MenuItem",
              "name": "Deshacer",
              "state": [
                "disabled",
                "focused"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Rehacer",
              "state": [
                "disabled"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Cortar"
            },
            {
              "role": "MenuItem",
              "name": "Copiar"
            },
            {
              "role": "MenuItem",
              "name": "Pegar",
              "state": [
                "disabled"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Seleccionar todo"
            }
          ]
        },
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1,
            "press": 1,
            "release": 1
          },
          "2": {
            "focus.in": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Down goes to the first row that applies, Cut, past the disabled ones",
      "do": [
        "key",
        108
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {
          "key@text-field-menu": 1
        },
        "at": {
          "popup": [
            {
              "role": "MenuItem",
              "name": "Cortar",
              "state": [
                "focused"
              ]
            }
          ]
        },
        "delivered": {
          "2": {
            "key.press": 1,
            "key.release": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Down again, Copy",
      "do": [
        "key",
        108
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {
          "key@text-field-menu": 1
        },
        "at": {
          "popup": [
            {
              "role": "MenuItem",
              "name": "Copiar",
              "state": [
                "focused"
              ]
            }
          ]
        },
        "delivered": {
          "2": {
            "key.press": 1,
            "key.release": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Return chooses it: the word is on the clipboard, the menu gone, and the field keeps its focus and selection, its text unchanged",
      "do": [
        "key",
        28
      ],
      "expect": {
        "popups": 0,
        "focus_input": "line",
        "texts": [
          "Line: \"Hola mundo café\" [5,10]"
        ],
        "react": {
          "key@text-field-menu": 1
        },
        "field": {
          "text": "Hola mundo café",
          "anchor": 5,
          "cursor": 10
        },
        "clipboard": {
          "text/plain;charset=utf-8": "mundo"
        },
        "delivered": {
          "1": {
            "enter": 1,
            "focus.in": 1
          },
          "2": {
            "focus.out": 1,
            "key.press": 1,
            "key.release": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "the keyboard is the field's again: a key replaces the selection",
      "do": [
        "type",
        "x"
      ],
      "expect": {
        "texts": [
          "Line: \"Hola x café\" [6,6]"
        ],
        "react": {
          "keyPress@line": 1,
          "change@line": 1,
          "selectionChange@line": 1
        },
        "delivered": {
          "1": {
            "text_input": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "a secondary click on \"plano\" in a plain React Native TextInput, which knows nothing of Bloom: the same menu, the line losing focus, Paste enabled now and Undo too",
