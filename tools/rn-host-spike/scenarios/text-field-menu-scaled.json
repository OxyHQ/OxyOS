            },
            {
              "role": "MenuItem",
              "name": "Pegar"
            },
            {
              "role": "MenuItem",
              "name": "Seleccionar todo"
            }
          ]
        },
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1,
            "press": 1,
            "release": 1
          },
          "4": {
            "focus.in": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Control released",
      "do": [
        "key_up",
        29
