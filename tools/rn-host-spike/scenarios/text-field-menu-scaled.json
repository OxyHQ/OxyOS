          },
          "3": {
            "focus.out": 1,
            "key.press": 1,
            "key.release": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Control held",
      "do": [
        "key_down",
        29
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {},
        "delivered": {
          "1": {
            "key.press": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "a Control-click within the selection is a secondary click, as on a Mac: the selection kept, no click, the menu",
      "do": [
        "press",
        [
          105,
          90
        ]
      ],
      "expect": {
        "popups": 1,
        "texts": [
          "Plain: \"texto plano\" [6,11]"
