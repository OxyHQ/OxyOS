    "keyboard_focus": {
     "target": "accent-blue",
     "ring": true,
     "color": "#00629d"
    },
    "at": {
     "window": [
      {
       "role": "Radio",
       "name": "Azul",
       "state": [
        "checked",
        "focused"
       ]
      },
      {
       "role": "Radio",
       "name": "Oxy",
       "state": []
      }
     ]
    },
    "spoken": [
     {
      "text": "Azul, seleccionado, botón de opción",
      "interrupting": true
     }
    ],
    "announcements": [],
    "preferences": {
     "accent": "blue"
    }
   }
  },
