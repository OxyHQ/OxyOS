{
  "about": "A first sign-in with the QR (docs/adr/0020-oxy-account-login.mdx, decision 4), against a played Oxy API and a played accounts' service (no credential of anyone's): at the first boot, no account on the computer, online, the login screen opens straight on the Oxy SDK's sign-in, its QR beside the focused field, and never on a device picker. A phone approves once: the session claimed once, the account put on the sign-in's device and its token taken by every request after (`POST /session/device/add`, `GET /users/me`, `GET /users/me/sign-in-methods`, as Oxy's API answers them), the credential handed to the host, and the account's password asked once more in the login screen's focused field. The account is set up with that credential and password and signs in. Nothing reaches any application at any step.",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 10000
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "first boot: setup, online, straight to the SDK's sign-in, never a device picker",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Add an Oxy Account"
          ],
          "absent": [
            "Choose an account",
            "Use another account"
          ]
        }
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves the QR: the session claimed, the account's password asked once more, its field focused",
      "do": [
        "wait",
        11000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "WS /auth-session auth_update 101",
          "GET /auth/session/status/{token} 200",
          "POST /auth/session/claim 200",
          "POST /session/device/add 200",
          "GET /users/me 200",
          "GET /users/me/sign-in-methods 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Enter Ada Lovelace's password",
            "OxyOS signs in with your Oxy account's password, even offline. Enter it once more."
          ],
          "absent": [
            "Scan with Commons to sign in",
            "Email or username",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "login-setup-password"
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 1,
          "POST /auth/session/create 200": 0
        }
      }
    },
    {
      "name": "the password: the account set up with the credential the QR's sign-in handed over",
      "do": [
        "keyboard",
        "played password 1\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: enrolled"
        ],
        "delivered": {},
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "texts": [
            "Ada Lovelace"
          ],
          "absent": [
            "Add an Oxy Account",
            "Enter Ada Lovelace's password",
            "Bea Ramos",
            "Choose an account",
            "Use another account"
          ],
          "never": [
            "played password 1"
          ]
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 0,
          "POST /auth/session/create 200": 0
        }
      }
    },
    {
      "name": "its password signs it in",
      "do": [
        "keyboard",
        "oxyos.correcta\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "oxyos.correcta",
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "oxyos.correcta",
            "played password 1"
          ]
        }
      }
    }
  ]
}
