{
  "about": "A first sign-in with the QR (docs/adr/0020-oxy-account-login.mdx, decision 4), against a played Oxy API and a played accounts' service (no credential of anyone's): at the first boot, no account on the computer, online, the login screen opens straight on the Oxy SDK's sign-in, its QR beside the focused field, and never on a device picker. A phone approves once: the session claimed once, the account put on the sign-in's device and its token taken by every request after (`POST /session/device/add`, `GET /users/me`, `GET /users/me/sign-in-methods`, as Oxy's API answers them), the credential handed to the host, and the account's password asked once more in the login screen's focused field. The account is set up with that credential and password and signs in. Nothing reaches any application at any step.",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 10000
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "first boot: the setup assistant's welcome, nothing asked of Oxy yet",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Welcome to OxyOS",
            "Sign in with your Oxy account to make this computer yours. It takes a minute.",
            "Get Started"
          ],
          "absent": [
            "Back",
            "Scan with Commons to sign in"
          ]
        }
      }
    },
    {
      "name": "Get Started pressed",
      "do": [
        "press_named",
        "Get Started"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Get Started: online, the SDK's sign-in, step 2 of 5, never a device picker",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [],
          "absent": [
            "Choose an account",
            "Use another account"
          ]
        }
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves the QR: the session claimed, a PIN for this computer asked, its field focused, no password asked or offered",
      "do": [
        "wait",
        11000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "WS /auth-session auth_update 101",
          "GET /auth/session/status/{token} 200",
          "POST /auth/session/claim 200",
          "POST /session/device/add 200",
          "GET /users/me 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Create a PIN",
            "You'll use it to sign in and unlock this computer, even offline. It stays here: Oxy never sees it."
          ],
          "absent": [
            "Choose an account",
            "Email or username",
            "Enter Ada Lovelace's password",
            "Not Now",
            "Scan with Commons to sign in",
            "Send code",
            "Set a password",
            "Use another account"
          ],
          "focus_input": "login-setup-pin-password"
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 1,
          "POST /auth/session/create 200": 0
        }
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter Your PIN Again"
          ],
          "absent": [
            "Enter Ada Lovelace's password",
            "Not Now",
            "Set a password",
            "Send code"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916"
          ]
        }
      }
    },
    {
      "name": "typed again: the look's page",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Choose Your Look",
            "Continue"
          ]
        },
        "never": [
          "482916"
        ]
      }
    },
    {
      "name": "Dark chosen",
      "do": [
        "press_named",
        "Dark"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Choose Your Look"
          ]
        }
      }
    },
    {
      "name": "Continue pressed",
      "do": [
        "press_named",
        "Continue"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "appearance: dark",
          "enroll: enrolled",
          "verifyPin: accepted"
        ]
      }
    },
    {
      "name": "Continue: the account set up with what was chosen, its stages shown, and signed in with it at once, never asked again",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "in_shell": {},
        "oxy_requests_times": {
          "POST /auth/session/create 200": 0
        }
      }
    }
  ]
}
