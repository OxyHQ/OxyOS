{
  "about": "An application's menus in the session's menu bar (ADR 0021, step 3): the sample (sample/MenuBarProbe.tsx, launched as Allo) declares, with Bloom's Menubar, File (New Mod+N, Open… Mod+O, a separator, an Open Recent submenu) and Edit (Undo Mod+Z, disabled; a separator; Wrap Lines, a check item). With the host adapter's `menu-bar` (sample/oxyos/platform-surface.js) Bloom draws nothing in the window and describes the menus to the platform; while the window is active the shell's top bar shows its application's own menu in bold (the registry's name), then File and Edit with their chords as Ctrl. Choosing New there runs it in the application exactly once (one MENU_ITEM_ACTIVATED from the compositor, one event to JavaScript, the page counting one document). Ctrl+N in the window, with a text field focused, runs it again without the bar: the adapter's `keyboard` offers the key to Bloom before the field, which takes it, and the field receives nothing; Ctrl+A stays the field's. Wrap Lines toggles from the bar and shows its check the next time Edit opens. Minimized, no window is active and the bar shows the shell's own menus; restored from the dock, the application's again. Without the adapter's `menuBar` and `keyboard` Bloom draws its bar in the window, the shell's bar is its own, and every step but the minimized one fails.",
  "module": "MenuBarProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.allo",
    "title": "Allo"
  },
  "steps": [
    {
      "name": "the window is active: the shell's bar shows its application's menu, then File and Edit; Bloom draws no bar in the window",
      "do": [
        "press",
        [
          300,
          300
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "new documents: 0",
          "wrap lines: off"
        ],
        "absent": [
          "File",
          "Edit"
        ],
        "in_shell": {
          "texts": [
            "Allo",
            "File",
            "Edit"
          ],
          "absent": [
            "Ver"
          ]
        },
        "react": {
          "touchStart@menu-probe": 1,
          "touchEnd@menu-probe": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    },
    {
      "name": "File opens under it with the application's commands and their chords, as Ctrl",
      "do": [
        "press_output",
        [
          100,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New",
            "Ctrl+N",
            "Open…",
            "Ctrl+O",
            "Open Recent"
          ]
        },
        "react": {},
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1
          }
        },
        "window_shown": true,
        "output_pixels": {
          "76,60": "#497cff",
          "80,60": "#ffffff",
          "343,60": "#ffffff",
          "347,60": "#4479ff",
          "200,33": "#ffffff",
          "200,139": "#ffffff",
          "200,101": "#dedfdf"
        }
      }
    },
    {
      "name": "choosing New runs it in the application, once",
      "do": [
        "press_output",
        [
          120,
          63
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "new documents: 1"
        ],
        "react": {
          "menuActivated@menu-bar": 1
        },
        "delivered": {
          "1": {
            "menu.activated": 1
          }
        }
      }
    },
    {
      "name": "File again",
      "do": [
        "press_output",
        [
          100,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "New",
            "Open Recent"
          ],
          "absent": [
            "notes.txt"
          ]
        },
        "react": {}
      }
    },
    {
      "name": "the pointer on Open Recent opens its submenu beside it",
      "do": [
        "move_output",
        [
          200,
          119
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "notes.txt"
          ]
        },
        "react": {},
        "output_pixels": {
          "100,119": "#e8e8e8",
          "346,119": "#4479ff",
          "350,119": "#ffffff",
          "611,125": "#ffffff",
          "616,125": "#4277fe",
          "400,104": "#4479ff",
          "400,107": "#ffffff",
          "400,146": "#ffffff"
        }
      }
    },
    {
      "name": "into the submenu: it stays open",
      "do": [
        "move_output",
        [
          400,
          125
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "notes.txt"
          ]
        },
        "react": {}
      }
    },
    {
      "name": "onto New: the submenu closes after its grace",
      "do": [
        "move_output",
        [
          200,
          53
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {}
      }
    },
    {
      "name": "after the grace, the submenu is gone",
      "do": [
        "wait",
        400
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "absent": [
            "notes.txt"
          ],
          "texts": [
            "New"
          ]
        },
        "react": {}
      }
    },
    {
      "name": "back on Open Recent, and notes.txt chosen in its submenu",
      "do": [
        "move_output",
        [
          200,
          119
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "notes.txt"
          ]
        },
        "react": {}
      }
    },
    {
      "name": "choosing notes.txt runs it in the application, once, and closes the menu",
      "do": [
        "press_output",
        [
          400,
          125
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "react": {
          "menuActivated@menu-bar": 1
        },
        "delivered": {
          "1": {
            "menu.activated": 1
          }
        },
        "in_shell": {
          "absent": [
            "notes.txt",
            "Open Recent"
          ]
        }
      }
    },
    {
      "name": "a press in the note field focuses it",
      "do": [
        "press",
        [
          100,
          90
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "focus_input": "note",
        "react": {
          "touchStart@note": 1,
          "touchEnd@note": 1,
          "focus@note": 1,
          "selectionChange@note": 1
        }
      }
    },
    {
      "name": "typing in it",
      "do": [
        "type",
        "hola"
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "hola"
        ]
      }
    },
    {
      "name": "Ctrl+N in the window runs New without the bar: Bloom takes it before the field, which receives nothing",
      "do": [
        "key",
        [
          29,
          49
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "new documents: 2",
          "hola"
        ],
        "absent": [
          "holan"
        ],
        "focus_input": "note",
        "react": {
          "shortcut@menu-bar": 1
        },
        "delivered": {
          "1": {
            "key.press": 2,
            "key.release": 2
          }
        }
      }
    },
    {
      "name": "Ctrl+A stays the field's: it selects its text, and nothing runs",
      "do": [
        "key",
        [
          29,
          30
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "new documents: 2",
          "hola"
        ],
        "react": {
          "selectionChange@note": 1
        },
        "delivered": {
          "1": {
            "key.press": 2,
            "key.release": 2
          }
        }
      }
    },
    {
      "name": "Edit: Undo disabled with its chord, Wrap Lines unchecked",
      "do": [
        "press_output",
        [
          137,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Undo",
            "Ctrl+Z",
            "Wrap Lines"
          ]
        },
        "output_pixels": {
          "141,90": "#ffffff"
        },
        "react": {},
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1
          }
        }
      }
    },
    {
      "name": "choosing Wrap Lines turns it on in the application",
      "do": [
        "press_output",
        [
          194,
          90
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "wrap lines: on",
          "new documents: 2"
        ],
        "react": {
          "menuActivated@menu-bar": 1
        },
        "delivered": {
          "1": {
            "menu.activated": 1
          }
        }
      }
    },
    {
      "name": "Edit again: the application committed its menus anew, and Wrap Lines is checked",
      "do": [
        "press_output",
        [
          137,
          14
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Wrap Lines"
          ]
        },
        "output_pixels": {
          "141,90": "#5c645f"
        },
        "pixel_tolerance": 16,
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "choosing it again turns it off",
      "do": [
        "press_output",
        [
          194,
          90
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "wrap lines: off",
          "new documents: 2"
        ],
        "react": {
          "menuActivated@menu-bar": 1
        },
        "delivered": {
          "1": {
            "menu.activated": 1
          }
        }
      }
    },
    {
      "name": "minimized, no window is active: the bar shows the shell's own menus",
      "do": [
        "minimize_window",
        true
      ],
      "allow_unchanged": true,
      "expect": {
        "window_shown": false,
        "in_shell": {
          "texts": [
            "OxyOS",
            "Ver"
          ],
          "absent": [
            "File",
            "Edit"
          ]
        },
        "react": {}
      }
    },
    {
      "name": "restored from the dock (its Allo button, wherever the installed applications put it), its menus are the bar's again",
      "do": [
        "a11y-action",
        [
          "activate",
          "Abrir Allo"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "window_shown": true,
        "in_shell": {
          "texts": [
            "Allo",
            "File",
            "Edit"
          ],
          "absent": [
            "Ver"
          ]
        },
        "texts": [
          "new documents: 2",
          "wrap lines: off"
        ],
        "react": {}
      }
    }
  ]
}
