{
  "about": "Editing keys in Bloom fields (sample/EditingProbe.tsx), each step checking where the text and selection end up as the application receives them, and exactly which events it received: by word with Ctrl (ICU's word boundaries, as Android), deletion by word, undo and redo (one step for continued typing), and in a multiline field Up and Down keeping their column, Home and End at the line's edges, Ctrl+Home and Ctrl+End at the text's, a selection across lines, a wrapped line's edges as drawn, and a press on the line it wraps onto; and text taller or wider than its field scrolled to keep the caret in view (Page Up and Page Down by what the field shows), presses landing where the scrolled text is drawn; the wheel scrolls a field's text, focused or not, before the scroll views around it; and every scroll of a field's text is an onScroll event, as Android's.",
  "module": "EditingProbe",
  "window": [
    800,
    480
  ],
  "steps": [
    {
      "name": "focus the line",
      "do": [
        "press",
        [
          400,
          42
        ]
      ],
      "expect": {
        "texts": [
          "Line: \"\" [0,0]"
        ],
        "react": {
          "touchStart@line": 1,
          "touchEnd@line": 1,
          "focus@line": 1,
          "selectionChange@line": 1
        },
        "focus_input": "line"
      }
    },
    {
      "name": "type three words",
      "do": [
        "type",
        "hola mundo bonito"
      ],
      "expect": {
        "texts": [
          "Line: \"hola mundo bonito\" [17,17]"
        ],
        "react": {
          "change@line": 1,
          "selectionChange@line": 1
        }
      }
    },
    {
      "name": "Ctrl+Left goes to the start of the last word",
      "do": [
        "key",
        [
          29,
          105
        ]
      ],
      "expect": {
        "texts": [
          "Line: \"hola mundo bonito\" [11,11]"
        ],
        "react": {
          "selectionChange@line": 1
        }
      }
    },
    {
      "name": "again, to the start of the word before",
      "do": [
        "key",
        [
          29,
          105
        ]
      ],
      "expect": {
        "texts": [
          "Line: \"hola mundo bonito\" [5,5]"
        ],
        "react": {
          "selectionChange@line": 1
        }
      }
    },
    {
      "name": "Ctrl+Right goes to the end of the word",
      "do": [
        "key",
        [
          29,
          106
        ]
      ],
      "expect": {
        "texts": [
          "Line: \"hola mundo bonito\" [10,10]"
        ],
        "react": {
          "selectionChange@line": 1
        }
      }
    },
    {
      "name": "Ctrl+Shift+Right selects to the end of the next word",
      "do": [
        "key",
        [
          29,
          42,
          106
        ]
      ],
      "expect": {
        "texts": [
