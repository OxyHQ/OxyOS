{
 "about": "Reset Network Settings (docs/adr/0038-networks.mdx, 8 November 2026), as an iPhone's, on Settings' Network page, over a NetworkManager played on the run's own bus that refuses changes to connections for every user: LukeSkyRouter (joined) and Vecinos, this person's own, Oficina for every user, a VPN of the person's, an Ethernet configuration someone made and the daemon's own automatic one. The confirmation names what goes (the two networks and the VPN, with their passwords) and what is kept and why (Oficina, an administrator's; Ethernet's), never the daemon's own; cancelled, nothing changes; confirmed, the daemon keeps only those, and Wi-Fi knows Oficina alone. At 1.",
 "locale": "en_US.UTF-8",
 "module": "OxyOSSettings",
 "window": [
  900,
  640
 ],
 "shell": "OxyOSShell",
 "app": {
  "id": "so.oxy.settings",
  "title": "Settings"
 },
 "grants": {
  "so.oxy.settings": [
   "settings",
   "network"
  ]
 },
 "controls": {
  "output_volume": 0.5,
  "output_muted": false,
  "input_volume": 1,
  "input_muted": false,
  "display_brightness": 0.75,
  "battery": "discharging",
  "battery_percent": 64,
  "battery_minutes": 200,
  "on_ac": false,
  "wifi": "connected",
  "wifi_signal": 73,
  "ssid": "LukeSkyRouter",
  "wired": false,
  "bluetooth": "on",
  "bluetooth_connected": 1
 },
 "network": {
  "access_points": [
   {
    "ssid": "LukeSkyRouter",
    "strength": 73,
    "security": "wpa",
    "password": "correct horse"
   },
   {
    "ssid": "Vecinos",
    "strength": 30,
    "security": "wpa",
    "password": "hunter22!"
   },
   {
    "ssid": "Oficina",
    "strength": 45,
    "security": "wpa",
    "password": "office pass"
   }
  ],
  "connections": [
   {
    "ssid": "LukeSkyRouter",
    "password": "correct horse",
    "permissions": [
     "user:someone:"
    ]
   },
   {
    "ssid": "Vecinos",
    "password": "hunter22!",
    "permissions": [
     "user:someone:"
    ]
   },
   {
    "ssid": "Oficina",
    "password": "office pass"
   },
   {
    "type": "vpn",
    "name": "Work VPN",
    "permissions": [
     "user:someone:"
    ]
   },
   {
    "type": "ethernet",
    "name": "Office static"
   },
   {
    "type": "ethernet",
    "name": "Wired connection 1",
    "flags": 2
   }
  ],
  "active": "LukeSkyRouter",
  "ethernet": "unplugged",
  "deny_system": true
 },
 "secrets": [
  "correct horse",
  "hunter22!"
 ],
 "steps": [
  {
   "name": "Settings with the network grant: its pages there once the session told it the network",
   "do": [
    "wait",
    2000
   ],
   "allow_unchanged": true,
   "expect": {
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Network"
      }
     ]
    }
   }
  },
  {
   "name": "Network",
   "do": [
    "press_named",
    "Network"
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "touchStart@settings-nav-network": 1,
     "touchEnd@settings-nav-network": 1
    }
   }
  },
  {
   "name": "Network's page",
   "do": [
    "wait_named",
    [
     "Reset Network Settings…",
     10000
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "texts": [
     "Ethernet",
     "Reset Network Settings…"
    ],
    "react": {}
   }
  },
  {
   "name": "Reset Network Settings…: Settings asks what would go, which changes nothing",
   "do": [
    "press_named",
    "Reset Network Settings…"
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "touchStart@network-reset": 1,
     "touchEnd@network-reset": 1,
     "show@settings-page": 1
    }
   }
  },
  {
   "name": "The confirmation lists what goes, with their passwords, and what is kept and why",
   "do": [
    "wait_named",
    [
     "Reset",
     5000
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "texts": [
     "Reset network settings?",
     "These are removed, with their passwords:",
     "Wi-Fi: LukeSkyRouter, Vecinos",
     "VPN: Work VPN",
     "Kept, as only an administrator can remove them: Oficina.",
     "Kept: Office static, the Ethernet configuration"
    ],
    "absent": [
     "Wired connection 1"
    ],
    "network": {
     "connections": [
      {
       "name": "LukeSkyRouter"
      },
      {
       "name": "Vecinos"
      },
      {
       "name": "Oficina"
      },
      {
       "name": "Work VPN"
      },
      {
       "name": "Office static"
      },
      {
       "name": "Wired connection 1"
      }
     ]
    },
    "react": {}
   }
  },
  {
   "name": "Cancelled",
   "do": [
    "press_named",
    "Cancel"
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "touchStart@bloom-dialog-frame-content": 1,
     "touchEnd@bloom-dialog-frame-content": 1
    }
   }
  },
  {
   "name": "Nothing removed",
   "do": [
    "wait",
    800
   ],
   "allow_unchanged": true,
   "expect": {
    "network": {
     "connections": [
      {
       "name": "LukeSkyRouter"
      },
      {
       "name": "Vecinos"
      },
      {
       "name": "Oficina"
      },
      {
       "name": "Work VPN"
      },
      {
       "name": "Office static"
      },
      {
       "name": "Wired connection 1"
      }
     ],
     "active": "LukeSkyRouter"
    },
    "react": {}
   }
  },
  {
   "name": "Again",
   "do": [
    "press_named",
    "Reset Network Settings…"
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "touchStart@network-reset": 1,
     "touchEnd@network-reset": 1,
     "show@settings-page": 1
    }
   }
  },
  {
   "name": "The confirmation",
   "do": [
    "wait_named",
    [
     "Reset",
     5000
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {}
   }
  },
  {
   "name": "Reset",
   "do": [
    "press_named",
    "Reset"
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "touchStart@bloom-dialog-frame-content": 1,
     "touchEnd@bloom-dialog-frame-content": 1,
     "show@settings-page": 1
    }
   }
  },
  {
   "name": "Reset: said; the daemon keeps only the administrator's network, Ethernet's configuration and its own, no password of the person's; the computer left the network",
   "do": [
    "wait_named",
    [
     "Network settings were reset.",
     5000
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "network": {
     "connections": [
      {
       "name": "Oficina",
       "psk": "office pass"
      },
      {
       "name": "Office static"
      },
      {
       "name": "Wired connection 1"
      }
     ],
     "active": null
    },
    "react": {}
   }
  },
  {
   "name": "OK",
   "do": [
    "press_named",
    "OK"
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "touchStart@bloom-dialog-frame-content": 1,
     "touchEnd@bloom-dialog-frame-content": 1
    }
   }
  },
  {
   "name": "Wi-Fi",
   "do": [
    "press_named",
    {
     "role": "ListItem",
     "name": "Wi-Fi"
    }
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "touchStart@settings-nav-wifi": 1,
     "touchEnd@settings-nav-wifi": 1
    }
   }
  },
  {
   "name": "Oficina alone is known",
   "do": [
    "wait_named",
    [
     "More for “Oficina”",
     10000
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "texts": [
     "Known Networks",
     "Oficina"
    ],
    "at_absent": {
     "window": [
      {
       "name": "More for “Vecinos”"
      },
      {
       "name": "More for “LukeSkyRouter”"
      }
     ]
    },
    "react": {}
   }
  }
 ]
}
