{
  "about": "Safe Mode (docs/adr/0054-recovery-and-erasing.mdx, decision 10) in Spanish at scale 1.25 (the ThinkPad's panel): the same as safe-mode.json. The menu bar shows Modo seguro in red for the whole session; nothing opens at login (Settings' window alone) though Ítems de inicio y extensiones still lists Inbox; Chat's background activity is not permitted, nobody is told, and closed it ends; the preferences file is unchanged.",
  "locale": "es_ES.UTF-8",
  "module": "OxyOSSettings",
  "window": [
    900,
    640
  ],
  "outputs": "1600x1000@1.25",
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.settings",
    "title": "Settings"
  },
  "safe_mode": true,
  "grants": {
    "so.oxy.settings": [
      "settings",
      "updates",
      "privacy"
    ]
  },
  "settings": {
    "app": "so.oxy.settings",
    "preferences": {
      "dock": "so.oxy.backgroundprobe",
      "open_at_login": "so.oxy.inbox"
    }
  },
  "installd": {
    "publish": [
      "so.oxy.backgroundprobe"
    ],
    "installed": [
      "so.oxy.backgroundprobe"
    ]
  },
  "applications_launched": [
    {
      "id": "so.oxy.backgroundprobe",
      "origin": "installed 1",
      "settings": false
    }
  ],
  "steps": [
    {
      "name": "Modo seguro in the menu bar, in red, for the screen reader too; nothing opened at login: Settings' window alone",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Modo seguro"
          ]
        },
        "at": {
          "shell": [
            {
              "role": "Text",
              "name": "Modo seguro"
            }
          ]
        },
        "window_states": {
          "1": {
            "app": "so.oxy.settings"
          }
        },
        "notifications": [],
        "background": {
          "running": []
        }
      }
    },
    {
      "name": "Ítems de inicio y extensiones: Inbox is still the person's, though Safe Mode opened it not",
      "do": [
        "a11y-action",
        [
          "activate",
          "Ítems de inicio y extensiones"
        ]
      ],
      "expect": {
        "texts": [
          "Abrir al iniciar sesión",
          "Inbox",
          "Actividad de las apps en segundo plano",
          "Ninguna app realiza tareas en segundo plano."
        ],
        "absent": [
          "Ningún ítem"
        ],
        "keyboard_focus": null,
        "notifications": [],
        "background": {
          "running": []
        }
      }
    },
    {
      "name": "Chat, pressed in the dock: the session opens the installed application",
      "do": [
        "press_named",
        "Chat"
      ],
      "expect": {
        "notifications": []
      }
    },
    {
      "name": "Chat asks how its items stand: its login item may be registered, its background activity is not permitted",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_launched": {
          "texts": [
            "Login item: notRegistered",
            "Background: notPermitted",
            "State: active"
          ]
        },
        "notifications": []
      }
    },
    {
      "name": "Run in Background",
      "do": [
        "press_named",
        "Run in Background"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Refused, not permitted in Safe Mode: nothing asked of the install service, nobody told, Settings lists nothing",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_launched": {
          "texts": [
            "Background: notPermitted",
            "Failure: notPermitted"
          ]
        },
        "texts": [
          "Ninguna app realiza tareas en segundo plano."
        ],
        "notifications": [],
        "background": {
          "running": []
        }
      }
    },
    {
      "name": "Super+W closes Chat's window: it does not run on in the background",
      "do": [
        "key",
        [
          125,
          17
        ]
      ],
      "expect": {}
    },
    {
      "name": "Nothing in the background; Safe Mode still in the menu bar",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Modo seguro"
          ]
        },
        "texts": [
          "Ninguna app realiza tareas en segundo plano."
        ],
        "notifications": [],
        "background": {
          "running": []
        }
      }
    }
  ],
  "final": {
    "preferences_file": {
      "open_at_login": "so.oxy.inbox",
      "dock": "so.oxy.backgroundprobe"
    }
  }
}
