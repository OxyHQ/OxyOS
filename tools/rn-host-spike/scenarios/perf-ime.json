{
  "about": "An input method composing, for the gate's timing phase and perf.py's desktop (docs/performance.mdx, docs/desktop-interaction-coverage.mdx): ImeProbe's line focused with the development compositor's input method (`input_method`, ADR 0008), n i h o n composed a key at a time, then Return committing it. Each key is the session's path: the key to the compositor, its input method's transaction to the field, the host drawing the composition. Each step holds what it does (the composition React holds and draws, the transaction, the field the compositor holds without it) and how fast: from the key to the composition drawn (`latency_ms`, the compositor's measure, the whole path) and the host's input to present for the transaction (`diagnostics`' `latency_max_ms`).",
  "module": "ImeProbe",
  "window": [
    800,
    480
  ],
  "input_method": true,
  "steps": [
    {
      "name": "focus the line: the input method is told of the field",
      "do": [
        "press",
        [
          400,
          42
        ]
      ],
      "expect": {
        "focus_input": "line",
        "react": {
          "touchStart@line": 1,
          "touchEnd@line": 1,
          "focus@line": 1,
          "selectionChange@line": 1
        },
        "im": {
          "active": true,
          "purpose": "Normal",
          "hints": 0,
          "text": "",
          "anchor": 0,
          "cursor": 0
        }
      }
    },
    {
      "name": "'n' composed: the composition drawn with it, no key reaching the field but as the input method's transaction",
      "do": [
        "compose_keys",
        "n"
      ],
      "expect": {
        "texts": [
          "Line: \"n\" [1,1]"
        ],
        "react": {
          "keyPress@line": 1,
          "change@line": 1,
          "selectionChange@line": 1
        },
        "delivered": {
          "1": {
            "text_input": 1
          }
        },
        "im": {
          "keys": 2,
          "given_back": 0,
          "text": "",
          "cursor": 0
        },
        "field": {
          "text": "",
          "cursor": 0
        },
        "latency_ms": 30,
        "diagnostics": {
          "latency_max_ms": 5,
          "timed_inputs_min": 1
        },
        "frame_work": {
          "compose_refreshes_p95": 1.0,
          "host_refreshes_p95": 1.0
        }
      }
    },
    {
      "name": "'i' composed: the composition drawn with it, no key reaching the field but as the input method's transaction",
      "do": [
        "compose_keys",
        "i"
      ],
      "expect": {
        "texts": [
          "Line: \"ni\" [2,2]"
        ],
        "react": {
          "keyPress@line": 1,
          "change@line": 1,
          "selectionChange@line": 1
        },
        "delivered": {
          "1": {
            "text_input": 1
          }
        },
        "im": {
          "keys": 2,
          "given_back": 0,
          "text": "",
          "cursor": 0
        },
        "field": {
          "text": "",
          "cursor": 0
        },
        "latency_ms": 30,
        "diagnostics": {
          "latency_max_ms": 5,
          "timed_inputs_min": 1
        },
        "frame_work": {
          "compose_refreshes_p95": 1.0,
          "host_refreshes_p95": 1.0
        }
      }
    },
    {
      "name": "'h' composed: the composition drawn with it, no key reaching the field but as the input method's transaction",
      "do": [
        "compose_keys",
        "h"
      ],
      "expect": {
        "texts": [
          "Line: \"nih\" [3,3]"
        ],
        "react": {
          "keyPress@line": 1,
          "change@line": 1,
          "selectionChange@line": 1
        },
        "delivered": {
          "1": {
            "text_input": 1
          }
        },
        "im": {
          "keys": 2,
          "given_back": 0,
          "text": "",
          "cursor": 0
        },
        "field": {
          "text": "",
          "cursor": 0
        },
        "latency_ms": 30,
        "diagnostics": {
          "latency_max_ms": 5,
          "timed_inputs_min": 1
        },
        "frame_work": {
          "compose_refreshes_p95": 1.0,
          "host_refreshes_p95": 1.0
        }
      }
    },
    {
      "name": "'o' composed: the composition drawn with it, no key reaching the field but as the input method's transaction",
      "do": [
        "compose_keys",
        "o"
      ],
      "expect": {
        "texts": [
          "Line: \"niho\" [4,4]"
        ],
        "react": {
          "keyPress@line": 1,
          "change@line": 1,
          "selectionChange@line": 1
        },
        "delivered": {
          "1": {
            "text_input": 1
          }
        },
        "im": {
          "keys": 2,
          "given_back": 0,
          "text": "",
          "cursor": 0
        },
        "field": {
          "text": "",
          "cursor": 0
        },
        "latency_ms": 30,
        "diagnostics": {
          "latency_max_ms": 5,
          "timed_inputs_min": 1
        },
        "frame_work": {
          "compose_refreshes_p95": 1.0,
          "host_refreshes_p95": 1.0
        }
      }
    },
    {
      "name": "'n' composed: the composition drawn with it, no key reaching the field but as the input method's transaction",
      "do": [
        "compose_keys",
        "n"
      ],
      "expect": {
        "texts": [
          "Line: \"nihon\" [5,5]"
        ],
        "react": {
          "keyPress@line": 1,
          "change@line": 1,
          "selectionChange@line": 1
        },
        "delivered": {
          "1": {
            "text_input": 1
          }
        },
        "im": {
          "keys": 2,
          "given_back": 0,
          "text": "",
          "cursor": 0
        },
        "field": {
          "text": "",
          "cursor": 0
        },
        "latency_ms": 30,
        "diagnostics": {
          "latency_max_ms": 5,
          "timed_inputs_min": 1
        },
        "frame_work": {
          "compose_refreshes_p95": 1.0,
          "host_refreshes_p95": 1.0
        }
      }
    },
    {
      "name": "Return commits it: the text the field's, drawn the same",
      "do": [
        "compose_keys",
        "\n"
      ],
      "expect": {
        "texts": [
          "Line: \"nihon\" [5,5]"
        ],
        "react": {},
        "delivered": {
          "1": {
            "text_input": 1
          }
        },
        "im": {
          "keys": 2,
          "given_back": 0,
          "text": "nihon",
          "cursor": 5
        },
        "field": {
          "text": "nihon",
          "cursor": 5
        },
        "latency_ms": 30,
        "frame_work": {
          "compose_refreshes_p95": 1.0,
          "host_refreshes_p95": 1.0
        }
      }
    }
  ]
}
