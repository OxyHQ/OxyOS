{
  "about": "React Native's Modal and its animationType on OxyOS (sample/ModalProbe.tsx, modal.h), as Android's window animations for it (React Native's catalyst_slide_up, _slide_down, _fade_in and _fade_out, 200 ms): a slide moves the modal's window up from below the window and back down, a fade fades it in and out, each monotonically from where it starts to where it ends over several frames, and `none` shows and closes it in one frame. Closing by its own button and by Escape (onRequestClose); a modal closing is drawn from its last frame while it animates out. Each step checks the texts, exactly what React received, the animations reported and the page or the modal at the end.",
  "module": "ModalProbe",
  "window": [
    400,
    300
  ],
  "steps": [
    {
      "name": "Open slide shows the slide modal, told it is shown, its window animating in (slide)",
      "do": [
        "press",
        [
          80,
          40
        ]
      ],
      "expect": {
        "texts": [
          "The slide modal"
        ],
        "react": {
          "touchStart@open-slide": 1,
          "touchEnd@open-slide": 1,
          "show@slide-modal": 1
        },
        "modal_animations": [
          "in slide@slide-modal"
        ],
        "window_frames": [
          6,
          1000
        ],
        "pixels": {
          "300,250": "#ffffff",
          "300,20": "#ffffff"
        }
      }
    },
    {
      "name": "its Close button closes it, its window animating out (slide) from its last frame",
      "do": [
        "press",
        [
          80,
          40
        ]
      ],
      "expect": {
        "absent": [
          "The slide modal"
        ],
        "react": {
          "touchStart@close-slide": 1,
          "touchEnd@close-slide": 1
        },
        "modal_animations": [
          "out slide@slide-modal"
        ],
        "window_frames": [
          6,
          1000
        ],
        "pixels": {
          "300,250": "#e0e0e0",
          "300,20": "#e0e0e0"
        }
      }
    },
    {
      "name": "Open fade shows the fade modal, told it is shown, its window animating in (fade)",
      "do": [
        "press",
        [
          80,
          100
        ]
      ],
      "expect": {
        "texts": [
          "The fade modal"
        ],
        "react": {
          "touchStart@open-fade": 1,
          "touchEnd@open-fade": 1,
          "show@fade-modal": 1
        },
        "modal_animations": [
          "in fade@fade-modal"
        ],
        "window_frames": [
          6,
          1000
        ],
        "pixels": {
          "300,250": "#ffffff",
          "300,20": "#ffffff"
        }
      }
    },
    {
      "name": "Escape, the desktop back, closes it, its window animating out (fade) from its last frame",
      "do": [
        "key",
        1
      ],
      "expect": {
        "absent": [
          "The fade modal"
        ],
        "react": {
          "requestClose@fade-modal": 1
        },
        "modal_animations": [
          "out fade@fade-modal"
        ],
        "window_frames": [
          6,
          1000
        ],
        "pixels": {
          "300,250": "#e0e0e0",
          "300,20": "#e0e0e0"
        }
      }
    },
    {
      "name": "Open none shows the none modal, told it is shown, at once",
      "do": [
        "press",
        [
          80,
          160
        ]
      ],
      "expect": {
        "texts": [
          "The none modal"
        ],
        "react": {
          "touchStart@open-none": 1,
          "touchEnd@open-none": 1,
          "show@none-modal": 1
        },
        "modal_animations": [],
        "window_frames": [
          1,
          3
        ],
        "pixels": {
          "300,250": "#ffffff",
          "300,20": "#ffffff"
        }
      }
    },
    {
      "name": "Escape, the desktop back, closes it, at once",
      "do": [
        "key",
        1
      ],
      "expect": {
        "absent": [
          "The none modal"
        ],
        "react": {
          "requestClose@none-modal": 1
        },
        "modal_animations": [],
        "window_frames": [
          1,
          3
        ],
        "pixels": {
          "300,250": "#e0e0e0",
          "300,20": "#e0e0e0"
        }
      }
    }
  ]
}
