      "do": [
        "press",
        [
          741,
          130
        ]
      ],
      "expect": {
        "react": {
          "touchStart@item-Downloads": 1,
          "touchEnd@item-Downloads": 1
        },
        "react_presses": {
          "pointerDown@item-Downloads": 1,
          "pointerUp@item-Downloads": 1
