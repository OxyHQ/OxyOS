{
  "module": "StoreProbe",
  "window": [
    520,
    320
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.storeprobe",
    "title": "Store"
  },
  "grants": {
    "so.oxy.storeprobe": [
      "store",
      "updates"
    ]
  },
  "about": "Installing from the store through the system's sheet (docs/adr/0030-installing-applications.mdx, decisions 5, 7 and 9), with a real oxyos-installd (its development mode) and a repository where oxyos-pack published Inbox's package as the store would. The store asks and waits; the shell shows the sheet; Cancelar installs nothing; Instalar installs it (fetched, compiled on the machine, the account's entry written, progress told); the store opens the installed version, given no system grant. At 1.25 on the ThinkPad's display (1600x1000).",
  "installd": {
    "publish": [
      "so.oxy.inbox"
    ]
  },
  "applications_launched": [
    {
      "id": "so.oxy.inbox",
      "origin": "installed 1",
      "settings": false
    }
  ],
  "installd_final": {
    "packages": {
      "so.oxy.inbox": [
        1
      ]
    }
  },
  "steps": [
    {
      "name": "Install, pressed in the store: it waits, the shell shows the sheet",
      "do": [
        "press",
        [
          90,
          40
        ]
      ],
      "expect": {
        "texts": [
          "Asked: 1",
          "Answer 0: none yet"
        ]
      }
    },
    {
      "name": "Cancelar in the shell's sheet: nothing installed",
      "do": [
        "press_output",
        [
          622,
          471
        ]
      ],
      "expect": {
        "in_shell": {
          "react": {
            "touchStart@system-sheet-refuse": 1,
            "touchEnd@system-sheet-refuse": 1
          }
        }
      }
    },
    {
      "name": "Install again: the first was cancelled",
      "do": [
        "press",
        [
          90,
          40
        ]
      ],
      "expect": {
        "texts": [
          "Install: cancelled · Uninstall: - · Open: -",
          "Asked: 2"
        ]
      }
    },
    {
      "name": "Instalar in the shell's sheet",
      "do": [
        "press_output",
        [
          750,
          471
        ]
      ],
      "expect": {
        "in_shell": {
          "react": {
            "touchStart@system-sheet-accept": 1,
            "touchEnd@system-sheet-accept": 1
          }
        }
      }
    },
    {
      "name": "Status: installed, version 1, its progress told",
      "do": [
        "press",
        [
          410,
          90
        ]
      ],
      "expect": {
        "texts": [
          "Install: installed v1 · Uninstall: - · Open: -",
          "Asked: 3"
        ]
      }
    },
    {
      "name": "Open: the session launches the installed version",
      "do": [
        "press",
        [
          410,
          40
        ]
      ],
      "expect": {
        "texts": [
          "Asked: 4"
        ]
      }
    }
  ],
  "outputs": "1600x1000@1.25"
}
