{
  "about": "dropsea-svg.json on the ThinkPad's display (1600x1000 at 1.25, ADR 0018), the window at 160,75 of the output: the drawing rasterised at the thumbnail's size in the output's pixels, the same events and tree, each told once; its pixels read in the output's own.",
  "module": "Dropsea",
  "window": [
    1024,
    680
  ],
  "app": {
    "id": "so.oxy.dropsea",
    "title": "Dropsea"
  },
  "home": {
    "items": {
      "drawing.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 48\"><rect width=\"64\" height=\"48\" fill=\"#3a7bd5\"/><circle cx=\"32\" cy=\"24\" r=\"14\" fill=\"#ffd60a\"/></svg>",
      "broken.svg": "<svg xmlns='http://www.w3.org/2000/svg'><rect",
      "notes.txt": "hello"
    }
  },
  "steps": [
    {
      "name": "every item has its icon: the drawing's is the drawing (its blue field, its yellow disc), the malformed SVG's an image's page",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "drawing.svg",
          "broken.svg",
          "notes.txt",
          "3 items"
        ],
        "output_pixels": {
          "622,181": "#3a7bd5",
          "656,207": "#ffd60a",
          "520,200": "#ffffff",
          "796,200": "#ffffff"
        }
      }
    },
    {
      "name": "As List: both SVG files asked of the platform again, the drawing loaded and the malformed one's error told, each once",
      "do": [
        "a11y-action",
        [
          "activate",
          "as List"
        ]
      ],
      "expect": {
        "react": {
          "loadStart@thumbnail-drawing.svg": 1,
          "load@thumbnail-drawing.svg": 1,
          "loadEnd@thumbnail-drawing.svg": 1,
          "loadStart@thumbnail-broken.svg": 1,
          "error@thumbnail-broken.svg": 1,
          "loadEnd@thumbnail-broken.svg": 1,
          "click@view-list": 1
        },
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "as List",
              "state": [
                "selected"
              ]
            }
          ]
        },
        "texts": [
          "Kind",
          "3 items"
        ]
      }
    },
    {
      "name": "As Icons again: the same icons, the drawing's own pixels",
      "do": [
        "a11y-action",
        [
          "activate",
          "as Icons"
        ]
      ],
      "expect": {
        "react": {
          "loadStart@thumbnail-drawing.svg": 1,
          "load@thumbnail-drawing.svg": 1,
          "loadEnd@thumbnail-drawing.svg": 1,
          "loadStart@thumbnail-broken.svg": 1,
          "error@thumbnail-broken.svg": 1,
          "loadEnd@thumbnail-broken.svg": 1,
          "click@view-icons": 1
        },
        "output_pixels": {
          "622,181": "#3a7bd5",
          "656,207": "#ffd60a",
          "520,200": "#ffffff"
        }
      }
    }
  ],
  "outputs": "1600x1000@1.25"
}
