{
  "about": "Window tiling, as macOS 15's (docs/adr/0016-windows.mdx, decision 12): WindowProbe dragged by its title area (a held `grab_hold`) to the display's edges shows the tile it would take beneath it before the release (`tile_preview`, exact), and takes it once released, told its new size once (`window_configures`); the menu bar fills, the left and right edges are the halves, their ends and the top edge's the quarters, the bottom edge's middle (the dock's) nothing; with Alt held, a tile anywhere; dragged away, a tiled window takes back its size. Super+Alt with an arrow, F, C and R tile, fill, centre and return it, the keyboard staying in the window and no key reaching it (the window's own line saying it is active is read where it is wide enough for Bloom's settings layout to show that page beside its sidebar). At 1.25 (1600 × 1000, 1280 × 800 logical) with the shell's menu bar and dock: the work area between them.",
  "module": "WindowProbe",
  "window": [
    900,
    600
  ],
  "shell": "OxyOSShell",
  "outputs": "1600x1000@1.25",
  "steps": [
    {
      "name": "The window is the active one",
      "do": [
        "press",
        [
          600,
          300
        ]
      ],
      "expect": {
        "window_rect": [
          190,
          86,
          900,
          600
        ],
        "focus_surface": 1,
        "texts": [
          "active yes, zoomed no, full screen no"
        ],
        "tile_preview": null,
        "window_configures": 0
      },
      "allow_unchanged": true
    },
    {
      "name": "Grabbed by its title area and dragged to the left edge, held: the left half previewed beneath it, the window as it was and told nothing",
      "do": [
        "grab_hold",
        [
          150,
          30,
          -340,
          244
        ]
      ],
      "expect": {
        "tile_preview": [
          8,
          36,
          628,
          700
        ],
        "window_rect": [
          -150,
          330,
          900,
          600
        ],
        "window_configures": 0
      }
    },
    {
      "name": "Released there: the window takes the left half, told its size once; still the active window",
      "do": [
        "release_output",
        [
          0,
          360
        ]
      ],
      "expect": {
        "tile_preview": null,
        "window_rect": [
          8,
          36,
          628,
          700
        ],
        "window_configures": 1,
        "focus_surface": 1
      }
    },
    {
      "name": "Dragged away from its tile, held: its own size again under the pointer, told once; no tile in the middle of the display",
      "do": [
        "grab_hold",
        [
          150,
          30,
          300,
          200
        ]
      ],
      "expect": {
        "tile_preview": null,
        "window_configures": 1
      }
    },
    {
      "name": "To the top edge (over the menu bar): Fill previewed",
      "do": [
        "move_output",
        [
          640,
          10
        ]
      ],
      "expect": {
        "tile_preview": [
          8,
          36,
          1264,
          700
        ],
        "window_configures": 0
      }
    },
    {
      "name": "At the top edge's left end: the top-left quarter previewed",
      "do": [
        "move_output",
        [
          100,
          10
        ]
      ],
      "expect": {
        "tile_preview": [
          8,
          36,
          628,
          346
        ],
        "window_configures": 0
      }
    },
    {
      "name": "Back to the middle: nothing previewed",
      "do": [
        "move_output",
        [
          640,
          360
        ]
      ],
      "expect": {
        "tile_preview": null,
        "window_configures": 0
      }
    },
    {
      "name": "Alt held in the middle: Fill previewed anywhere",
      "do": [
        "key_down",
        [
          56
        ]
      ],
      "expect": {
        "tile_preview": [
          8,
          36,
          1264,
          700
        ],
        "window_configures": 0
      }
    },
    {
      "name": "With Alt, toward the bottom right: its quarter",
      "do": [
        "move_output",
        [
          1100,
          684
        ]
      ],
      "expect": {
        "tile_preview": [
          644,
          390,
          628,
          346
        ],
        "window_configures": 0
      }
    },
    {
      "name": "Alt released: nothing previewed away from the edges",
      "do": [
        "key_up",
        [
          56
        ]
      ],
      "expect": {
        "tile_preview": null,
        "window_configures": 0
      }
    },
    {
      "name": "At the right edge's lower end: the bottom-right quarter",
      "do": [
        "move_output",
        [
          1279,
          724
        ]
      ],
      "expect": {
        "tile_preview": [
          644,
          390,
          628,
          346
        ],
        "window_configures": 0
      }
    },
    {
      "name": "At the right edge's middle: the right half",
      "do": [
        "move_output",
        [
          1279,
          400
        ]
      ],
      "expect": {
        "tile_preview": [
          644,
          36,
          628,
          700
        ],
        "window_configures": 0
      }
    },
    {
      "name": "At the bottom edge's middle, the dock's: nothing",
      "do": [
        "move_output",
        [
          640,
          799
        ]
      ],
      "expect": {
        "tile_preview": null,
        "window_configures": 0
      }
    },
    {
      "name": "Released at the right edge: the right half, told once",
      "do": [
        "release_output",
        [
          1279,
          400
        ]
      ],
      "expect": {
        "tile_preview": null,
        "window_rect": [
          644,
          36,
          628,
          700
        ],
        "window_configures": 1,
        "focus_surface": 1
      }
    },
    {
      "name": "Super+Alt+Left: the left half, told once; the keys reach the application not at all",
      "do": [
        "key",
        [
          125,
          56,
          105
        ]
      ],
      "expect": {
        "window_rect": [
          8,
          36,
          628,
          700
        ],
        "window_configures": 1,
        "focus_surface": 1,
        "tile_preview": null
      }
    },
    {
      "name": "Super+Alt+Up: the top half, told once; the keys reach the application not at all",
      "do": [
        "key",
        [
          125,
          56,
          103
        ]
      ],
      "expect": {
        "window_rect": [
          8,
          36,
          1264,
          346
        ],
        "window_configures": 1,
        "focus_surface": 1,
        "texts": [
          "active yes, zoomed no, full screen no"
        ],
        "tile_preview": null
      }
    },
    {
      "name": "Super+Alt+Down: the bottom half, told once; the keys reach the application not at all",
      "do": [
        "key",
        [
          125,
          56,
          108
        ]
      ],
      "expect": {
        "window_rect": [
          8,
          390,
          1264,
          346
        ],
        "window_configures": 1,
        "focus_surface": 1,
        "texts": [
          "active yes, zoomed no, full screen no"
        ],
        "tile_preview": null
      }
    },
    {
      "name": "Super+Alt+Right: the right half, told once; the keys reach the application not at all",
      "do": [
        "key",
        [
          125,
          56,
          106
        ]
      ],
      "expect": {
        "window_rect": [
          644,
          36,
          628,
          700
        ],
        "window_configures": 1,
        "focus_surface": 1,
        "tile_preview": null
      }
    },
    {
      "name": "Super+Alt+C: the right half's size, centred in the work area, told once",
      "do": [
        "key",
        [
          125,
          56,
          46
        ]
      ],
      "expect": {
        "window_rect": [
          326,
          36,
          628,
          700
        ],
        "window_configures": 1,
        "focus_surface": 1,
        "tile_preview": null
      }
    },
    {
      "name": "Super+Alt+F: Fill, told once; the keys reach the application not at all",
      "do": [
        "key",
        [
          125,
          56,
          33
        ]
      ],
      "expect": {
        "window_rect": [
          8,
          36,
          1264,
          700
        ],
        "window_configures": 1,
        "focus_surface": 1,
        "texts": [
          "active yes, zoomed no, full screen no"
        ],
        "tile_preview": null
      }
    },
    {
      "name": "Super+Alt+F again: already there, told nothing",
      "do": [
        "key",
        [
          125,
          56,
          33
        ]
      ],
      "expect": {
        "window_rect": [
          8,
          36,
          1264,
          700
        ],
        "window_configures": 0
      },
      "allow_unchanged": true
    },
    {
      "name": "Super+Alt+R: the size it had before it was first tiled",
      "do": [
        "key",
        [
          125,
          56,
          19
        ]
      ],
      "expect": {
        "window_configures": 1,
        "focus_surface": 1,
        "texts": [
          "active yes, zoomed no, full screen no"
        ]
      }
    },
    {
      "name": "Super+Alt+R again: nothing to return to",
      "do": [
        "key",
        [
          125,
          56,
          19
        ]
      ],
      "expect": {
        "window_configures": 0
      },
      "allow_unchanged": true
    }
  ]
}
