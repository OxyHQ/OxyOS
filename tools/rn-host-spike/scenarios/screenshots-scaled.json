        "screenshots": {
          "saved": [
            {
              "name": "Screenshot \\d{4}-\\d{2}-\\d{2} at \\d{2}\\.\\d{2}\\.\\d{2}\\.png",
              "folder": "Desktop",
              "output": 1,
              "width": 1600,
              "height": 1000,
              "alpha": false,
              "pixels": {
                "800,650": "#ffffff",
                "125,125": "#487bff"
              }
            }
          ],
          "opened": []
        }
      }
    },
