        "delivered": {
          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    },
    {
      "name": "Super+Shift+3: the whole display, at its own pixels, saved to the Desktop and named as a Mac names it; its thumbnail at the bottom-right corner, said to the screen reader; nothing of it reaches Allo, whose field keeps the keyboard",
      "do": [
        "key",
        [
          125,
          42,
          4
        ]
      ],
      "expect": {
        "react": {},
        "delivered": {},
        "focus_input": "line",
        "focus_surface": 1,
        "announcements": [
          {
            "politeness": "polite",
            "text": "Captura de pantalla guardada"
          }
        ],
        "at": {
          "shell": [
            {
              "role": "Button",
              "name": "Captura de pantalla"
            }
          ]
        },
        "output_pixels": {
          "1085,680": "#ffffff"
