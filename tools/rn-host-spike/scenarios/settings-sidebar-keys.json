    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "About",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "About, seleccionado, 11 de 11",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "↓ at the end goes nowhere, as a list stops at its ends: nothing is said again",
   "do": [
    "key",
    [
     108
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-about",
     "ring": true
