  },
  {
   "name": "↑: Privacy",
   "do": [
    "key",
    [
     103
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@settings-nav-about": 1,
     "focus@settings-nav-privacy": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-privacy",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Privacy",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Privacy, seleccionado, 10 de 11",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "Home: the first row, Appearance",
   "do": [
    "key",
    [
     102
