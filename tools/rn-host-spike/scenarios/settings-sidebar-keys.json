{
 "about": "Settings' sidebar navigated with the arrows as ONE list, as a Mac's System Settings sidebar (docs/adr/0039-keyboard-access.mdx; Bloom's SettingsLayout rail): Settings with the shell, the screen reader on in Spanish. Tab lands on the sidebar once, on its selected row; ↓ ↑, End and Home select the rows and show their panes, the keyboard following the selection and each row said once, selected; ↓ at the end goes nowhere; Tab goes on to the pane's first control and Shift+Tab back to the selected row. The sidebar is one list of its rows, its group labels headings. Every step checks the keyboard's focus, what the assistive technology holds, what the reader says and what is announced. At 1 (1280 × 720).",
 "module": "OxyOSSettings",
 "window": [
  900,
  640
 ],
 "shell": "OxyOSShell",
 "app": {
  "id": "so.oxy.settings",
  "title": "Settings"
 },
 "settings": {
  "app": "so.oxy.settings",
  "preferences": {
   "appearance": "light",
   "accent": "oxy"
  }
 },
 "reader": {
  "locale": "es_ES.UTF-8"
 },
 "steps": [
  {
   "name": "Settings' window with the shell, the reader on, nothing of it focused",
   "do": [
    "wait",
    1500
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": null,
    "spoken": [],
    "announcements": []
   }
  },
  {
   "name": "Tab: the keyboard on the sidebar's selected row, Appearance, said once with its state; the sidebar is one list of its rows, its group labels headings",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "focus@settings-nav-appearance": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-appearance",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "List"
      },
      {
       "role": "Heading",
       "name": "Personal"
      },
      {
       "role": "Heading",
       "name": "System"
      },
      {
       "role": "ListItem",
       "name": "Appearance",
       "state": [
        "selected",
        "focused"
       ]
      },
      {
       "role": "ListItem",
       "name": "Wallpaper",
       "state": []
      }
     ]
    },
    "spoken": [
     {
      "text": "Appearance, seleccionado, 1 de 11",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "↓: Wallpaper selected and its pane shown, the keyboard with it, said once",
   "do": [
    "key",
    [
     108
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@settings-nav-appearance": 1,
     "focus@settings-nav-wallpaper": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-wallpaper",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Wallpaper",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Wallpaper, seleccionado, 2 de 11",
      "interrupting": true
     }
    ],
    "announcements": [],
    "texts": [
     "Follows the sun through the day."
    ]
   }
  },
  {
   "name": "↓: Notifications",
   "do": [
    "key",
    [
     108
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@settings-nav-wallpaper": 1,
     "focus@settings-nav-notifications": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-notifications",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Notifications",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Notifications, seleccionado, 3 de 11",
      "interrupting": true
     }
    ],
    "announcements": [],
    "texts": [
     "Do Not Disturb"
    ]
   }
  },
  {
   "name": "↑: back to Wallpaper",
   "do": [
    "key",
    [
     103
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "shortcut@menu-bar": 1,
     "blur@settings-nav-notifications": 1,
     "focus@settings-nav-wallpaper": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-wallpaper",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Wallpaper",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Wallpaper, seleccionado, 2 de 11",
      "interrupting": true
     }
    ],
    "announcements": [],
    "texts": [
     "Follows the sun through the day."
    ]
   }
  },
  {
   "name": "Tab leaves the sidebar (no other row is a stop) for the pane's first control: the wallpaper's menu",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "blur@settings-nav-wallpaper": 1,
     "focus@Wallpaper": 1
    },
    "keyboard_focus": {
     "target": "Wallpaper",
     "ring": true
