       "state": [
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Wallpaper, OxyOS, botón",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "Shift+Tab: back to the sidebar, on its selected row",
   "do": [
