    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {
     "blur@Wallpaper": 1,
     "focus@settings-nav-wallpaper": 1
    },
    "keyboard_focus": {
     "target": "settings-nav-wallpaper",
     "ring": true
    },
    "at": {
     "window": [
      {
       "role": "ListItem",
       "name": "Wallpaper",
       "state": [
        "selected",
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Wallpaper, seleccionado, 2 de 11",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "End: the last row, About, across into the System group",
   "do": [
    "key",
    [
     107
    ]
   ],
   "allow_unchanged": true,
   "expect": {
