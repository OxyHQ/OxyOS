{
  "about": "Adding the computer's first Oxy account by typing its password in the SDK's own sign-in, through the setup assistant (docs/adr/0020-oxy-account-login.mdx, decision 2 as amended and the setup assistant's amendment), against a played Oxy API and a played accounts' service: the welcome, Get Started, the account's username, then \"Use your password instead\" and its password; the SDK hands the platform's setup store the credential with how it signed in and the password, and the assistant goes on at once to an optional PIN, never asking the password again. Not Now; the look, Light. Continue: the account set up with the password as it was typed, and signed in with it at once (the login program's PAM takes that password, as the account's verifier would), never asked again.",
  "shell": "OxyOSLogin",
  "outputs": "1280x1000",
  "login": {
    "password": "played password 1",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1"
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "first boot: the welcome",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Welcome to OxyOS",
            "Get Started"
          ]
        }
      }
    },
    {
      "name": "Get Started",
      "do": [
        "press_named",
        "Get Started"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "the SDK's own chooser, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Step 2 of 5"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "the account's username",
      "do": [
        "press",
        [
          411,
          383
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "typed",
      "do": [
        "type",
        "ada"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Continue: a code is sent to the account's email",
      "do": [
        "key",
        [
          28
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "the SDK asks for the code",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Check your email"
          ]
        },
        "oxy_requests": []
      }
    },
    {
      "name": "the password instead of the email's code",
      "do": [
        "press_named",
        "Use your password instead"
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Enter your password"
          ]
        }
      }
    },
    {
      "name": "the password typed into the SDK's field",
      "do": [
        "type",
        "played password 1"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "Continue pressed",
      "do": [
        "press_named",
        "Continue"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": []
      }
    },
    {
      "name": "the password typed: signed in, the credential handed over with how it signed in and the password",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "a PIN offered, optional; the password never asked again",
      "do": [
        "wait",
        2000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Create a PIN",
            "Unlock faster with a PIN, even offline. It stays on this computer: Oxy never sees it.",
            "Not Now",
            "Step 3 of 5"
          ],
          "absent": [
            "Enter Ada Lovelace's Oxy Password",
            "Set a password"
          ],
          "focus_input": "login-setup-pin-password",
          "never": [
            "played password 1"
          ]
        },
        "never": [
          "played password 1"
        ]
      }
    },
    {
      "name": "Not Now pressed",
      "do": [
        "press_named",
        "Not Now"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": []
      }
    },
    {
      "name": "Not Now: the look",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "texts": [
            "Choose Your Look",
            "Step 4 of 5"
          ],
          "never": [
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "Light chosen",
      "do": [
        "press_named",
        "Light"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Choose Your Look"
          ]
        }
      }
    },
    {
      "name": "Continue pressed",
      "do": [
        "press_named",
        "Continue"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "appearance: light",
          "enroll: enrolled"
        ]
      }
    },
    {
      "name": "Continue: set up with the password as it was typed, and signed in with it at once",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "absent": [
            "Protecting your PIN"
          ],
          "never": [
            "played password 1"
          ]
        }
      }
    }
  ]
}
