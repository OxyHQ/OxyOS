{
  "about": "Adding an Oxy account that has a password with the QR, leaving the PIN for later (docs/adr/0020-oxy-account-login.mdx, decision 2): after the approval, \"Not Now\" at the PIN, the account's password asked once, in its focused field; the account set up with the password alone; the new account chosen, its password's field focused, and its password signs it in.",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [
      {
        "accountId": "0123456789abcdef01234567",
        "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
        "uid": 1001,
        "name": "Bea Ramos"
      }
    ],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 7500
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "the login screen with one account",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Add Account: setup, online, the SDK's chooser asking for its QR",
      "do": [
        "press_named",
        "Add Account"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "platform: platform"
        ],
        "delivered": {},
        "oxy_requests": [
          "POST /auth/session/create 200",
          "WS /auth-session join {token} 101"
        ]
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves the QR: the session claimed, and a PIN for this computer asked, its field focused",
      "do": [
        "wait",
        4000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "POST /auth/session/claim 200",
          "GET /users/me/sign-in-methods 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Choose a PIN for this computer",
            "Use a PIN to unlock faster, even offline. It stays on this computer: Oxy never sees it.",
            "Not Now"
          ],
          "absent": [
            "Scan with Commons to sign in",
            "Email or username",
            "Enter Ada Lovelace's password"
          ],
          "focus_input": "login-setup-pin-password"
        }
      }
    },
    {
      "name": "not now: the account's password asked once, its field focused",
      "do": [
        "press_named",
        "Not Now"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Enter Ada Lovelace's password"
          ],
          "absent": [
            "Choose a PIN for this computer"
          ],
          "focus_input": "login-setup-password"
        }
      }
    },
    {
      "name": "the password: the account set up with it alone; the new account chosen, its password's field focused",
      "do": [
        "keyboard",
        "played password 1\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: enrolled"
        ],
        "delivered": {},
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "texts": [
            "Bea Ramos",
            "Ada Lovelace",
            "Add Account"
          ],
          "absent": [
            "Use Password",
            "Use PIN"
          ],
          "focus_input": "login-password",
          "never": [
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "its password signs it in",
      "do": [
        "keyboard",
        "oxyos.correcta\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "oxyos.correcta",
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "oxyos.correcta",
            "played password 1"
          ]
        }
      }
    }
  ]
}
