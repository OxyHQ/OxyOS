{
  "about": "Adding an Oxy account at the first boot by typing its password in the SDK's own sign-in (docs/adr/0020-oxy-account-login.mdx, decision 2 as amended), against a played Oxy API and a played accounts' service: the account's username, then \"Use your password instead\" and its password; the SDK hands the setup the password as it was typed, with how it signed in (@oxy.so/services 14.15.2), so the screen never asks for it again. A PIN is offered, optional (\"Use a PIN to unlock faster\"), and left for later; the accounts' service sets the account up with the password typed; the new account is listed and chosen, its password's field focused, and its password signs it in.",
  "shell": "OxyOSLogin",
  "outputs": "1280x1000",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1"
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "online: the SDK's own chooser, OxyOS's client id from the accounts' service; its QR beside the form, the field focused",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in"
          ],
          "absent": [
            "Adding an account needs an internet connection. Connect and try again."
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "the account's username",
      "do": [
        "press",
        [
          411,
          383
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "typed",
      "do": [
        "type",
        "ada"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Continue: a code is sent to the account's email",
      "do": [
        "key",
        [
          28
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "the SDK asks for the code",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Check your email"
          ]
        },
        "oxy_requests": []
      }
    },
    {
      "name": "the password instead of the email's code",
      "do": [
        "press_named",
        "Use your password instead"
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Enter your password"
          ]
        }
      }
    },
    {
      "name": "the password typed: signed in, the credential handed over with how it signed in and the password",
      "do": [
        "keyboard",
        "played password 1\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "a PIN offered, optional; the password never asked again",
      "do": [
        "wait",
        2000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Choose a PIN for this computer",
            "Use a PIN to unlock faster, even offline. It stays on this computer: Oxy never sees it.",
            "Not Now"
          ],
          "absent": [
            "Enter Ada Lovelace's password",
            "Set a password"
          ],
          "focus_input": "login-setup-pin-password",
          "never": [
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "Not Now: the account set up with the password as it was typed; listed and chosen, its password's field focused",
      "do": [
        "press_named",
        "Not Now"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: enrolled"
        ],
        "never": [
          "played password 1"
        ],
        "in_shell": {
          "texts": [
            "Ada Lovelace",
            "Add Account"
          ],
          "absent": [
            "Enter Ada Lovelace's password",
            "Use PIN",
            "Choose a PIN for this computer"
          ],
          "focus_input": "login-password",
          "never": [
            "played password 1"
          ]
        }
      }
    },
    {
      "name": "its password signs it in",
      "do": [
        "keyboard",
        "oxyos.correcta\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "oxyos.correcta",
          "played password 1"
        ],
        "in_shell": {
          "never": [
            "oxyos.correcta",
            "played password 1"
          ]
        }
      }
    }
  ]
}
