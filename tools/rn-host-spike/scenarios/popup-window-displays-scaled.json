{
  "about": "popup-window-displays.json with the displays the other way round: the primary a 1600x1000 display at 1.25 (1280x800 logical, the ThinkPad's panel) and, right of it, a 1280x720 display at 1. The window and its menu start at 1.25 (the menu 265 logical pixels wide, 332 by 90 device pixels), go across to 1 (266 by 72) at the same place against the trigger, and come back; the tooltip goes across to 1. With the menu on the second display, that display's scale changes, to 1.25 and back to 1: the menu stays at its trigger and is drawn at each scale, placed again for its logical width, and keeps the keyboard (Down reaches it once between).",
  "module": "PopupWindowProbe",
  "window": [
    900,
    600
  ],
  "outputs": "1600x1000@1.25,1280x720",
  "steps": [
    {
      "name": "a press on the page: the window is the active one, on the first display",
      "do": [
        "press",
        [
          600,
          500
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "popups": 0,
        "focus_surface": 1,
        "window_rect": [
          190,
          100,
          900,
          600
        ],
        "frame_px": {
          "window": [
            1125,
            750
          ]
        },
        "react": {
          "touchStart@settings-page": 1,
          "touchEnd@settings-page": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    },
    {
      "name": "the menu opens under its trigger, drawn at 1.25",
      "do": [
        "press_named",
        "Actions"
      ],
      "expect": {
        "popup_rects": [
          [
            524,
            272,
            265,
            72
          ]
        ],
        "focus_surface": 2,
        "frame_px": {
          "popup": [
            332,
            90
          ]
        },
        "react": {
          "touchStart@menu-trigger": 1,
          "touchEnd@menu-trigger": 1
        },
        "popup_events": {
          "open@actions": 1
        },
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1,
            "press": 1,
            "release": 1
          },
          "2": {
            "focus.in": 1
          }
        },
        "texts": [
          "menu opened 1, closed 0"
        ]
      }
    },
    {
      "name": "the shell moves the window onto the second display: the menu goes with it, at its trigger, drawn at 1, the keyboard still its",
      "do": [
        "move-window",
        [
          1200,
          0
        ]
      ],
      "expect": {
        "window_rect": [
          1390,
          100,
          900,
          600
        ],
        "popup_rects": [
          [
            1724,
            272,
            266,
            72
          ]
        ],
        "focus_surface": 2,
        "frame_px": {
          "window": [
            900,
            600
          ],
          "popup": [
            266,
            72
          ]
        },
        "react": {},
        "popup_events": {
          "reposition@actions": 1
        },
        "delivered": {},
        "texts": [
          "menu opened 1, closed 0"
        ]
      }
    },
    {
      "name": "the second display's scale changes with the menu on it",
      "do": [
        "scale",
        [
          2,
          150
        ]
      ],
      "expect": {
        "popup_rects": [
          [
            1724,
            272,
            265,
            72
          ]
        ],
        "focus_surface": 2,
        "frame_px": {
          "window": [
            1125,
            750
          ],
          "popup": [
            332,
            90
          ]
        },
        "react": {},
        "popup_events": {
          "reposition@actions": 1
        },
        "delivered": {},
        "texts": [
          "menu opened 1, closed 0"
        ]
      }
    },
    {
      "name": "Down reaches the menu once",
      "do": [
        "key",
        108
      ],
      "expect": {
        "popups": 1,
        "focus_surface": 2,
        "react": {
          "key@actions": 1
        },
        "popup_events": {},
        "delivered": {
          "2": {
            "key.press": 1,
            "key.release": 1
          }
        },
        "at": {
          "popup": [
            {
              "role": "MenuItem",
              "name": "Archive",
              "state": [
                "focused"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "and back",
      "do": [
        "scale",
        [
          2,
          120
        ]
      ],
      "expect": {
        "popup_rects": [
          [
            1724,
            272,
            266,
            72
          ]
        ],
        "focus_surface": 2,
        "frame_px": {
          "window": [
            900,
            600
          ],
          "popup": [
            266,
            72
          ]
        },
        "react": {},
        "popup_events": {
          "reposition@actions": 1
        },
        "delivered": {},
        "texts": [
          "menu opened 1, closed 0"
        ]
      }
    },
    {
      "name": "a row is chosen there: the menu closes, the window has the keyboard",
      "do": [
        "press_popup",
        [
          60,
          20
        ]
      ],
      "expect": {
        "popups": 0,
        "focus_surface": 1,
        "texts": [
          "Chosen: Archive",
          "menu opened 1, closed 1"
        ],
        "react": {
          "touchStart@action-Archive": 1,
          "touchEnd@action-Archive": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "focus.in": 1
          },
          "2": {
            "enter": 1,
            "focus.out": 1,
            "press": 1,
            "release": 1
          }
        },
        "popup_events": {
          "close@2": 1
        },
        "a11y_events": {
          "focus@menu-trigger": 1
        }
      }
    },
    {
      "name": "the menu opens again on the second display, drawn at 1",
      "do": [
        "press_named",
        "Actions"
      ],
      "expect": {
        "popup_rects": [
          [
            1724,
            272,
            266,
            72
          ]
        ],
        "focus_surface": 3,
        "frame_px": {
          "popup": [
            266,
            72
          ]
        },
        "react": {
          "touchStart@menu-trigger": 1,
          "touchEnd@menu-trigger": 1
        },
        "popup_events": {
          "open@actions": 1
        },
        "texts": [
          "menu opened 2, closed 1"
        ],
        "delivered": {
          "1": {
            "focus.out": 1,
            "leave": 1,
            "press": 1,
            "release": 1
          },
          "3": {
            "focus.in": 1
          }
        }
      }
    },
    {
      "name": "moved back onto the first display: the menu goes with it and is drawn at 1.25 again",
      "do": [
        "move-window",
        [
          -1200,
          0
        ]
      ],
      "expect": {
        "window_rect": [
          190,
          100,
          900,
          600
        ],
        "popup_rects": [
          [
            524,
            272,
            265,
            72
          ]
        ],
        "focus_surface": 3,
        "frame_px": {
          "window": [
            1125,
            750
          ],
          "popup": [
            332,
            90
          ]
        },
        "react": {},
        "popup_events": {
          "reposition@actions": 1
        },
        "delivered": {},
        "texts": [
          "menu opened 2, closed 1"
        ]
      }
    },
    {
      "name": "Escape closes it",
      "do": [
        "key",
        1
      ],
      "expect": {
        "popups": 0,
        "focus_surface": 1,
        "react": {
          "key@actions": 1
        },
        "texts": [
          "menu opened 2, closed 2"
        ],
        "delivered": {
          "1": {
            "focus.in": 1
          },
          "3": {
            "focus.out": 1,
            "key.press": 1,
            "key.release": 1
          }
        },
        "popup_events": {
          "close@3": 1
        },
        "a11y_events": {
          "focus@menu-trigger": 1
        }
      }
    },
    {
      "name": "the tooltip shows under its button",
      "do": [
        "press_named",
        "Help"
      ],
      "expect": {
        "popup_rects": [
          [
            605,
            271,
            240,
            37
          ]
        ],
        "focus_surface": 1,
        "react": {
          "touchStart@tip-trigger": 1,
          "touchEnd@tip-trigger": 1
        },
        "popup_events": {
          "open@Explains the page": 1
        },
        "texts": [
          "tooltip opened 1, closed 0"
        ],
        "delivered": {
          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    },
    {
      "name": "the window goes onto the second display: the tooltip goes with it",
      "do": [
        "move-window",
        [
          1200,
          0
        ]
      ],
      "expect": {
        "window_rect": [
          1390,
          100,
          900,
          600
        ],
        "popup_rects": [
          [
            1805,
            271,
            240,
            37
          ]
        ],
        "focus_surface": 1,
        "frame_px": {
          "window": [
            900,
            600
          ],
          "popup": [
            240,
            37
          ]
        },
        "react": {},
        "popup_events": {},
        "texts": [
          "tooltip opened 1, closed 0"
        ],
        "delivered": {
          "1": {
            "leave": 1
          }
        }
      }
    }
  ]
}
