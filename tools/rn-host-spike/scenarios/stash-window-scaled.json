{
 "about": "stash-window.json on the ThinkPad's display (1600x1000 at 1.25, ADR 0018): every size the drags pass through asked for at 1.25, the same walk 40 px lower on the logical 1280x800 output.",
 "module": "Stash",
 "window": [
  1024,
  680
 ],
 "outputs": "1600x1000@1.25",
 "app": {
  "id": "so.oxy.stash",
  "title": "Stash"
 },
 "home": {
  "items": {
   "Documents/": "",
   "Downloads/": "",
   "Pictures/": "",
   "notes.txt": "hello",
   "report.pdf": "%PDF",
   "photo.jpg": "x"
  }
 },
 "steps": [
  {
   "name": "Its first window: the sidebar in it (no drawer, no menu button), the window's controls at its top",
   "do": [
    "wait",
    1500
   ],
   "allow_unchanged": true,
   "expect": {
    "window_rect": [
     128,
     60,
     1024,
     680
    ],
    "window_shown": true,
    "at": {
     "window": [
      {
       "role": "Button",
       "name": "Documents"
      },
      {
       "role": "Button",
       "name": "Hide Sidebar"
      },
      {
       "role": "Button",
       "name": "Close"
      }
     ]
    },
    "at_absent": {
     "window": [
      {
       "role": "Button",
       "name": "Open navigation"
      }
     ]
    }
   }
  },
  {
   "name": "A press held on the toolbar's empty middle moves the window with the pointer",
   "do": [
    "grab",
    [
     522,
     27,
     -60,
     -50
    ]
   ],
   "expect": {
    "window_rect": [
     68,
     10,
     1024,
     680
    ]
   }
  },
  {
   "name": "The right edge dragged 80 px out: the left, top and bottom edges stay, the pane relaid out live",
   "do": [
    "drag_paced",
    [
     1094,
     400,
     1174,
     400,
     50,
     125
    ]
   ],
   "expect": {
    "window_rect": [
     68,
     10,
     1104,
     680
    ],
    "drag": {
     "unanswered_max": 0,
     "bounded": true,
     "presented_min": 3,
     "steady": [
      "left",
      "top",
      "bottom"
     ]
    },
    "at": {
     "window": [
      {
       "role": "Button",
       "name": "Documents"
      }
     ]
    },
    "at_absent": {
     "window": [
      {
       "role": "Button",
       "name": "Open navigation"
      }
     ]
    }
   }
  },
  {
   "name": "The left edge dragged 100 px in: the right, top and bottom edges stay",
   "do": [
    "drag_paced",
    [
     65,
     400,
     165,
     400,
     50,
     125
    ]
   ],
   "expect": {
    "window_rect": [
     168,
     10,
     1004,
     680
    ],
    "drag": {
     "unanswered_max": 0,
     "bounded": true,
     "presented_min": 3,
     "steady": [
      "top",
      "right",
      "bottom"
     ]
    },
    "at": {
     "window": [
      {
       "role": "Button",
       "name": "Documents"
      }
     ]
    },
    "at_absent": {
     "window": [
      {
       "role": "Button",
       "name": "Open navigation"
      }
     ]
    }
   }
  },
  {
