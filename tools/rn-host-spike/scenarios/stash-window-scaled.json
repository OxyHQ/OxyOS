  {
   "name": "The green bubble zooms the window to the work area",
   "do": [
    "press",
    [
     72,
     26
    ]
   ],
   "expect": {
    "window_rect": [
     0,
     0,
     1280,
     800
    ]
   }
  },
  {
   "name": "Pressed again, it restores the frame it had",
   "do": [
    "press",
    [
     72,
     26
    ]
   ],
   "expect": {
    "window_rect": [
     318,
     60,
     640,
     400
    ]
   }
  },
  {
   "name": "Hide Sidebar, from the toolbar: the sidebar leaves the window and the accessibility tree, the pane takes its room, the window does not move",
   "do": [
    "press",
    [
     261,
     26
    ]
   ],
   "expect": {
    "window_rect": [
     318,
     60,
     640,
     400
    ],
    "at": {
     "window": [
      {
       "role": "Button",
       "name": "Show Sidebar"
      }
     ]
    },
    "at_absent": {
     "window": [
      {
       "role": "Button",
       "name": "Documents"
      },
      {
       "role": "Button",
       "name": "Open navigation"
      }
     ]
    }
   }
  },
  {
   "name": "With the sidebar hidden the toolbar keeps the window's controls' room: its toggle is after them, and shows the sidebar again",
   "do": [
    "press",
    [
     106,
     26
    ]
   ],
   "expect": {
    "window_rect": [
     318,
     60,
     640,
     400
    ],
    "at": {
     "window": [
      {
       "role": "Button",
       "name": "Documents"
      },
      {
       "role": "Button",
       "name": "Hide Sidebar"
      }
     ]
    }
   }
  },
  {
   "name": "The yellow bubble minimizes the window",
   "do": [
    "press",
    [
     48,
     26
    ]
