{
  "about": "A QR sign-in whose token Oxy's API refuses, as production did on 2026-11-08 (docs/adr/0020-oxy-account-login.mdx, decision 4 and the setup assistant's amendment; OxyHQ/oxy#2224): at the first boot a phone approves, the session is claimed and the account put on the device, and then the token is refused at the SDK's first read of the account (`qr.token_refused_at`: the API task that approved the request held the session as it was before the claim bound it). The setup no longer waits on anything the SDK reads after the claim: the credential the claim issued is handed over at once and the PIN page comes, never a device picker, never a second approval; the account is set up with that credential and signs in.",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "cue",
        "token_refused_at": "GET /users/me"
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "first boot: the setup assistant's welcome, nothing asked of Oxy yet",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Welcome to OxyOS",
            "Sign in with your Oxy account to make this computer yours. It takes a minute.",
            "Get Started"
          ],
          "absent": [
            "Back",
            "Scan with Commons to sign in"
          ]
        }
      }
    },
    {
      "name": "Get Started pressed",
      "do": [
        "press_named",
        "Get Started"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Get Started: online, the SDK's sign-in, step 2 of 5, never a device picker",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [],
          "absent": [
            "Choose an account",
            "Use another account"
          ]
        }
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves: the session claimed, the SDK's own read refused, and the PIN page at once, its field focused; no second approval",
      "do": [
        "cue",
        "qr-approve"
      ],
      "until_named": [
        "Create a PIN",
        20000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "oxy_requests": [
          "POST /auth/session/claim 200",
          "GET /users/me 401"
        ],
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 1,
          "POST /auth/session/create 200": 0
        },
        "in_shell": {
          "texts": [
            "Create a PIN",
            "You’ll use it to sign in and unlock this computer, even offline. It stays here: Oxy never sees it.",
            "Step 3 of 5"
          ],
          "absent": [
            "Choose an account",
            "Email or username",
            "Scan with Commons to sign in",
            "Use another account"
          ],
          "focus_input": "login-setup-pin-password"
        }
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter Your PIN Again"
          ],
          "absent": [
            "Enter Ada Lovelace's password",
            "Not Now",
            "Set a password",
            "Send code"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916"
          ]
        }
      }
    },
    {
      "name": "typed again: the look's page",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Choose Your Look",
            "Continue"
          ]
        },
        "never": [
          "482916"
        ]
      }
    },
    {
      "name": "Auto chosen",
      "do": [
        "press_named",
        "Auto"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "in_shell": {
          "texts": [
            "Choose Your Look"
          ]
        }
      }
    },
    {
      "name": "Continue pressed",
      "do": [
        "press_named",
        "Continue"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "appearance: auto",
          "enroll: enrolled",
          "verifyPin: accepted"
        ]
      }
    },
    {
      "name": "Continue: the account set up with what was chosen, its stages shown, and signed in with it at once, never asked again",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "in_shell": {},
        "oxy_requests_times": {
          "POST /auth/session/create 200": 0
        }
      }
    }
  ]
}
