{
  "about": "A QR sign-in whose token Oxy's API refuses, as production did on 2026-11-08 (docs/adr/0020-oxy-account-login.mdx, decision 4; OxyHQ/oxy#2224): at the first boot a phone approves, the session is claimed and the account put on the device, and then the token is refused at the account's first read (`qr.token_refused_at`: the API task that approved the request held the session as it was before the claim bound it). The setup keeps no credential, so the SDK cannot mint another: it signs out and drops the device with the session (@oxy.so/services 14.15.1), and the sign-in starts again on its QR, its field focused, never on a \"Choose an account\" picker listing the account it just lost, and never asking for a password. A second approval then signs in once, and the account is set up and signs in. Nothing reaches any application at any step.",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "qr": {
        "approve": "socket",
        "approve_after_ms": 10000,
        "token_refused_at": "GET /users/me/sign-in-methods"
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-1",
        "deviceSecret": "played-device-secret-1"
      },
      "password": "played password 1",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "first boot: setup, online, straight to the SDK's sign-in, never a device picker",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Add an Oxy Account"
          ],
          "absent": [
            "Choose an account",
            "Use another account"
          ]
        }
      }
    },
    {
      "name": "the SDK's chooser, its QR beside the form, the field focused",
      "do": [
        "wait",
        500
      ],
      "allow_unchanged": true,
      "expect": {
        "delivered": {},
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Sign in",
            "Email or username",
            "Scan with Commons to sign in",
            "Create account"
          ],
          "absent": [
            "Get Commons",
            "Commons isn't installed",
            "Choose an account",
            "Use another account"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a phone approves: the session claimed, its token refused, the sign-in on its QR again, never a device picker",
      "do": [
        "wait",
        11000
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "oxy_requests": [
          "POST /auth/session/claim 200",
          "POST /session/device/add 200",
          "GET /users/me/sign-in-methods 401",
          "POST /auth/session/create 200"
        ],
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 1
        },
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Email or username",
            "Scan with Commons to sign in"
          ],
          "absent": [
            "Choose an account",
            "Use another account",
            "Enter Ada Lovelace's password"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "a second approval: claimed once, a PIN for this computer asked, its field focused, no password asked or offered",
      "do": [
        "wait",
        11500
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "oxy_requests": [
          "POST /auth/session/claim 200",
          "GET /users/me/sign-in-methods 200"
        ],
        "delivered": {},
        "in_shell": {
          "texts": [
            "Choose a PIN for this computer",
            "Use it to sign in and unlock, even offline. It stays on this computer: Oxy never sees it."
          ],
          "absent": [
            "Choose an account",
            "Email or username",
            "Enter Ada Lovelace's password",
            "Not Now",
            "Scan with Commons to sign in",
            "Send code",
            "Set a password",
            "Use another account"
          ],
          "focus_input": "login-setup-pin-password"
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 1
        }
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "delivered": {},
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Enter the PIN again"
          ],
          "absent": [
            "Enter Ada Lovelace's password",
            "Not Now",
            "Set a password",
            "Send code"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916"
          ]
        }
      }
    },
    {
      "name": "typed again: the account set up with its PIN alone, by the credential the QR's sign-in handed over; listed and chosen, its PIN's field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: enrolled"
        ],
        "delivered": {},
        "never": [
          "482916"
        ],
        "in_shell": {
          "texts": [
            "Ada Lovelace"
          ],
          "absent": [
            "Add an Oxy Account",
            "Bea Ramos",
            "Choose an account",
            "Enter Ada Lovelace's password",
            "Use Password",
            "Use another account"
          ],
          "never": [
            "482916"
          ],
          "focus_input": "login-pin-password"
        },
        "oxy_requests_times": {
          "POST /auth/session/claim 200": 0,
          "POST /auth/session/create 200": 0
        }
      }
    },
    {
      "name": "its PIN signs it in",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "verifyPin: accepted"
        ],
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "482916"
        ],
        "in_shell": {
          "never": [
            "482916"
          ]
        }
      }
    }
  ]
}
