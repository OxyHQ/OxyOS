{
  "about": "Migrate from a Backup at the first boot (docs/adr/0059-backups.mdx, decision 7), as a Mac's Migration Assistant brings another Mac over from Time Machine: no account is enrolled and Oxy's API is offline, so setup says it needs the network and offers, beside it, to migrate from a backup, which needs none. A played migration service (no backup of anyone's): its one disk is chosen, a wrong backup password is refused and said (the field shaken), the right one opens one computer, ada-laptop, whose backups are listed newest first by date with the accounts its newest holds; the newest is chosen, confirmed, and its progress shown while the service restores. Then the login screen lists the accounts brought over, each to sign in again online with its Oxy account, never a password field that could not open it, and nobody is signed in.",
  "locale": "en_US.UTF-8",
  "tz": "UTC",
  "shell": "OxyOSLogin",
  "outputs": "1280x800",
  "login": {
    "password": "oxyos.correcta",
    "accounts": [],
    "record": [],
    "migrate": {
      "disks": [
        {
          "uuid": "1234-ABCD",
          "label": "Copias",
          "fsType": "ext4",
          "size": 2000000000000
        }
      ],
      "password": "played backup password",
      "computers": [
        {
          "repository": "0123456789abcdef",
          "name": "ada-laptop",
          "backups": [
            {
              "snapshot": "bbbb2222",
              "time": 1794069000
            },
            {
              "snapshot": "aaaa1111",
              "time": 1793442600
            }
          ],
          "accounts": [
            {
              "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
              "name": "Ada Lovelace",
              "administrator": true
            },
            {
              "user": "oxy-bbbbbbbbbbbbbbbbbbbb",
              "name": "Bea Ramos",
              "administrator": false
            }
          ]
        }
      ],
      "unopened": 1,
      "step_ms": 1500,
      "accounts": [
        {
          "accountId": "0123456789abcdef01234567",
          "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
          "uid": 1001,
          "name": "Ada Lovelace"
        },
        {
          "accountId": "0123456789abcdef01234568",
          "user": "oxy-bbbbbbbbbbbbbbbbbbbb",
          "uid": 1002,
          "name": "Bea Ramos"
        }
      ]
    }
  },
  "steps": [
    {
      "name": "the first boot, offline: setup says it needs the network, and offers to migrate from a backup",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Add an Oxy Account",
            "Adding an account needs an internet connection",
            "Migrate from a Backup"
          ]
        }
      }
    },
    {
      "name": "Migrate from a Backup: the disks the service finds",
      "do": [
        "press_named",
        "Migrate from a Backup"
      ],
      "allow_unchanged": true,
      "expect": {
        "migrate_asked": [
          "disks: disks"
        ],
        "in_shell": {
          "texts": [
            "Migrate from a Backup",
            "Bring the accounts of another computer over from its backup",
            "Copias"
          ],
          "absent": [
            "Adding an account needs an internet connection"
          ]
        }
      }
    },
    {
      "name": "the disk chosen: its backup password asked, the field focused",
      "do": [
        "press_named",
        "Copias"
      ],
      "allow_unchanged": true,
      "expect": {
        "migrate_asked": [],
        "in_shell": {
          "texts": [
            "Enter the backup password for Copias"
          ],
          "focus_input": "login-migrate-password"
        }
      }
    },
    {
      "name": "a wrong password: refused and said",
      "do": [
        "keyboard",
        "wrong password\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "migrate_asked": [
          "backups: wrongPassword"
        ],
        "never": [
          "wrong password"
        ],
        "in_shell": {
          "texts": [
            "That password doesn't open any of the backups there."
          ],
          "never": [
            "wrong password"
          ]
        }
      }
    },
    {
      "name": "the right one: the computer's backups, newest first, and its accounts",
      "do": [
        "keyboard",
        "played backup password\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "migrate_asked": [
          "backups: backups"
        ],
        "never": [
          "played backup password"
        ],
        "in_shell": {
          "texts": [
            "Backups of ada-laptop",
            "Accounts: Ada Lovelace and Bea Ramos",
            "November 7, 2026 at 4:30 PM"
          ],
          "absent": [
            "That password doesn't open any of the backups there."
          ],
          "never": [
            "played backup password"
          ]
        }
      }
    },
    {
      "name": "the newest backup chosen: what migrating brings over, to confirm",
      "do": [
        "press_named",
        "November 7, 2026 at 4:30 PM"
      ],
      "allow_unchanged": true,
      "expect": {
        "migrate_asked": [],
        "in_shell": {
          "texts": [
            "Migrate ada-laptop?",
            "Migrate",
            "Back"
          ]
        }
      }
    },
    {
      "name": "Migrate: its progress, while the service restores",
      "do": [
        "press_named",
        "Migrate"
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "ada-laptop",
            "Don't turn off this computer."
          ],
          "absent": [
            "Migrate ada-laptop?"
          ]
        }
      }
    },
    {
      "name": "migrated: the accounts brought over listed, each to sign in again online",
      "do": [
        "wait",
        12000
      ],
      "allow_unchanged": true,
      "expect": {
        "migrate_asked": [
          "migrate: migrated"
        ],
        "shell": {
          "locked": true,
          "signed_in": false
        },
        "in_shell": {
          "texts": [
            "Ada Lovelace",
            "Bea Ramos",
            "Sign in to Ada Lovelace's Oxy account again to use it on this computer.",
            "Sign In Again"
          ],
          "absent": [
            "Migrate from a Backup",
            "Don't turn off this computer."
          ]
        }
      }
    }
  ],
  "final": {
    "in_shell": {
      "texts": [
        "Sign In Again"
      ]
    }
  }
}
