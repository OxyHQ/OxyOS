{
  "about": "A process the accounts' service does not know as a launched application (docs/adr/0020-oxy-account-login.mdx, decision 6): it says nothing but `notPermitted` to it, whatever id the process was given, so the session host shows the session unavailable, with no account, and a token asked for is none. The service knows a peer by its launch, never by what it says.",
  "module": "AccountProbe",
  "window": [
    640,
    320
  ],
  "app": {
    "id": "so.oxy.accountprobe",
    "title": "Account probe"
  },
  "account": {
    "registered": [
      "so.oxy.inbox"
    ]
  },
  "steps": [
    {
      "name": "the session unavailable to it",
      "do": [
        "wait",
        300
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Host oxyos, contract 1",
          "Status unavailable, offline",
          "No account"
        ],
        "absent": [
          "Signed in as Ada Lovelace (@ada)"
        ]
      }
    },
    {
      "name": "refused a token: none",
      "do": [
        "press_named",
        "Ask for a token"
      ],
      "expect": {
        "texts": [
          "No token"
        ],
        "absent": [
          "Token for"
        ],
        "account_session": [
          "- token boot: refused",
          "- subscribe: refused"
        ]
      }
    }
  ]
}
