{
  "about": "Settings › Passwords (docs/adr/0050-keychain-autofill-and-passkeys.mdx, decision 8), over a played accounts' service's keychain (fixture items, no one's secrets): the page opens behind the account's password, a wrong one refused and said; open, the categories and every item, no password shown; search; an item's sheet with its password hidden until shown, copied marked sensitive and gone from the clipboard 90 seconds later, its verification code counting down; edited, a strong password from the service's generator, saved; deleted after asking; Security's reused and weak passwords; Devices' members. No password reaches a report before it is shown.",
  "module": "OxyOSSettings",
  "window": [
    1100,
    800
  ],
  "app": {
    "id": "so.oxy.settings",
    "title": "Settings"
  },
  "settings": {
    "app": "so.oxy.settings",
    "preferences": {
      "appearance": "light",
      "accent": "oxy"
    }
  },
  "account": {
    "registered": [
      "so.oxy.settings"
    ],
    "keychain": {
      "state": "member",
      "vault": true,
      "password": "played password 1",
      "items": [
        {
          "itemId": "example-1",
          "type": "login",
          "title": "Example",
          "username": "bea@example.com",
          "password": "Fixture-Pass-01",
          "urls": [
            "https://example.com"
          ],
          "apps": [
            "so.oxy.dropsea"
          ],
          "totp": "otpauth://totp/Example:bea%40example.com?secret=JBSWY3DPEHPK3PXP&issuer=Example",
          "notes": null,
          "createdAt": "2026-11-01T09:00:00.000Z",
          "modifiedAt": "2026-11-01T09:00:00.000Z"
        },
        {
          "itemId": "bank-1",
          "type": "login",
          "title": "Bank",
          "username": "bea",
          "password": "fixture1",
          "urls": [
            "https://bank.example"
          ],
          "apps": [],
          "totp": null,
          "notes": null,
          "createdAt": "2026-11-02T09:00:00.000Z",
          "modifiedAt": "2026-11-02T09:00:00.000Z"
        },
        {
          "itemId": "mail-1",
          "type": "login",
          "title": "Mail",
          "username": "bea@mail.example",
          "password": "fixture1",
          "urls": [
            "https://mail.example"
          ],
          "apps": [],
          "totp": null,
          "notes": null,
          "createdAt": "2026-11-03T09:00:00.000Z",
          "modifiedAt": "2026-11-03T09:00:00.000Z"
        },
        {
          "itemId": "home-wifi",
          "type": "wifi",
          "ssid": "Home",
          "password": "fixture-wifi-key",
          "security": "wpa2-psk",
          "hidden": false,
          "createdAt": "2026-11-04T09:00:00.000Z",
          "modifiedAt": "2026-11-04T09:00:00.000Z"
        },
        {
          "itemId": "passkey-1",
          "type": "passkey",
          "rpId": "example.com",
          "rpName": "Example Passkey",
          "userName": "bea",
          "userDisplayName": "Bea",
          "createdAt": "2026-11-05T09:00:00.000Z",
          "modifiedAt": "2026-11-05T09:00:00.000Z"
        }
      ],
      "codes": {
        "example-1": {
          "code": "287082",
          "period": 30,
          "remaining": 30
        }
      },
      "generated": [
        "abcde-FGHIJ-12345-kLmNo"
      ],
      "members": [
        {
          "memberId": "m-self",
          "name": "Laptop",
          "platform": "oxyos",
          "self": true,
          "orphaned": false
        },
        {
          "memberId": "m-phone",
          "name": "Phone",
          "platform": "android",
          "self": false,
          "orphaned": false
        }
      ],
      "enrollments": []
    }
  },
  "steps": [
    {
      "name": "Passwords in the sidebar, after Lock Screen",
      "do": [
        "wait",
        1500
      ],
      "expect": {
        "texts": [
          "Passwords",
          "Lock Screen"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Passwords opens behind the account's password",
      "do": [
        "press_named",
        "Passwords"
      ],
      "expect": {
        "texts": [
          "Passwords Are Locked",
          "Enter your account's password to see your passwords.",
          "Unlock"
        ],
        "absent": [
          "Example",
          "Bank"
        ],
        "account_session": [
          "so.oxy.settings keychainStatus: member"
        ],
        "at": {
          "window": [
            {
              "role": "Heading",
              "name": "Passwords Are Locked"
            }
          ]
        }
      },
      "allow_unchanged": true
    },
    {
      "name": "the password field holds the keyboard",
      "do": [
        "type",
        "wrong"
      ],
      "expect": {
        "account_session": [],
        "never": [
          "wrong"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Return: a wrong password refused and said",
      "do": [
        "key",
        28
      ],
      "expect": {
        "texts": [
          "The password is incorrect."
        ],
        "absent": [
          "Example"
        ],
        "account_session": [
          "so.oxy.settings keychainVerify: wrongPassword"
        ],
        "never": [
          "wrong"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "the right password",
      "do": [
        "type",
        "played password 1"
      ],
      "expect": {
        "account_session": [],
        "never": [
          "played password 1"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Return: the keychain open, every item listed, no password shown",
      "do": [
        "key",
        28
      ],
      "expect": {
        "texts": [
          "All",
          "Passwords",
          "Passkeys",
          "Codes",
          "Wi-Fi",
          "Notes",
          "Security",
          "Devices",
          "Example",
          "bea@example.com",
          "Bank",
          "Mail",
          "Home",
          "Example Passkey",
          "New Password"
        ],
        "account_session": [
          "so.oxy.settings keychainVerify: verified",
          "so.oxy.settings keychainStatus: member",
          "so.oxy.settings keychainList: items",
          "so.oxy.settings keychainAudit: audit"
        ],
        "at": {
          "window": [
            {
              "role": "TabList",
              "name": "Categories"
            },
            {
              "role": "Tab",
              "name": "All"
            },
            {
              "role": "Tab",
              "name": "Security"
            }
          ]
        },
        "never": [
          "played password 1",
          "Fixture-Pass-01",
          "fixture1",
          "fixture-wifi-key"
        ]
      }
    },
    {
      "name": "searching narrows the list",
      "do": [
        "press_named",
        "Search"
      ],
      "expect": {},
      "allow_unchanged": true
    },
    {
      "name": "typed",
      "do": [
        "type",
        "bank"
      ],
      "expect": {
        "texts": [
          "Bank"
        ],
        "absent": [
          "Example",
          "Mail",
          "Home"
        ],
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "cleared",
      "do": [
        "press_named",
        "Clear search query"
      ],
      "expect": {
        "texts": [
          "Example",
          "Bank",
          "Mail"
        ],
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "an item's sheet: its password hidden, its code counting down",
      "do": [
        "press_named",
        "Example, bea@example.com"
      ],
      "expect": {
        "texts": [
          "Username",
          "bea@example.com",
          "Password",
          "••••••••",
          "Show",
          "Copy",
          "Verification Code",
          "Edit",
          "Delete…",
          "Done"
        ],
        "texts_matching": [
          "^287 082  ·  \\d+ s$"
        ],
        "account_session": [
          "so.oxy.settings keychainReveal: item",
          "so.oxy.settings keychainCode: code"
        ],
        "never": [
          "Fixture-Pass-01",
          "played password 1"
        ]
      }
    },
    {
      "name": "Show: the password shown",
      "do": [
        "press_named",
        "Show password"
      ],
      "expect": {
        "texts": [
          "Fixture-Pass-01",
          "Hide"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Copy: marked sensitive on the clipboard, and said",
      "do": [
        "press_named",
        "Copy password"
      ],
      "expect": {
        "texts": [
          "Copied. It's cleared from the clipboard in 90 seconds."
        ],
        "clipboard": {
          "types": [
            "text/plain;charset=utf-8",
            "x-oxyos-sensitive"
          ],
          "text/plain;charset=utf-8": "Fixture-Pass-01"
        }
      },
      "allow_unchanged": true
    },
    {
      "name": "Edit: the item's editor",
      "do": [
        "press_named",
        "Edit"
      ],
      "expect": {
        "texts": [
          "Title",
          "Example",
          "Username",
          "Create Strong Password",
          "Websites",
          "Save",
          "Cancel"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Create Strong Password: the service's generator's, shown",
      "do": [
        "press_named",
        "Create Strong Password"
      ],
      "expect": {
        "texts": [
          "abcde-FGHIJ-12345-kLmNo"
        ],
        "account_session": [
          "so.oxy.settings keychainGenerate: generated"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "the password's field, shown",
      "do": [
        "press_named",
        "Password"
      ],
      "expect": {
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "all of it selected",
      "do": [
        "key",
        [
          29,
          30
        ]
      ],
      "expect": {
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "Control-C: a password shown in its field is copied marked sensitive too",
      "do": [
        "key",
        [
          29,
          46
        ]
      ],
      "expect": {
        "clipboard": {
          "types": [
            "text/plain;charset=utf-8",
            "x-oxyos-sensitive"
          ],
          "text/plain;charset=utf-8": "abcde-FGHIJ-12345-kLmNo"
        },
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "Save: written, the item shown again",
      "do": [
        "press_named",
        "Save"
      ],
      "expect": {
        "texts": [
          "Username",
          "bea@example.com",
          "Verification Code",
          "Edit"
        ],
        "absent": [
          "Create Strong Password"
        ],
        "account_session": [
          "so.oxy.settings keychainPut: saved",
          "so.oxy.settings keychainList: items",
          "so.oxy.settings keychainAudit: audit",
          "so.oxy.settings keychainReveal: item",
          "so.oxy.settings keychainCode: code"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Delete…: asks first",
      "do": [
        "press_named",
        "Delete…"
      ],
      "expect": {
        "texts": [
          "Delete “Example”?",
          "It's deleted from your keychain on all your devices."
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Delete: gone from the keychain and the list",
      "do": [
        "press_named",
        "Delete"
      ],
      "expect": {
        "texts": [
          "Bank",
          "Mail"
        ],
        "absent": [
          "bea@example.com",
          "Delete “Example”?"
        ],
        "account_session": [
          "so.oxy.settings keychainDelete: deleted",
          "so.oxy.settings keychainList: items",
          "so.oxy.settings keychainAudit: audit"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "Security: the reused and weak passwords",
      "do": [
        "press_named",
        "Security"
      ],
      "expect": {
        "texts": [
          "Bank",
          "Mail",
          "Weak, and reused on 2 items"
        ],
        "absent": [
          "Home",
          "Example Passkey"
        ],
        "account_session": []
      },
      "allow_unchanged": true
    },
    {
      "name": "Devices: the members, none waiting",
      "do": [
        "press_named",
        "Devices"
      ],
      "expect": {
        "texts": [
          "Laptop",
          "This computer",
          "Phone",
          "android",
          "Remove…",
          "Waiting for Approval",
          "No devices are waiting."
        ],
        "account_session": [
          "so.oxy.settings keychainMembers: members",
          "so.oxy.settings keychainEnrollments: enrollments"
        ]
      },
      "allow_unchanged": true
    },
    {
      "name": "90 seconds after the copy, the clipboard is empty",
      "do": [
        "wait",
        90000
      ],
      "expect": {
        "clipboard": null
      },
      "allow_unchanged": true
    }
  ]
}
