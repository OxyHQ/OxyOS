{
  "about": "A text field's context menu from the keyboard alone (docs/adr/0037-text-editing.mdx, decision 8; docs/adr/0039-keyboard-access.mdx, decision 9; sample/TextMenuProbe.tsx: a Bloom field, a plain TextInput, a secure field), with a second application beside it (`companion`) that must receive nothing. Each field is reached by Tab, which selects its text; Shift+F10 and the Menu key open its menu hanging from its caret, the selection kept, the rows enabled as they apply; the arrows and Return choose a row and Escape chooses nothing, and either way the menu goes and the keyboard is the field's again (`focus_surface`, `focus_input`), its text and selection as the row left them. Each step checks the text and selection React receives, exactly the React events (no key the menu takes reaches the field), focus, the field the compositor holds, the clipboard, and exactly what each client was delivered.",
  "module": "TextMenuProbe",
  "window": [
    640,
    360
  ],
  "locale": "es_ES.UTF-8",
  "companion": {
    "module": "DropProbe",
    "window": [
      260,
      180
    ],
    "at": [
      980,
      200
    ]
  },
  "final": {
    "focus_input": "secret"
  },
  "steps": [
    {
      "name": "the window made active by a press on nothing in it, which only activates it: no field has focus, React hears nothing",
      "do": [
        "press",
        [
          500,
          300
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "popups": 0,
        "react": {},
        "delivered": {
          "1": {
            "focus.in": 1,
            "enter": 1,
            "press": 1,
            "release": 1
          },
          "companion": {
            "focus.out": 1
          }
        },
        "host_input": {
          "first_mouse.declined": 1,
          "first_mouse.accepted": 0
        }
      }
    },
    {
      "name": "Tab: the Bloom field takes the keyboard's focus, its text all selected as a Mac selects a field tabbed into, React hearing that selection once",
      "do": [
        "key",
        15
      ],
      "expect": {
        "focus_input": "line",
        "texts": [
          "Line: \"Hola mundo café\" [0,15]"
        ],
        "react": {
          "focus@line": 1,
          "selectionChange@line": 1
        },
        "field": {
          "text": "Hola mundo café",
          "anchor": 0,
          "cursor": 16
        },
        "delivered": {
          "1": {
            "key.press": 1,
            "key.release": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Right collapses the selection to its end",
      "do": [
        "key",
        106
      ],
      "expect": {
        "texts": [
          "Line: \"Hola mundo café\" [15,15]"
        ],
        "react": {
          "selectionChange@line": 1
        },
        "field": {
          "text": "Hola mundo café",
          "anchor": 16,
          "cursor": 16
        },
        "delivered": {
          "1": {
            "key.press": 1,
            "key.release": 1
          },
          "companion": {}
        }
      }
    },
    {
      "name": "Alt+Shift+Left selects the last word, café",
      "do": [
        "key",
        [
          56,
          42,
          105
        ]
      ],
      "expect": {
        "texts": [
          "Line: \"Hola mundo café\" [11,15]"
        ],
        "react": {
          "selectionChange@line": 1
        },
        "field": {
          "text": "Hola mundo café",
          "anchor": 16,
          "cursor": 11,
          "caret": [
            119,
            33,
            2,
            18
          ]
        },
        "delivered": {
          "1": {
            "key.press": 3,
            "key.release": 3
          },
          "companion": {}
        }
      }
    },
    {
