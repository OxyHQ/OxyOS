              "role": "Menu",
              "name": "Menú contextual"
            },
            {
              "role": "MenuItem",
              "name": "Deshacer",
              "state": [
                "disabled",
                "focused"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Rehacer",
              "state": [
                "disabled"
              ]
            },
            {
              "role": "MenuItem",
              "name": "Cortar"
