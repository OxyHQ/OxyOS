{
 "about": "Full Keyboard Access to the dock (docs/adr/0039-keyboard-access.mdx), as a Mac's Control-F3: Allo (sample/EditingProbe.tsx) with the shell and the development registry, the screen reader on in Spanish. Super+F3 puts the keyboard on the dock's first icon with its ring; → goes along it; Space opens Inbox; Super+F3 again and → reach it, ↑ opens its menu, End and Return quit it; Escape gives Allo the keyboard back. Every step checks the keyboard's focus, what the assistive technology holds, what the screen reader says (each icon once) and what is announced. At 1.25 (1600 × 1000).",
 "module": "EditingProbe",
 "window": [
  600,
  360
 ],
 "shell": "OxyOSShell",
 "app": {
  "id": "so.oxy.allo",
  "title": "Allo"
 },
 "reader": {
  "locale": "es_ES.UTF-8"
 },
 "outputs": "1600x1000@1.25",
 "steps": [
  {
   "name": "Allo's window, its field without focus; the reader on",
   "do": [
    "wait",
    1500
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": null,
    "spoken": [],
    "announcements": []
   }
  },
  {
   "name": "Super+F3 puts the keyboard on the dock's first icon, its ring around it, said once; Allo hears nothing of the keys",
   "do": [
    "key",
    [
     125,
     61
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {},
    "delivered": {
     "1": {
      "focus.out": 1
     }
    },
    "in_shell": {
     "keyboard_focus": {
      "target": "dock-launcher",
      "ring": true
     }
    },
    "at": {
     "shell": [
      {
       "role": "Button",
       "name": "Abrir aplicaciones",
       "state": [
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Abrir aplicaciones, botón",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "→ goes along the dock to escritorios",
   "do": [
    "key",
    [
     106
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "react": {},
    "delivered": {},
    "in_shell": {
     "keyboard_focus": {
      "target": "dock-overview",
      "ring": true
     }
    },
    "at": {
     "shell": [
      {
       "role": "Button",
       "name": "Ver escritorios",
       "state": [
        "focused"
       ]
      }
     ]
    },
    "spoken": [
     {
      "text": "Ver escritorios, botón",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
