        "pointer_shape": "ResizeTopRight",
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Within 12 px of a corner, the band beyond an edge is the corner's: the right edge's top end is the top-right corner",
      "do": [
        "move_output",
        [
          1133,
          85
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "pointer_shape": "ResizeTopRight",
        "window_rect": [
          190,
          80,
          940,
          560
        ],
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Back inside the window, the pointer is the page's arrow, and the window is told it is entered",
      "do": [
        "move_output",
        [
          590,
          330
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "pointer_shape": "Arrow",
        "window_rect": [
          190,
          80,
          940,
          560
        ],
        "react": {},
        "delivered": {
          "1": {
            "enter": 1
          }
        }
      }
    },
    {
      "name": "A hand's double click on the active window's title area zooms it to the work area: the first press begins a move (its touch cancelled), the second zooms",
      "do": [
        "double_click",
        [
          150,
          30,
          60,
          150
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "window_rect": [
          0,
          0,
          1280,
          720
        ],
        "texts": [
          "active yes, zoomed yes, full screen no"
        ],
        "react": {
          "touchStart@settings-rail-window-band": 2,
          "touchCancel@settings-rail-window-band": 1,
          "touchEnd@settings-rail-window-band": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "leave": 1,
            "press": 2,
            "release": 1
          }
        }
      }
    },
    {
      "name": "Double-clicked again, it restores the frame it had",
      "do": [
        "double_click",
        [
          150,
          30,
          60,
          150
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "window_rect": [
          190,
          80,
          940,
          560
        ],
        "texts": [
          "active yes, zoomed no, full screen no"
        ],
        "react": {
          "touchStart@settings-rail-window-band": 2,
          "touchCancel@settings-rail-window-band": 1,
          "touchEnd@settings-rail-window-band": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "leave": 2,
            "press": 2,
            "release": 1
          }
        }
