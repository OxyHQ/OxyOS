        ],
        "pointer_shape": "ResizeTopLeft",
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "The pointer over the band beyond the bottom-left corner: the ResizeTopRight shape",
      "do": [
        "move_output",
        [
          167,
