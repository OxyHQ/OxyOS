          580
        ],
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Dragged from there by (-20, 20): the top-right moves with the pointer, the left, bottom stay; no client hears the press",
      "do": [
        "drag_output",
        [
          1133,
