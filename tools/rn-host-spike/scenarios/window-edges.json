        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "pointer_shape": "ResizeVertical",
        "window_rect": [
          150,
          40,
          980,
          620
        ],
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Dragged from there by (0, -20): the bottom moves with the pointer, the left, top, right stay; no client hears the press",
      "do": [
        "drag_output",
        [
          640,
          663,
