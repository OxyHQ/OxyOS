{
  "about": "A window resized from every edge and corner, as a Mac's is (docs/adr/0016-windows.mdx, decision 5), and zoomed by a double click on its title area: WindowProbe (sample/WindowProbe.tsx) alone. The pointer over each band (6 px beyond an edge, 12 px along it from a corner) shows that edge's or corner's resize shape, the window told only that the pointer left it; a drag from the band moves exactly the edges pressed, the others staying, the press reaching no client and React hearing nothing; back inside the window the pointer is the page's arrow again. A hand's double click on the active window's title area zooms it to the work area and again restores the frame it had. Each step checks the window's frame, the pointer's shape, what React received and what the window was delivered, exactly.",
  "module": "WindowProbe",
  "window": [
    900,
    600
  ],
  "steps": [
    {
      "name": "The window is the active one",
      "do": [
        "press",
        [
          600,
          300
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "window_rect": [
          190,
          60,
          900,
          600
        ],
        "texts": [
          "active yes, zoomed no, full screen no"
        ],
        "pointer_shape": "Arrow",
        "react": {
          "touchStart@settings-page": 1,
          "touchEnd@settings-page": 1
        },
        "delivered": {
          "1": {
            "enter": 1,
            "press": 1,
            "release": 1
          }
        }
      }
    },
    {
      "name": "The pointer over the band beyond the right edge: the ResizeHorizontal shape",
      "do": [
        "move_output",
        [
          1093,
          360
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "pointer_shape": "ResizeHorizontal",
        "window_rect": [
          190,
          60,
          900,
          600
        ],
        "react": {},
        "delivered": {
          "1": {
            "leave": 1
          }
        }
      }
    },
    {
      "name": "Dragged from there by (40, 0): the right moves with the pointer, the left, top, bottom stay; no client hears the press",
      "do": [
        "drag_output",
        [
          1093,
          360,
          1133,
          360
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "window_rect": [
          190,
          60,
          940,
          600
        ],
        "pointer_shape": "ResizeHorizontal",
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "The pointer over the band beyond the left edge: the ResizeHorizontal shape",
      "do": [
        "move_output",
        [
          187,
          360
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "pointer_shape": "ResizeHorizontal",
        "window_rect": [
          190,
          60,
          940,
          600
        ],
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Dragged from there by (-40, 0): the left moves with the pointer, the top, right, bottom stay; no client hears the press",
      "do": [
        "drag_output",
        [
          187,
          360,
          147,
          360
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "window_rect": [
          150,
          60,
          980,
          600
        ],
        "pointer_shape": "ResizeHorizontal",
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "The pointer over the band beyond the top edge: the ResizeVertical shape",
      "do": [
        "move_output",
        [
          640,
          57
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "pointer_shape": "ResizeVertical",
        "window_rect": [
          150,
          60,
          980,
          600
        ],
        "react": {},
        "delivered": {}
      }
    },
    {
      "name": "Dragged from there by (0, -20): the top moves with the pointer, the left, right, bottom stay; no client hears the press",
      "do": [
        "drag_output",
        [
          640,
          57,
          640,
          37
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "window_rect": [
          150,
