  "module": "EditingProbe",
  "window": [
    600,
    360
  ],
  "shell": "OxyOSShell",
  "app": {
    "id": "so.oxy.allo",
    "title": "Allo"
  },
  "companion": {
    "module": "PressProbe",
    "window": [
      460,
      300
    ],
    "at": [
      700,
      300
    ],
    "app": "so.oxy.allo"
  },
  "outputs": "1600x1000@1.25",
