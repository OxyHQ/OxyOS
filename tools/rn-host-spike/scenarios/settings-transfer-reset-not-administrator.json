{
  "about": "Settings › General › Transfer or Reset (docs/adr/0054-recovery-and-erasing.mdx) for an account that is not the computer's administrator, over a played accounts' service: Erase All Content and Settings… is shown but cannot be pressed, and the page says only an administrator can erase this computer. Nothing is asked of the service but what erasing would do.",
  "module": "OxyOSSettings",
  "window": [
    960,
    600
  ],
  "app": {
    "id": "so.oxy.settings",
    "title": "Settings"
  },
  "settings": {
    "app": "so.oxy.settings",
    "preferences": {
      "appearance": "light",
      "accent": "oxy"
    }
  },
  "account": {
    "registered": [
      "so.oxy.settings"
    ],
    "erase": {
      "administrator": false,
      "password": "correct horse battery staple"
    }
  },
  "steps": [
    {
      "name": "Settings opens",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {
        "texts": [
          "Appearance"
        ]
      }
    },
    {
      "name": "the page: the erase shown, not offered, and why",
      "do": [
        "a11y-action",
        [
          "activate",
          "Transfer or Reset"
        ]
      ],
      "expect": {
        "texts": [
          "Erase All Content and Settings…",
          "Only an administrator can erase this computer."
        ],
        "at": {
          "window": [
            {
              "role": "Button",
              "name": "Erase All Content and Settings…",
              "state": [
                "disabled"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "pressed: nothing opens, nothing is asked",
      "do": [
        "press_named",
        "Erase All Content and Settings…"
      ],
      "allow_unchanged": true,
      "expect": {
        "absent": [
          "This erases:"
        ],
        "account_session": []
      }
    }
  ]
}
