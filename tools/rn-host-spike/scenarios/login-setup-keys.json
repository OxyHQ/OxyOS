{
  "about": "Adding a second Oxy account from the login screen's \"Añadir cuenta\" through the setup assistant, in Spanish, from the keyboard with the screen reader on (docs/adr/0020-oxy-account-login.mdx, decision 4 and the setup assistant's amendment; docs/adr/0039-keyboard-access.mdx; docs/adr/0014-screen-reader.mdx), against a played Oxy API and accounts' service: the SDK's own chooser in Spanish in the SDK's frame, Tab and Shift+Tab said; the username, Return, the email's code; the account's Oxy password asked once (a wrong one, as it turns out), its field focused; a PIN typed twice, each field focused; the look from the keyboard (Tab into the choices, an arrow and Space, Tab to Continuar, Return). The accounts' service refuses the password: back to it, said, the PIN and look kept; the right one, and the account is set up and signed in with the PIN at once.",
  "locale": "es_ES.UTF-8",
  "shell": "OxyOSLogin",
  "outputs": "1280x1000",
  "reader": {},
  "login": {
    "password": "oxyos.correcta",
    "accounts": [
      {
        "accountId": "0123456789abcdef01234567",
        "user": "oxy-aaaaaaaaaaaaaaaaaaaa",
        "uid": 1001,
        "name": "Bea Ramos"
      }
    ],
    "record": [
      "session would start for oxy-cccccccccccccccccccc (user session): "
    ],
    "oxy": {
      "identifier": "ada",
      "code": "246810",
      "id": "0123456789abcdef01234569",
      "username": "ada",
      "name": "Ada Lovelace",
      "has_password": true,
      "device": {
        "deviceId": "played-device-2",
        "deviceSecret": "played-device-secret-2"
      }
    },
    "enroll": {
      "device": {
        "deviceId": "played-device-2",
        "deviceSecret": "played-device-secret-2"
      },
      "password": "played password 2",
      "account": {
        "accountId": "0123456789abcdef01234569",
        "user": "oxy-cccccccccccccccccccc",
        "uid": 1003,
        "name": "Ada Lovelace"
      }
    }
  },
  "steps": [
    {
      "name": "the login screen with one account",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Añadir cuenta: setup, online",
      "do": [
        "a11y-action",
        [
          "activate",
          "Añadir cuenta"
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "platform: platform"
        ]
      }
    },
    {
      "name": "the SDK's own chooser, in Spanish: its QR beside the form, the email or username field focused",
      "do": [
        "wait",
        2000
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Iniciar sesión",
            "Email o nombre de usuario",
            "Escanea con Commons para entrar",
            "Paso 1 de 4",
            "Atrás"
          ],
          "absent": [
            "Descargar Commons"
          ],
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "Tab: Continuar, after the field",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "spoken": [
          {
            "text": "Continuar, botón",
            "interrupting": true
          }
        ]
      }
    },
    {
      "name": "Shift+Tab: back to the email or username field, said",
      "do": [
        "key",
        [
          42,
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "spoken": [
          {
            "text": "Email o nombre de usuario, campo de texto",
            "interrupting": true
          }
        ],
        "in_shell": {
          "focus_input": "signin-identifier"
        }
      }
    },
    {
      "name": "its username",
      "do": [
        "type",
        "ada"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Return: Continuar",
      "do": [
        "key",
        [
          28
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "look",
      "do": [
        "wait",
        1500
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "the code",
      "do": [
        "type",
        "246810"
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "signed in by the code: its Oxy password asked once, its field focused, step 2 of 5",
      "do": [
        "wait",
        2500
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Introduce la contraseña de Oxy de Ada Lovelace",
            "Este ordenador inicia tu sesión con tu contraseña de Oxy, incluso sin conexión. Introdúcela una vez más.",
            "Paso 2 de 5"
          ],
          "focus_input": "login-setup-password"
        }
      }
    },
    {
      "name": "a password (not the account's, as it turns out): the PIN page said with its place, its field focused and said",
      "do": [
        "keyboard",
        "mal\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916",
          "played password 2",
          "mal"
        ],
        "in_shell": {
          "texts": [
            "Crea un PIN",
            "Ahora no",
            "Paso 3 de 5"
          ],
          "focus_input": "login-setup-pin-password",
          "never": [
            "482916",
            "played password 2",
            "mal"
          ]
        },
        "spoken": [
          "Crea un PIN, paso 3 de 5",
          "Crea un PIN, campo de texto"
        ]
      }
    },
    {
      "name": "the PIN chosen: typed again, its field focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916",
          "played password 2",
          "mal"
        ],
        "in_shell": {
          "texts": [
            "Vuelve a introducir tu PIN"
          ],
          "focus_input": "login-setup-pin-again-password",
          "never": [
            "482916",
            "played password 2",
            "mal"
          ]
        }
      }
    },
    {
      "name": "typed again: the look, said with its place, its heading focused",
      "do": [
        "keyboard",
        "482916\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [],
        "never": [
          "482916",
          "played password 2",
          "mal"
        ],
        "in_shell": {
          "texts": [
            "Elige tu aspecto",
            "Claro",
            "Oscuro",
            "Automático",
            "Continuar",
            "Paso 4 de 5"
          ],
          "never": [
            "482916",
            "played password 2",
            "mal"
          ]
        },
        "spoken": [
          "Elige tu aspecto, paso 4 de 5",
          "Elige tu aspecto, encabezado"
        ]
      }
    },
    {
      "name": "Tab: into the choices",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "spoken": [
          "Automático, seleccionado, 3 de 3"
        ]
      }
    },
    {
      "name": "an arrow: to another choice",
      "do": [
        "key",
        [
          106
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Space: chosen",
      "do": [
        "key",
        [
          57
        ]
      ],
      "allow_unchanged": true,
      "expect": {}
    },
    {
      "name": "Tab: Atrás",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "spoken": [
          "Atrás, botón"
        ]
      }
    },
    {
      "name": "Tab: Continuar",
      "do": [
        "key",
        [
          15
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "spoken": [
          "Continuar, botón"
        ]
      }
    },
    {
      "name": "Return: Continuar",
      "do": [
        "key",
        [
          28
        ]
      ],
      "allow_unchanged": true,
      "expect": {
        "accounts_asked": [
          "enroll: refused"
        ]
      }
    },
    {
      "name": "the accounts' service refuses the password: back to it, said, its field focused",
      "do": [
        "wait",
        3000
      ],
      "allow_unchanged": true,
      "expect": {
        "in_shell": {
          "texts": [
            "Contraseña incorrecta. Vuelve a intentarlo."
          ],
          "focus_input": "login-setup-password"
        }
      }
    },
    {
      "name": "the right one: set up with the PIN and look kept, and signed in with the PIN at once",
      "do": [
        "keyboard",
        "played password 2\n"
      ],
      "allow_unchanged": true,
      "expect": {
        "never": [
          "482916",
          "played password 2",
          "mal"
        ],
        "in_shell": {
          "never": [
            "482916",
            "played password 2",
            "mal"
          ]
        },
        "accounts_asked": [
          "appearance: auto",
          "enroll: enrolled",
          "verifyPin: accepted"
        ]
      }
    },
    {
      "name": "signed in",
      "do": [
        "wait",
        3000
      ],
      "allow_unchanged": true,
      "expect": {
        "shell": {
          "locked": true,
          "signed_in": true
        },
        "never": [
          "482916",
          "played password 2",
          "mal"
        ],
        "in_shell": {
          "never": [
            "482916",
            "played password 2",
            "mal"
          ]
        }
      }
    }
  ]
}
