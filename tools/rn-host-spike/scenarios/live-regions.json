{
 "about": "Live regions (docs/adr/0039-keyboard-access.mdx): sample/LiveRegionProbe.tsx, the screen reader on in Spanish. A Bloom Field's error is an alert, an assertive live region, as ARIA's: typed into the field, a taken name brings it, said at once, interrupting the echo, once, while the field keeps the keyboard; a status line (role status) is a polite live region, said once as it changes. What did not change is never said again. At 1 (1280 × 720).",
 "module": "LiveRegionProbe",
 "window": [
  560,
  360
 ],
 "locale": "es_ES.UTF-8",
 "reader": {
  "locale": "es_ES.UTF-8"
 },
 "steps": [
  {
   "name": "The form: the field, the status line (a polite live region), the buttons; nothing said, nothing focused",
   "do": [
    "wait",
    1500
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": null,
    "spoken": [],
    "announcements": [],
    "at": {
     "window": [
      {
       "role": "TextInput",
       "name": "Nombre de usuario"
      },
      {
       "name": "0 cambios guardados",
       "state": [
        "live-polite"
       ]
      },
      {
       "role": "Button",
       "name": "Guardar"
      }
     ]
    },
    "at_absent": {
     "window": [
      {
       "role": "Alert"
      }
     ]
    }
   }
  },
  {
   "name": "Tab: the field, said",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": {
     "target": "user",
     "ring": true
    },
    "spoken": [
     {
      "text": "Nombre de usuario, campo de texto",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "A taken name typed: the letters echoed, then the error said at once, interrupting, once, the field keeping the keyboard",
   "do": [
    "keyboard",
    "ada"
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": {
     "target": "user",
     "ring": true
    },
    "spoken": [
     {
      "text": "ada",
      "interrupting": true
     },
     {
      "text": "Ese nombre ya está en uso",
      "interrupting": true
     }
    ],
    "announcements": [
     {
      "politeness": "assertive",
      "text": "Ese nombre ya está en uso",
      "live": true
     }
    ],
    "at": {
     "window": [
      {
       "role": "TextInput",
       "name": "Nombre de usuario",
       "hint": "Ese nombre ya está en uso"
      },
      {
       "role": "Alert",
       "name": "Ese nombre ya está en uso",
       "state": [
        "live-assertive"
       ]
      }
     ]
    }
   }
  },
  {
   "name": "Another letter: the error goes, said by nothing; the status line, unchanged, is not said again",
   "do": [
    "keyboard",
    "s"
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": {
     "target": "user",
     "ring": true
    },
    "spoken": [
     {
      "text": "s",
      "interrupting": true
     }
    ],
    "announcements": [],
    "at_absent": {
     "window": [
      {
       "role": "Alert"
      }
     ]
    }
   }
  },
  {
   "name": "Tab: Guardar",
   "do": [
    "key",
    [
     15
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": {
     "target": "save",
     "ring": true
    },
    "spoken": [
     {
      "text": "Guardar, botón",
      "interrupting": true
     }
    ],
    "announcements": []
   }
  },
  {
   "name": "Space: the status line changes, said politely, once",
   "do": [
    "key",
    [
     57
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": {
     "target": "save",
     "ring": true
    },
    "spoken": [
     {
      "text": "1 cambio guardado",
      "interrupting": false
     }
    ],
    "announcements": [
     {
      "politeness": "polite",
      "text": "1 cambio guardado",
      "live": true
     }
    ],
    "at": {
     "window": [
      {
       "name": "1 cambio guardado",
       "state": [
        "live-polite"
       ]
      }
     ]
    }
   }
  },
  {
   "name": "Space again: its new text, once",
   "do": [
    "key",
    [
     57
    ]
   ],
   "allow_unchanged": true,
   "expect": {
    "keyboard_focus": {
     "target": "save",
     "ring": true
    },
    "spoken": [
     {
      "text": "2 cambios guardados",
      "interrupting": false
     }
    ],
    "announcements": [
     {
      "politeness": "polite",
      "text": "2 cambios guardados",
      "live": true
     }
    ]
   }
  }
 ]
}