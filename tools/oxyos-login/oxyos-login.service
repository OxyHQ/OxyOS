# oxyos-login: OxyOS's own login program on the seat (docs/adr/0020-oxy-account-login.mdx,
# decision 4). It follows the boot logo (docs/adr/0017-boot-logo.mdx): Plymouth lets go of the card
# before it starts, its login screen takes the card through logind and draws the splash Plymouth
# showed, and Plymouth quits once that frame is on screen (READY=1, sent by the login program when
# its login screen says so). The login screen and every session run in logind sessions of their
# own on seat0's first terminal.
#
# Root, as a login manager is: it checks other users' passwords, opens their sessions and becomes
# them. It confines nothing it starts; each session is its user's.
#
# Not installed by the image (the session is not in the image yet: AGENTS.md's image rules).

[Unit]
Description=OxyOS login
Documentation=https://github.com/OxyHQ/OxyOS/blob/main/docs/adr/0020-oxy-account-login.mdx
After=systemd-user-sessions.service systemd-logind.service plymouth-start.service oxyos-accountd.service
After=getty@tty1.service plymouth-quit.service
Wants=oxyos-accountd.service
# The first terminal is the login screen's, not a console login's; Plymouth is quit only with
# its splash kept, never by plymouth-quit.service.
Conflicts=getty@tty1.service plymouth-quit.service
OnFailure=plymouth-quit.service
# A boot is complete only once the login screen has drawn its first frame (READY=1, Type=notify),
# not when the system reached its default target: enabled, the login program is required by
# boot-complete.target (RequiredBy= below, the way systemd's own checks join it), so a start whose
# login screen never appears is a failed try, and three in a row end in the recovery
# (docs/adr/0054-recovery-and-erasing.mdx, decision 2, amended). Disabled, nothing is required.
Before=boot-complete.target
# Never given up on (docs/adr/0061-crashes-and-resetting-an-application.mdx, decision 6, amended):
# no start limit. Its login screen ending is the program's own to start again, with the shell's
# doubling wait; the program itself ending is throttled by the restarts below.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=-/usr/bin/plymouth deactivate
ExecStart=/usr/libexec/oxyos/oxyos-login
# Passed on to the login screen and every session, the rest of the environment is not. The image's
# wallpapers are /usr/share/oxyos/wallpapers, which needs no variable (OXYOS_WALLPAPERS names
# another, for development, docs/adr/0048-wallpapers.mdx). The reader stays
# off until this unit is installed by the image with what it names (docs/adr/0020-oxy-account-login.mdx,
# "The screen reader at the login screen"): the image ships no session, login program, reader or
# eSpeak NG yet, and the reader at the login screen speaks as the `oxyos-login` user, whose greeter
# session needs a PipeWire of its own, not yet verified on a machine.
# Environment=OXYOS_READER=/usr/libexec/oxyos/oxyos-reader
ExecStartPost=-/usr/bin/plymouth quit --retain-splash
Restart=always
RestartSec=1s
RestartSteps=3
RestartMaxDelaySec=10s
# No WatchdogSec=: the program is also the parent of the person's session (its worker), and ending
# it for a hang the person does not see would end their session with it. Its turn waits at most a
# tenth of a second and never on a person, PAM or the network.
# The login screen's socket: /run/oxyos/login/greeter, the login screen's user's alone.
RuntimeDirectory=oxyos/login
RuntimeDirectoryMode=0755
# Stopping it asks its workers to end their sessions; whatever remains of the unit's own
# processes after the timeout is killed.
KillMode=mixed
TimeoutStopSec=15s

[Install]
Alias=display-manager.service
WantedBy=graphical.target
RequiredBy=boot-complete.target
