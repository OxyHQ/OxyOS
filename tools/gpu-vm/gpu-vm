#!/usr/bin/env python3
"""Runs a command in a disposable virtual machine that has what this machine may lack for GPU
buffers: DMA-BUF (udmabuf, the system dma-heap), a render node with DRM syncobj timelines
(virtio-gpu) and vgem's fences (docs/adr/0031-gpu-buffers.mdx, "Testing").

The guest is Debian Trixie's own kernel, booted under KVM, on this machine's root file system
shared read-only (9p), so the command runs the binaries just built, with this machine's
userspace (Mesa's lavapipe included). With `--vkms`, also the kernel's virtual display (vkms,
which Debian does not build: built here once from the kernel's own source for its version and
Debian's headers for it) with overlay planes, a cursor plane and a writeback connector: a KMS
driver that composes planes, takes TEST_ONLY commits and writes its output back. It is a second
display then: tests that each take a display may take either (run them one at a time to keep each
on its own). The command's working directory and `--writable`
directories are shared read-write; /tmp is the guest's. Nothing on this machine is changed: no
module is loaded here, no device appears here.

    tools/gpu-vm/gpu-vm [--vkms] [--writable DIR]... [--memory MiB] [--cpus N] -- COMMAND...

The kernel package is downloaded once (apt-get download, no root) into
~/.cache/oxyos-gpu-vm; with `--vkms`, its headers and vkms' source (git.kernel.org's stable tree
at the kernel's version) too, built with make and the kernel's compiler (gcc-14). The exit status is the command's.
"""

import argparse
import json
import lzma
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

KERNEL_PACKAGE = "linux-image-6.12.111+deb13-amd64-unsigned"
KERNEL_VERSION = "6.12.111+deb13-amd64"
# The upstream version the kernel package is (vkms' source), and its headers' packages.
UPSTREAM = "6.12.111"
HEADERS = ["linux-headers-6.12.111+deb13-amd64", "linux-headers-6.12.111+deb13-common",
           "linux-kbuild-6.12.111+deb13"]
VKMS_FILES = ["Makefile", "vkms_drv.c", "vkms_drv.h", "vkms_plane.c", "vkms_output.c", "vkms_crtc.c",
              "vkms_composer.c", "vkms_formats.c", "vkms_formats.h", "vkms_writeback.c"]
# vkms' parameters: two planes over the primary, the cursor's, and its output written back.
VKMS_PARAMETERS = "enable_overlay=1 enable_cursor=1 enable_writeback=1"
CACHE = Path.home() / ".cache" / "oxyos-gpu-vm"

# Modules loaded in the guest, in an order that satisfies their dependencies (`modules`
# resolves the rest from modinfo): the shared root (9p), then the devices under test.
WANTED = ["9pnet_virtio", "9p", "virtio-gpu", "vgem"]


def run(*command, **kwargs):
    return subprocess.run(command, check=True, **kwargs)


def fetch():
    """The kernel and busybox, extracted once."""
    debs = CACHE / "debs"
    debs.mkdir(parents=True, exist_ok=True)
    root = CACHE / "kernel"
    if not (root / "boot" / f"vmlinuz-{KERNEL_VERSION}").exists():
        if not list(debs.glob(f"{KERNEL_PACKAGE}_*.deb")):
            run("apt-get", "download", KERNEL_PACKAGE, cwd=debs)
        root.mkdir(exist_ok=True)
        run("dpkg-deb", "-x", str(next(debs.glob(f"{KERNEL_PACKAGE}_*.deb"))), str(root))
    busybox = CACHE / "busybox" / "bin" / "busybox"
    if not busybox.exists():
        if not list(debs.glob("busybox-static_*.deb")):
            run("apt-get", "download", "busybox-static", cwd=debs)
        run("dpkg-deb", "-x", str(next(debs.glob("busybox-static_*.deb"))), str(CACHE / "busybox-root"))
        busybox.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(CACHE / "busybox-root" / "usr" / "bin" / "busybox", busybox)
    return root / "boot" / f"vmlinuz-{KERNEL_VERSION}", root / "usr" / "lib" / "modules" / KERNEL_VERSION, busybox


def vkms():
    """vkms.ko for the kernel, built once: its source at the kernel's version, Debian's headers."""
    module = CACHE / "vkms" / "vkms.ko"
    if module.exists():
        return module
    debs = CACHE / "debs"
    for package in HEADERS:
        if not list(debs.glob(f"{package}_*.deb")):
            run("apt-get", "download", package, cwd=debs)
    headers = CACHE / "headers"
    shutil.rmtree(headers, ignore_errors=True)
    for package in HEADERS:
        run("dpkg-deb", "-x", str(next(debs.glob(f"{package}_*.deb"))), str(headers))
    source = headers / "usr" / "src"
    build = source / f"linux-headers-{KERNEL_VERSION}"
    # Its Makefile names the common headers where the package installs them.
    makefile = build / "Makefile"
    makefile.write_text(makefile.read_text().replace("include /usr/src/", f"include {source}/"))
    src = CACHE / "vkms-src"
    src.mkdir(parents=True, exist_ok=True)
    for name in VKMS_FILES:
        run("curl", "-sfL", "-o", str(src / name),
            "https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/gpu/drm/vkms/"
            f"{name}?h=v{UPSTREAM}")
    # Without BTF: pahole is not needed, and nothing reads a module's BTF here.
    run("make", "-C", str(build), f"M={src}", "CONFIG_DRM_VKMS=m", "CONFIG_DEBUG_INFO_BTF_MODULES=",
        "modules", stdout=subprocess.DEVNULL)
    module.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy(src / "vkms.ko", module)
    return module


def modules(tree: Path, extra=()):
    """The modules WANTED and `extra` need, dependencies first, as (name, path)."""
    by_name = {}
    for path in tree.rglob("*.ko.xz"):
        by_name[path.name[: -len(".ko.xz")].replace("-", "_")] = path
    order, seen = [], set()

    def visit(name):
        key = name.replace("-", "_")
        if key in seen:
            return
        seen.add(key)
        path = by_name[key]
        depends = subprocess.run(
            ["modinfo", "-F", "depends", str(path)], check=True, capture_output=True, text=True
        ).stdout.strip()
        for dependency in filter(None, depends.split(",")):
            visit(dependency)
        order.append((key, path))

    for name in [*WANTED, *extra]:
        visit(name)
    return order


INIT = r"""#!/bin/busybox sh
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
# Loopback, for tests serving themselves over 127.0.0.1; the guest has no other network.
ip link set lo up
while read -r module parameters; do
  insmod /lib/$module.ko $parameters || echo "gpu-vm: $module did not load"
done < /modules
mount -t 9p -o trans=virtio,version=9p2000.L,ro,msize=512000 host /root || { cat /modules; cat /proc/filesystems | grep 9p; dmesg | tail -20; }
. /config
mount -t proc proc /root/proc
mount -t sysfs sys /root/sys
mount -t devtmpfs dev /root/dev
mount -t tmpfs tmp /root/tmp
mount -t tmpfs run /root/run
n=0
for dir in $WRITABLE; do
  n=$((n + 1))
  mkdir -p "/root$dir" 2>/dev/null
  mount -t 9p -o trans=virtio,version=9p2000.L,msize=512000 rw$n "/root$dir"
done
mkdir -p /root/dev/shm && mount -t tmpfs shm /root/dev/shm
chroot /root /bin/sh -c "cd \"$WORKDIR\" && exec /bin/sh \"$JOB/run.sh\"" > /dev/console 2>&1
echo $? > /status
cat /status > "/root$JOB/status"
sync
poweroff -f
"""


def initramfs(work: Path, busybox: Path, order, config: str) -> Path:
    root = work / "initramfs"
    for sub in ["bin", "lib", "proc", "sys", "dev", "root", "mnt"]:
        (root / sub).mkdir(parents=True, exist_ok=True)
    shutil.copy(busybox, root / "bin" / "busybox")
    for name, path in order:
        data = path.read_bytes()
        (root / "lib" / f"{name}.ko").write_bytes(lzma.decompress(data) if path.suffix == ".xz" else data)
    (root / "modules").write_text(
        "\n".join(f"{name} {VKMS_PARAMETERS}" if name == "vkms" else name for name, _ in order) + "\n")
    (root / "config").write_text(config)
    init = root / "init"
    init.write_text(INIT)
    init.chmod(0o755)
    image = work / "initramfs.cpio"
    files = subprocess.run(
        ["find", "."], cwd=root, check=True, capture_output=True
    ).stdout
    with open(image, "wb") as out:
        subprocess.run(["cpio", "-o", "-H", "newc", "--quiet"], cwd=root, input=files, stdout=out, check=True)
    return image


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--vkms", action="store_true",
                        help="also the kernel's virtual display, with overlay planes (built once)")
    parser.add_argument("--writable", action="append", default=[], help="a directory shared read-write")
    parser.add_argument("--memory", type=int, default=8192, help="MiB")
    parser.add_argument("--cpus", type=int, default=8)
    parser.add_argument("--env", action="append", default=[], help="NAME=VALUE for the command")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("no command")
    if not os.access("/dev/kvm", os.R_OK | os.W_OK):
        sys.exit("gpu-vm: /dev/kvm is not usable here")
    kernel, tree, busybox = fetch()
    order = modules(tree, ["drm_kms_helper", "drm_shmem_helper"] if args.vkms else [])
    if args.vkms:
        order.append(("vkms", vkms()))
    workdir = Path.cwd().resolve()
    writable = [workdir] + [Path(d).resolve() for d in args.writable]
    with tempfile.TemporaryDirectory(prefix="oxyos-gpu-vm-", dir=CACHE) as scratch:
        work = Path(scratch)
        job = work / "job"
        job.mkdir()
        environment = {
            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
            "HOME": "/tmp",
            "XDG_RUNTIME_DIR": "/run",
        }
        for name in ["VK_ICD_FILENAMES", "LD_LIBRARY_PATH", "RUST_BACKTRACE", "XLOCALEDIR"]:
            if name in os.environ:
                environment[name] = os.environ[name]
        for pair in args.env:
            name, _, value = pair.partition("=")
            environment[name] = value
        exports = "".join(f"export {name}={shlex.quote(value)}\n" for name, value in environment.items())
        (job / "run.sh").write_text(exports + "exec " + shlex.join(command) + "\n")
        config = (
            f"WORKDIR={shlex.quote(str(workdir))}\n"
            f"JOB={shlex.quote(str(job))}\n"
            f"WRITABLE={shlex.quote(' '.join(str(d) for d in writable + [job]))}\n"
        )
        image = initramfs(work, busybox, order, config)
        qemu = [
            "qemu-system-x86_64",
            "-enable-kvm",
            "-cpu", "host",
            "-m", str(args.memory),
            "-smp", str(args.cpus),
            "-nographic",
            "-no-reboot",
            "-kernel", str(kernel),
            "-initrd", str(image),
            "-append", "console=ttyS0 quiet loglevel=3 panic=-1",
            "-device", "virtio-gpu-pci",
            "-virtfs", "local,path=/,mount_tag=host,security_model=none,readonly=on",
        ]
        for index, directory in enumerate(writable + [job], start=1):
            qemu += ["-virtfs", f"local,path={directory},mount_tag=rw{index},security_model=none"]
        subprocess.run(qemu, stdin=subprocess.DEVNULL)
        status = job / "status"
        if not status.exists():
            sys.exit("gpu-vm: the guest ended without the command's status")
        sys.exit(int(status.read_text().strip() or "1"))


if __name__ == "__main__":
    main()
