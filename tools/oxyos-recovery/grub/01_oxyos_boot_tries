#!/bin/sh
# OxyOS's boot counting on a machine that boots with GRUB (docs/adr/0054-recovery-and-erasing.mdx,
# decision 2, "Machines that boot with GRUB"): what systemd-boot does with an entry's file name,
# done in GRUB's environment block (/boot/grub/grubenv), which GRUB itself can write.
#
# - Each start that GRUB makes counts one try off `oxyos_tries` (3 when unset).
# - A complete boot gives the three tries back: oxyos-grub-boot-tries.service, once the system
#   reaches boot-complete.target (ordered after multi-user.target).
# - At 0 (three starts in a row that never completed) this start is OxyOS Recovery's, once: the
#   count starts again at 3, so a recovery's Restart goes back to OxyOS.
# - A start chosen once with grub-reboot (`boot_once`) is the person's choice: not counted.
# `oxyos_recovery` in the environment names another entry for the recovery (none: oxyos-recovery).
#
# Installed as /etc/grub.d/01_oxyos_boot_tries, after 00_header, which loads the environment.
set -e
cat <<'SCRIPT'
if [ x"${have_grubenv}" = xtrue ]; then
  if [ -z "${boot_once}" ]; then
    if [ "${oxyos_tries}" = "0" ]; then
      set oxyos_tries=3
      save_env oxyos_tries
      if [ "${oxyos_recovery}" ]; then
        set default="${oxyos_recovery}"
      else
        set default="oxyos-recovery"
      fi
    elif [ "${oxyos_tries}" = "1" ]; then
      set oxyos_tries=0
      save_env oxyos_tries
    elif [ "${oxyos_tries}" = "2" ]; then
      set oxyos_tries=1
      save_env oxyos_tries
    else
      set oxyos_tries=2
      save_env oxyos_tries
    fi
  fi
fi
SCRIPT
