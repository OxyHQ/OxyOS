#!/bin/sh
# OxyOS Recovery's entry on a machine that boots with GRUB, a machine converted by hand rather than
# installed by oxyos-recovery (docs/adr/0054-recovery-and-erasing.mdx, "Machines that boot with
# GRUB"). Installed as /etc/grub.d/42_oxyos_recovery; update-grub runs it.
#
# The recovery's partition (OxyOS's GPT type) holds the installation image's /live/: its squashfs,
# dm-verity hash tree and root hash, and its Debian-signed kernel and live-boot initramfs. GRUB,
# Debian's, signed and started by shim, reads the kernel from that partition and has shim verify it,
# as it does OxyOS's own; live-boot then reads the image read-only through dm-verity, against the
# root hash on this command line. The entry has the hotkey R: in GRUB's menu, R starts it.
#
# What it needs is in /etc/default/oxyos-recovery, written when the partition was made:
#   OXYOS_RECOVERY_PARTUUID    the partition's GPT UUID
#   OXYOS_RECOVERY_FS_UUID     its ext4 file system's UUID
#   OXYOS_RECOVERY_ROOT_HASH   the image's dm-verity root hash (64 hex digits)
#   OXYOS_RECOVERY_SYSTEM_PARTUUID  the GPT UUID of the machine's own root partition, which the
#                              recovery cannot know by its type on a converted disk
#                              (oxyos.recovery.root=PARTUUID=…): it checks that file system and
#                              never erases it
# Without them, or with one malformed, there is no entry.
set -e

CONFIG=/etc/default/oxyos-recovery
[ -r "$CONFIG" ] || exit 0
OXYOS_RECOVERY_PARTUUID=
OXYOS_RECOVERY_FS_UUID=
OXYOS_RECOVERY_ROOT_HASH=
OXYOS_RECOVERY_SYSTEM_PARTUUID=
# shellcheck disable=SC1090 # the machine's own configuration
. "$CONFIG"

uuid='^[0-9a-f]\{8\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{12\}$'
if ! printf '%s\n' "$OXYOS_RECOVERY_PARTUUID" | grep -q "$uuid" ||
    ! printf '%s\n' "$OXYOS_RECOVERY_FS_UUID" | grep -q "$uuid" ||
    ! printf '%s\n' "$OXYOS_RECOVERY_SYSTEM_PARTUUID" | grep -q "$uuid" ||
    ! printf '%s\n' "$OXYOS_RECOVERY_ROOT_HASH" | grep -q '^[0-9a-f]\{64\}$'; then
    echo "42_oxyos_recovery: $CONFIG is incomplete or malformed; no OxyOS Recovery entry" >&2
    exit 0
fi

echo "Found OxyOS Recovery on partition $OXYOS_RECOVERY_PARTUUID" >&2
cat <<ENTRY
menuentry 'OxyOS Recovery' --hotkey=r --id oxyos-recovery {
	insmod part_gpt
	insmod ext2
	search --no-floppy --fs-uuid --set=root $OXYOS_RECOVERY_FS_UUID
	linux /live/vmlinuz boot=live live-media=/dev/disk/by-partuuid/$OXYOS_RECOVERY_PARTUUID live-media-path=/live noeject live-config.nocomponents dm-verity-root-hash=filesystem.squashfs:$OXYOS_RECOVERY_ROOT_HASH oxyos.recovery.root=PARTUUID=$OXYOS_RECOVERY_SYSTEM_PARTUUID systemd.unit=oxyos-recovery.target systemd.hostname=oxyos-recovery quiet splash loglevel=3 vt.global_cursor_default=0 plymouth.ignore-serial-consoles
	initrd /live/initrd.img
}
ENTRY
