# oxyos-accountd: the Oxy accounts set up on the machine and the platform's Oxy session
# (docs/adr/0020-oxy-account-login.mdx). It runs as root, because it makes users and sets their
# verifiers with the system's tools (useradd, chpasswd, usermod, userdel), and is confined to what
# that needs: its own state, the user database, the homes it makes, the network to Oxy's API,
# logind (to end a signed-out account's sessions), the accounts' pictures, reading which program a session's process
# runs, and systemd, to start oxyos-erase.service and restart the machine when an administrator
# erases it (docs/adr/0054-recovery-and-erasing.mdx), and to weigh the user slice of the person at
# seat0 above other users' (docs/adr/0066-quality-of-service.mdx, decision 8: SetUnitProperties,
# runtime, on the system bus; root's calls need no capability and no polkit). That unit writes the erase request and the
# firmware's next boot with its own privileges: this one never writes to the EFI system partition
# or the firmware's variables, and the sandbox below gives it neither.
#
# Not installed by the image (AGENTS.md's image rules); ADR 0020 says what a machine installs.

[Unit]
Description=OxyOS accounts
Documentation=https://github.com/OxyHQ/OxyOS/blob/main/docs/adr/0020-oxy-account-login.mdx
After=network.target nss-user-lookup.target
Wants=nss-user-lookup.target

[Service]
Type=exec
ExecStart=/usr/libexec/oxyos-accountd
Restart=on-failure
RestartSec=1s
UMask=0077

# Oxy's API, OxyOS's public client id there (the registry's OxyOS application; public, not a
# secret), and the one program that may register a session's launches, with the login program
# that must have started it. The file below may name
# another API and its client (a development server); without a client id nothing is set up and
# passwords are not checked online.
Environment=OXYOS_OXY_API=https://api.oxy.so
Environment=OXYOS_OXY_CLIENT_ID=oxy_dk_ee7af26b21c2ff9e70f59e43dc2359106280665d779b74a8
Environment=OXYOS_SESSION_PROGRAM=/usr/bin/oxyos-session
Environment=OXYOS_LOGIN_PROGRAM=/usr/libexec/oxyos/oxyos-login
EnvironmentFile=-/etc/oxyos/accountd.conf

# Its own: /var/lib/oxyos/accounts and /var/lib/oxyos/keychain (0700; a directory per account's
# keychain in it, ADR 0050) and its sockets' directory, /run/oxyos/accountd (0755: its socket and
# the session socket, both 0666, whose peers the kernel names).
StateDirectory=oxyos/accounts oxyos/keychain
StateDirectoryMode=0700

# The keychains' keys are locked in memory while their sessions are unlocked (mlock, ADR 0050
# decision 2): a page per key, a few per account, counted against RLIMIT_MEMLOCK, which it has
# without CAP_IPC_LOCK. A key that cannot be locked keeps its keychain locked, so the limit is set
# well above what it needs. Nothing it holds is ever written to a core file.
LimitMEMLOCK=16M
LimitCORE=0
RuntimeDirectory=oxyos/accountd
RuntimeDirectoryMode=0755
# Kept when the service stops or restarts (a package upgrade restarts it under running sessions),
# for its registrars directory (0700, root's): the sessions it verified this boot, so a session
# whose program an upgrade replaced is still known (docs/adr/0020-oxy-account-login.mdx). A boot
# empties /run.
RuntimeDirectoryPreserve=yes

# The file system is read-only but for what it writes:
# - /etc: useradd, chpasswd (through pam_unix) and userdel replace passwd, shadow, group and
#   gshadow by renaming a new file over the old one in /etc, and take /etc/.pwd.lock; a single
#   file cannot be bound writable for that, so the directory is;
# - /home: the homes it makes and removes. /root and /run/user, the other homes, are hidden
#   (InaccessiblePaths). Not ProtectHome=tmpfs with /home bound back (BindPaths=/home): systemd
#   makes that bind read-only under ProtectSystem=strict, ReadWritePaths=/home or not, and useradd
#   could make no home (exit 12; tools/oxyos-accountd/src/unit_sandbox.rs runs this unit to prove
#   it can);
# - lastlog and faillog, where they exist: useradd resets a new uid's entries (LOG_INIT), so a
#   uid used before does not show its last user's logins.
# - /var/lib/oxyos/pictures: the accounts' pictures (their Oxy avatars), which the login screen
#   and each account's session read, so not a StateDirectory (0700 here): root's, 0755, made by
#   oxyos-accountd.tmpfiles, each picture 0644 (as AccountsService keeps its icons).
# Nothing else: useradd makes no mail spool on Debian (CREATE_MAIL_SPOOL=no).
ProtectSystem=strict
ReadWritePaths=/etc /home -/var/log/lastlog -/var/log/faillog -/var/lib/oxyos/pictures
InaccessiblePaths=-/root -/run/user

# Root, and only the capabilities making users needs: owning a home and its skeleton's files to
# the new user, and reaching into a user's home to remove it; and CAP_SYS_PTRACE, which reading
# another user's /proc/<pid>/exe and status takes (the program a session's process runs, a
# launched process's parent): it reads them, and traces nothing (ptrace is not in its filter).
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_SYS_PTRACE
NoNewPrivileges=yes
RestrictSUIDSGID=yes

PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private

# Its sockets, logind's bus (loginctl), systemd's (systemctl), and HTTPS to Oxy's API.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# @system-service holds @chown, which making a home needs: so @privileged, which holds it too, is
# not taken away.
SystemCallFilter=@system-service
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
