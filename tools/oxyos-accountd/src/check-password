#!/bin/sh
# The tests' verifier (passwords.rs): pam_exec hands the password on standard input, NUL-terminated,
# and only `correct horse battery` is accepted, so a password the conversation mangled fails. It is
# committed, not written by the tests: a script a test writes while another test's thread forks can
# fail to run (ETXTBSY).
[ "$(tr -d '\000')" = 'correct horse battery' ]
