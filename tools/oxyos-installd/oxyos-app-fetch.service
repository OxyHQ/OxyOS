# oxyos-app-fetch: the install service's fetcher (docs/adr/0030-installing-applications.mdx,
# decision 5). It runs as a user of its own (a dynamic user), with the network and nothing else:
# it writes the store's files into descriptors oxyos-installd hands it, for root alone, and
# reaches no file of the system's but the repository it reads.
#
# The repository is a local directory in this step (file:///var/cache/oxyos/store); HTTPS to the
# store's CDN is a later step. Not installed by the image yet (ADR 0030, step 7).

[Unit]
# Never given up on (docs/adr/0061-crashes-and-resetting-an-application.mdx, decision 6, amended):
# no start limit, the restarts below throttle it, as launchd throttles a job and never stops it.
StartLimitIntervalSec=0
Description=OxyOS applications' fetcher
Documentation=https://github.com/OxyHQ/OxyOS/blob/main/docs/adr/0030-installing-applications.mdx

[Service]
Type=exec
ExecStart=/usr/libexec/oxyos-installd --fetch --repository file:///var/cache/oxyos/store
# Started again however it ends, sooner the first times: 1 s, then ever later up to 10 s.
Restart=always
RestartSec=1s
RestartSteps=3
RestartMaxDelaySec=10s
# Its accept loop says it is alive (sd_notify's WATCHDOG=1, oxyos_seat::notify::wait_readable):
# silent this long (wedged, or stopped), systemd ends it with SIGABRT and starts it again.
WatchdogSec=30s
NotifyAccess=main

DynamicUser=yes
# Its socket's directory, /run/oxyos/app-fetch: the dynamic user's.
RuntimeDirectory=oxyos/app-fetch
RuntimeDirectoryMode=0755
# Its crash leaves its backtrace (docs/adr/0068-crash-evidence-and-kernel-panics.mdx): it holds
# no secret, and systemd-coredump keeps no core.
LimitCORE=infinity
UMask=0077

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private

# Its socket, and the network to the store.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
