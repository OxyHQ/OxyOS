{
  "name": "shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --config vite.web.config.ts",
    "lint": "biome check . && eslint .",
    "lint:react": "eslint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:alia": "biome check src/lib/alia.ts tests/alia.test.ts && eslint src/lib/alia.ts tests/alia.test.ts",
    "test": "bun test",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.web.config.ts"
  },
  "dependencies": {
    "@oxy.so/core": "3.0.0",
    "@tauri-apps/api": "2.12.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "browserslist": "4.28.8"
  }
}
