# config/binary - options for live-build(7), binary stage

# Set image type
LB_IMAGE_TYPE="iso-hybrid"

# Set image filesystem
LB_BINARY_FILESYSTEM="fat32"

# Set apt/aptitude generic indices
LB_APT_INDICES="false"

# Set boot parameters: the boot logo's quiet console (docs/adr/0017-boot-logo.mdx). Plymouth
# ignores serial consoles: where the firmware names one (an AArch64 machine's ACPI SPCR table or
# its device tree's stdout-path, as QEMU's virt machine has), Plymouth would otherwise force its
# text view on every display, and the screen would never show the boot logo. The kernel and
# systemd still write to that console.
LB_BOOTAPPEND_LIVE="boot=live components quiet splash loglevel=3 vt.global_cursor_default=0 plymouth.ignore-serial-consoles username=user hostname=oxyos"

# Set boot parameters
LB_BOOTAPPEND_INSTALL=""

# Set boot parameters
LB_BOOTAPPEND_LIVE_FAILSAFE="boot=live components memtest noapic noapm nodma nomce nolapic nomodeset nosmp nosplash vga=788"

# Set BIOS bootloader
LB_BOOTLOADER_BIOS="syslinux"

# Set EFI bootloader
LB_BOOTLOADER_EFI="grub-efi"

# Set bootloaders
LB_BOOTLOADERS=""

# Set checksums
LB_CHECKSUMS="sha256 md5"

# Set compression
LB_COMPRESSION="none"

# The image's hash tree (dm-verity): live-boot reads every block of the squashfs through it,
# against its root hash, on the live medium and in the recovery, whose boot entry carries the root
# hash on its command line (docs/adr/0054-recovery-and-erasing.mdx, decision 3). The installer
# checks the image against it before writing it, and the recovery's copy after.
LB_DM_VERITY="true"

# Support FEC on dm-verity rootfs
LB_DM_VERITY_FEC_ROOTS=""

# Set sign script for roothash for dm-verity rootfs
LB_DM_VERITY_SIGN=""

# Set zsync
LB_ZSYNC="true"

# Control if we build binary images chrooted
# NEVER, *EVER*, *E*V*E*R* SET THIS OPTION to false.
LB_BUILD_WITH_CHROOT="true"

# No debian-installer: OxyOS installs by writing this image whole (oxyos-recovery install,
# docs/adr/0023-installing-oxyos.mdx, decision 1), never with Debian's installer, its partitioner or
# its first user.
LB_DEBIAN_INSTALLER="none"

# Set debian-installer suite
LB_DEBIAN_INSTALLER_DISTRIBUTION="trixie"

# Set debian-installer preseed filename/url
LB_DEBIAN_INSTALLER_PRESEEDFILE=""

# Toggle use of GUI debian-installer
LB_DEBIAN_INSTALLER_GUI="false"

# Set hdd label
LB_HDD_LABEL="OXYOS_LIVE"

# Set hdd filesystem size
LB_HDD_SIZE="auto"

# Set start of partition for the hdd target for BIOSes that expect a specific boot partition start (e.g. "63s"). If empty, use optimal layout.
LB_HDD_PARTITION_START=""

# Set iso author
LB_ISO_APPLICATION="OxyOS"

# Set iso preparer
LB_ISO_PREPARER="live-build @LB_VERSION@; https://salsa.debian.org/live-team/live-build"

# Set iso publisher
LB_ISO_PUBLISHER="OxyHQ; https://oxy.so/os; hello@oxy.so"

# Set iso volume (max 32 chars)
LB_ISO_VOLUME="oxyos-1.0"

# Set jffs2 eraseblock size
LB_JFFS2_ERASEBLOCK=""

# Set memtest
LB_MEMTEST="none"

# Set loadlin
LB_LOADLIN="false"

# Set win32-loader
LB_WIN32_LOADER="false"

# Set net tarball
LB_NET_TARBALL="true"

# Set onie
LB_ONIE="false"

# Set onie additional kernel cmdline options
LB_ONIE_KERNEL_CMDLINE=""

# Set inclusion of firmware packages in debian-installer. "false": live-build's detection would put
# every package with a file under /lib/firmware in the ISO's pool, server firmware included, and
# the build pins that out (archives/no-server-firmware.pref.chroot). The live installer copies
# the live system, which has the manifest's firmware.
LB_FIRMWARE_BINARY="false"

# Set inclusion of firmware packages in the live image. "false": the manifest names the firmware.
# live-build's detection installs every package with a file under /lib/firmware, which brought
# astronomy camera drivers and through them Cairo and the X11 client libraries
# (scripts/check-image-contents.py found it in a built image).
LB_FIRMWARE_CHROOT="false"

# Set swap file path
LB_SWAP_FILE_PATH=""

# Set swap file size
LB_SWAP_FILE_SIZE="512"

# UEFI Secure Boot: Debian's Microsoft-signed shim and signed GRUB start the medium. "enable", not
# "auto": the image must have them, or the build fails; and "auto" installs shim-signed into the
# chroot and purges it after, even when the manifest has it (the installed system's chain), taking
# OxyOS's installer with it.
LB_UEFI_SECURE_BOOT="enable"
