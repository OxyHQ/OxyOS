# OxyOS target-runtime manifest: the Debian base the native platform runs on.
# There is no graphical session yet. Do not add a display server, compositor,
# greeter, browser shell or desktop application here: none of them run on the
# OxyOS display protocol, and scripts/check-image-config.py rejects them.

# Live system
live-boot
live-config
live-config-systemd
user-setup

# Core system
sudo
apt-transport-https
psmisc
cryptsetup

# Boot logo (docs/adr/0017-boot-logo.mdx): Plymouth draws the theme `oxyos` straight
# through DRM/KMS, no display server. Not plymouth-themes: it brings plymouth-label (Pango,
# Cairo, GLib) and themes the image does not use. fontconfig because Debian's initramfs hook
# copies its configuration and runs fc-cache for every graphical theme, and fails without it.
plymouth
fontconfig

# System services
network-manager
pipewire-audio
upower
bluez

# Utilities
bash-completion
htop
curl
unzip
zip
rsync
openssh-client
wireless-tools
ntfs-3g
dosfstools

# Hardware: the firmware and microcode live-build's detection (LB_FIRMWARE_CHROOT) chose for
# Trixie, named here so that only firmware is installed. Left out: indi-dsi, libfishcamp1t64
# and libsbig4t64 (astronomy camera drivers, which pull Cairo and the X11 client libraries),
# dahdi-firmware-nonfree (telephony cards), and firmware-b43-installer and
# firmware-b43legacy-installer (they download firmware from the internet as they install).
firmware-linux-free
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
amd64-microcode
intel-microcode
wireless-regdb
bluez-firmware
atmel-firmware
firmware-amd-graphics
firmware-ast
firmware-ath9k-htc
firmware-atheros
firmware-bnx2
firmware-bnx2x
firmware-brcm80211
firmware-carl9170
firmware-cavium
firmware-cirrus
firmware-intel-graphics
firmware-intel-misc
firmware-intel-sound
firmware-ipw2x00
firmware-ivtv
firmware-iwlwifi
firmware-libertas
firmware-marvell-prestera
firmware-mediatek
firmware-myricom
firmware-netronome
firmware-netxen
firmware-nvidia-graphics
firmware-nvidia-tesla-535-gsp
firmware-qlogic
firmware-realtek
firmware-siano
firmware-sof-signed
firmware-zd1211
