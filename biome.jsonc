{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "tools/rn-host-spike/sample/**",
      "tools/shell-preview/**",
      "scripts/*.mjs",
      "!**/node_modules",
      "!.worktrees",
      "!**/dist",
      "!**/*.generated.*",
      // Generated by the sample's bundlers (.gitignore'd there).
      "!tools/rn-host-spike/sample/generated",
      // Lockfiles, written by npm and pnpm.
      "!**/package-lock.json",
      "!**/pnpm-lock.yaml",
      // The sample's assets are the probes' fixtures, among them a deliberately broken SVG.
      "!tools/rn-host-spike/sample/assets"
    ]
  },
  // Baseline only: nothing is reformatted yet. Several changes are in flight on these files, so the
  // Oxy base style (below) is applied one directory at a time in a quiet window, each pass in
  // .git-blame-ignore-revs; until then the formatter is off and `biome ci` checks the linter alone.
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Baseline: the violations already on main (258 when this was set, counts beside each rule) stay warnings,
      // never errors, until each rule is cleaned up and tightened. Every other recommended rule is
      // an error, so no new kind of violation lands.
      "complexity": {
        "noCommaOperator": "warn", // 10
        "noImportantStyles": "warn", // 2
        "noStaticOnlyClass": "warn", // 1
        "useOptionalChain": "warn" // 9
      },
      "correctness": {
        "noUnusedImports": "warn", // 32
        "noUnusedVariables": "warn" // 1
      },
      "style": {
        "noNonNullAssertion": "warn", // 123
        "useImportType": "warn" // 6
      },
      "suspicious": {
        "noConfusingVoidType": "warn", // 4
        "noExplicitAny": "warn", // 64
        "noPrototypeBuiltins": "warn" // 6
      }
    }
  },
  "overrides": [
    {
      // apps/settings/tests/spotlight.test.ts reads Settings.tsx as text (a regex over its pages'
      // `title: words.x` entries): never reformat it without updating that reader.
      "includes": ["apps/settings/src/Settings.tsx"],
      "formatter": { "enabled": false }
    }
  ]
}
